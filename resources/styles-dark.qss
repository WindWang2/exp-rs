/*
 * SICNU GEO RS — Dark Theme QSS (Canopy Lab Night)
 * Mirrors light token roles with inverted surfaces and brighter accents.
 * accent #2BB673 · ink #E8ECF1 · surface #1A1D23 / #1E2229
 */
/* ============ Global ============ */
QWidget {
    font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans CJK SC', 'Source Han Sans CN', 'WenQuanYi Micro Hei', system-ui, sans-serif;
    font-size: 13px;
    color: #E8ECF1;
}

QMainWindow {
    background-color: #1A1D23; /* bg-1 */
}

/* ============ Input Fields ============ */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1E2229; /* bg-0 */
    border: 1px solid #4A5260; /* line-2 */
    border-radius: 3px;
    padding: 4px;
    color: #E8ECF1;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2BB673; /* ac */
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #252A33;
    color: #8B93A0;
    border: 1px solid #343B46;
}

/* ============ Buttons ============ */
QPushButton {
    background-color: #343B46; /* bg-4 */
    border: 1px solid #4A5260; /* line-2 */
    border-radius: 4px;
    padding: 5px 12px;
    color: #E8ECF1;
}

QPushButton:hover {
    background-color: #4A5260; /* bg-5 */
}

QPushButton:pressed {
    background-color: #6B7380; /* bg-6 */
}

QPushButton:focus {
    border: 1px solid #2BB673;
}

QPushButton:disabled {
    background-color: #252A33;
    border-color: #343B46;
    color: #8B93A0;
}

QPushButton[primary="true"] {
    background-color: #2BB673; /* ac */
    color: #1A1D23;
    border: 1px solid #239A61; /* ac-2 */
    font-weight: bold;
}

QPushButton[primary="true"]:hover {
    background-color: #239A61; /* ac-2 */
}

QPushButton[primary="true"]:focus {
    border: 1px solid #3DCF6A;
}

QPushButton[primary="true"]:disabled {
    background-color: #343B46;
    border-color: #4A5260;
    color: #8B93A0;
}

QPushButton[ghost="true"] {
    background-color: transparent;
    border: 1px solid #4A5260; /* line-2 */
    color: #E8ECF1;
}

QPushButton[ghost="true"]:hover {
    background-color: #252A33; /* bg-3 */
}

QPushButton[ghost="true"]:disabled {
    border-color: #343B46;
    color: #8B93A0;
}

QPushButton[danger="true"] {
    background-color: transparent;
    border: 1px solid #F07167; /* err */
    color: #F07167;
}

QPushButton[danger="true"]:hover {
    background-color: rgba(240, 113, 103, 0.15);
}

QPushButton[danger="true"]:disabled {
    border-color: #343B46;
    color: #8B93A0;
}

QPushButton[ai="true"] {
    background-color: rgba(164, 138, 251, 0.09); /* ai-soft */
    border: 1px solid rgba(164, 138, 251, 0.42); /* ai-line */
    color: #A48AFB; /* ai */
}

QPushButton[ai="true"]:hover {
    background-color: rgba(164, 138, 251, 0.15);
}

QPushButton[ai="true"]:disabled {
    border-color: #343B46;
    color: #8B93A0;
}

/* ============ Progress Bar ============ */
QProgressBar {
    background-color: #252A33; /* bg-3 */
    border: 1px solid #4A5260;
    border-radius: 5px;
    height: 10px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2BB673; /* ac */
    border-radius: 4px;
}

/* ============ Tree and Lists ============ */
QTreeView, QTreeWidget, QListView {
    background-color: #1E2229;
    border: 1px solid #343B46; /* line-1 */
    show-decoration-selected: 1;
}

QTreeView:focus, QTreeWidget:focus, QListView:focus {
    border: 1px solid #2BB673;
}

QTreeView::item, QTreeWidget::item, QListView::item {
    padding: 3px;
    min-height: 22px; /* row-h */
}

QTreeView::item:hover, QTreeWidget::item:hover, QListView::item:hover {
    background-color: #252A33; /* bg-3 */
}

QTreeView::item:selected, QTreeWidget::item:selected, QListView::item:selected {
    background-color: rgba(43, 182, 115, 0.10); /* ac-soft */
    color: #2BB673; /* ac */
    border-left: 2px solid #2BB673;
}

/* ============ Map Canvas ============ */
QGraphicsView {
    background-color: #2A303A; /* map-bg */
    border: 1px solid #4A5260;
    border-radius: 4px;
}

QGraphicsView:focus {
    border: 1px solid #2BB673; /* ac */
}

/* ============ Scroll Areas ============ */
QScrollArea {
    background-color: #22262E;
    border: 1px solid #4A5260;
    border-radius: 4px;
}

/* ============ Docking ============ */
QDockWidget {
    color: #E8ECF1; /* t-0 */
    font-weight: bold;
    border: 1px solid #343B46; /* line-1 */
}

QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #22262E, stop:1 #252A33);
    padding: 6px;
    padding-left: 10px;
    color: #E8ECF1;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid #4A5260; /* line-2 */
    min-height: 26px; /* header-h */
}

/* ============ Tabs ============ */
QTabWidget::pane {
    border: 1px solid #4A5260;
    border-radius: 4px;
    background-color: #1E2229;
}

QTabBar::tab {
    background: #343B46; /* bg-4 */
    border: 1px solid #4A5260;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 12px;
    margin-right: 2px;
    color: #A8B0BC; /* t-2 */
}

QTabBar::tab:focus {
    border-color: #2BB673;
}

QTabBar::tab:selected {
    background: #1E2229;
    border-color: #4A5260;
    color: #2BB673; /* ac */
    font-weight: bold;
    border-top: 2px solid #2BB673;
}

QTabBar::tab:hover {
    background: #1E2229;
    border-color: #4A5260;
    color: #E8ECF1;
}

/* ============ Menu Bar ============ */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1E2229, stop:1 #1A1D23);
    border-bottom: 1px solid #4A5260;
    color: #E8ECF1;
    font-size: 12px;
    min-height: 30px;
    spacing: 0px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    margin: 2px 1px 2px 0;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #252A33; /* bg-3 */
    color: #E8ECF1;
}

QMenuBar::item:pressed {
    background-color: rgba(43, 182, 115, 0.10);
    color: #2BB673;
}

/* ============ Menu (with icons) ============ */
QMenu {
    background-color: #1E2229;
    border: 1px solid #4A5260;
    border-radius: 6px;
    color: #E8ECF1;
    padding: 6px 4px;
}

QMenu::item {
    padding: 6px 28px 6px 8px;
    border-radius: 4px;
    margin: 1px 4px;
    min-height: 22px;
    icon-size: 16px;
}

QMenu::item:selected {
    background-color: rgba(43, 182, 115, 0.12); /* ac-soft */
    color: #239A61; /* ac-2 */
}

QMenu::item:disabled {
    color: #8B93A0; /* t-4 */
    background: transparent;
}

QMenu::icon {
    padding-left: 6px;
    padding-right: 8px;
}

QMenu::separator {
    height: 1px;
    background: #343B46; /* line-1 */
    margin: 5px 10px;
}

QMenu::right-arrow {
    width: 10px;
    height: 10px;
    margin-right: 6px;
}

QLabel#rsMenuSectionTitle {
    color: #A8B0BC;
    font-size: 11px;
}

/* ============ Toolbar ============ */
QToolBar {
    background-color: #1E2229; /* bg-0 */
    border-bottom: 1px solid #4A5260;
    spacing: 3px;
    padding: 5px 6px;
    min-height: 38px;
}

QToolBar::handle {
    background: #343B46;
    width: 2px;
    margin: 6px 2px;
    border-radius: 1px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 6px;
    color: #E8ECF1;
    font-size: 11px;
    min-height: 28px;
    min-width: 28px;
    icon-size: 20px;
}

QToolButton:hover {
    background-color: #252A33; /* bg-3 */
    border: 1px solid #343B46; /* line-1 */
}

QToolButton:checked, QToolButton:pressed {
    background-color: rgba(43, 182, 115, 0.10); /* ac-soft */
    border: 1px solid rgba(43, 182, 115, 0.40); /* ac-line */
    color: #2BB673; /* ac */
    font-weight: bold;
}

QToolButton:disabled {
    color: #8B93A0;
}

QToolBar::separator {
    width: 1px;
    background: #343B46; /* line-1 */
    margin: 6px 4px;
}

/* ============ Status Bar ============ */
QStatusBar {
    background-color: #1A1D23; /* bg-1 */
    border-top: 1px solid #4A5260;
    color: #A8B0BC; /* t-2 */
    min-height: 22px;
}

/* ============ CheckBox & Tree Indicator ============ */
QCheckBox::indicator, QTreeView::indicator {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    border: 1px solid #6B7380;
    background-color: #1E2229;
}

QCheckBox::indicator:checked, QTreeView::indicator:checked {
    background-color: #2BB673; /* ac */
    border: 1px solid #2BB673;
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIzIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiPjxwb2x5bGluZSBwb2ludHM9IjIwIDYgOSAxNyA0IDEyIi8+PC9zdmc+);
}

QCheckBox::indicator:unchecked, QTreeView::indicator:unchecked {
    background-color: #1E2229;
}

/* ============ Splitter ============ */
QSplitter::handle {
    background-color: #343B46;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #2BB673; /* ac */
}

/* ============ Scrollbars ============ */
QScrollBar:vertical {
    border: none;
    background: #1A1D23;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #4A5260;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #6B7380;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #1A1D23;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #4A5260;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #6B7380;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============ RsPanel ============ */
#rsPanel { background: #1E2229; border: none; }
#rsPanelHeader {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #22262E, stop:1 #252A33);
    border-bottom: 1px solid #4A5260;
}
#rsPanelTitle {
    color: #E8ECF1; font-weight: 600; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.08em;
}
QToolButton#rsPanelAction { border: none; border-radius: 2px; background: transparent; }
QToolButton#rsPanelAction:hover { background: #252A33; }
#rsPanelBody { background: #1E2229; }

/* ============ RsTabBar ============ */
#rsTabBar { background: #1A1D23; border-bottom: 1px solid #4A5260; }
QToolButton#rsTab {
    border: none; background: transparent; color: #A8B0BC;
    padding: 0 12px; font-size: 11px; border-right: 1px solid #343B46;
}
QToolButton#rsTab:hover { color: #E8ECF1; }
QToolButton#rsTab:checked {
    background: #1E2229; color: #E8ECF1;
    border-bottom: 2px solid #2BB673; /* ac */
}

/* ============ RsToolBar ============ */
#rsToolBar { background: #1E2229; border-bottom: 1px solid #4A5260; }
#rsToolGroup { border-right: 1px solid #343B46; }
QToolButton#rsToolBtn {
    border: 1px solid transparent; border-radius: 3px; padding: 0 8px;
    min-height: 26px; color: #E8ECF1; font-size: 11px;
}
QToolButton#rsToolBtn:hover { background: #252A33; color: #E8ECF1; }
QToolButton#rsToolBtn:checked {
    background: rgba(43, 182, 115, 0.10); color: #2BB673;
    border: 1px solid rgba(43, 182, 115, 0.40);
}

/* ============ RsStatusBar ============ */
#rsStatusBar { background: #1A1D23; border-top: 1px solid #4A5260; }
#rsStatusBar QLabel {
    font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 11px;
    color: #A8B0BC; padding: 0 10px; border-right: 1px solid #343B46;
}
QLabel#rsSegOk { color: #3DCF6A; }
QLabel#rsSegMuted { color: #A8B0BC; }
QLabel#rsReadyLabel { color: #2BB673; font-weight: 600; }
QLabel#rsReadyBusy { color: #E0A82E; font-weight: 600; }

/* ============ RsSearchInput ============ */
#rsSearchInput { background: #1A1D23; border: 1px solid #4A5260; border-radius: 3px; }
QLineEdit#rsSearchEdit { background: transparent; border: none; font-size: 12px; color: #E8ECF1; }

/* ============ RsConsole ============ */
#rsConsole { background: #1E2229; border-top: 1px solid #343B46; }
QPlainTextEdit#rsConsoleView {
    background: #1E2229; border: none; padding: 6px 12px;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 12px;
    color: #A8B0BC;
}

/* ============ Property Panel ============ */
#rsPropScroll { background: #1E2229; border: none; }
QLabel#rsSectionHeader {
    color: #A8B0BC; font-size: 10px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em; padding: 8px 10px 4px;
}
QLabel#rsPropKey { color: #A8B0BC; font-size: 12px; }
QLabel#rsPropVal { color: #E8ECF1; font-size: 12px; }
QLabel#rsPropValMono {
    color: #E8ECF1; font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 12px;
}
QLabel#rsPropEmpty { color: #A8B0BC; font-size: 12px; padding: 24px; }

/* ============ Map Overlays ============ */
#mapOverlayContainer { background: #2A303A; }
QLabel#mapInfoPill {
    background: rgba(30,34,41,0.94); border: 1px solid rgba(255,255,255,0.10);
    border-radius: 3px; padding: 4px 8px;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 11px; color: #E8ECF1;
}
QToolButton#mapBandBtn {
    background: rgba(30,34,41,0.94); border: 1px solid rgba(255,255,255,0.10);
    border-radius: 3px; padding: 4px 9px; font-size: 11px; color: #E8ECF1;
}
QToolButton#mapBandBtn:checked {
    background: #1E2229; color: #2BB673; border: 1px solid rgba(43,182,115,0.40); font-weight: 600;
}
QLabel#mapNorth {
    background: rgba(30,34,41,0.94); border: 1px solid rgba(255,255,255,0.10);
    border-radius: 17px; color: #2BB673; font-weight: 700; font-size: 12px;
}
QLabel#mapScaleBar {
    background: rgba(30,34,41,0.94); border: 1px solid rgba(255,255,255,0.10);
    border-radius: 3px; padding: 4px 8px;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 11px; color: #E8ECF1;
}

/* ============ Brand ============ */
QLabel#rsBrandLogo {
    background: #2BB673; /* ac */
    color: #1E2229; font-weight: 700; font-size: 10px;
    border-radius: 3px; min-width: 18px; min-height: 18px;
    qproperty-alignment: AlignCenter;
}
QLabel#rsBrandName {
    color: #E8ECF1; font-weight: 600; letter-spacing: 0.08em; padding: 0 8px;
}
QLabel#rsBrandVersion {
    color: #A8B0BC; font-size: 11px; padding: 0 8px;
}
QWidget#rsMenuBarBrand, QWidget#rsMenuBarRight {
    background: transparent;
}

/* ============ Splash Screen ============ */
QWidget#splashContainer {
    background-color: #1E2229;
    border: 2px solid #2BB673;
    border-radius: 8px;
}

QLabel#splashTitle {
    color: #2BB673;
    font-size: 30px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#splashSubtitle {
    color: #A8B0BC;
    font-size: 13px;
    margin-bottom: 30px;
}

QLabel#splashStatus {
    color: #2BB673;
    font-size: 11px;
    font-weight: bold;
}

/* ============ Agent Dock ============ */
QScrollArea#agentChatArea {
    background-color: #1A1D23;
    border: 1px solid #4A5260;
    border-radius: 4px;
}

QLabel#typingIndicator {
    color: #A8B0BC;
    font-style: italic;
    font-size: 11px;
    margin-left: 10px;
}

QFrame#userBubble {
    background-color: #252A33;
    border: 1px solid #343B46;
    border-radius: 8px;
    margin-left: 50px;
}

QFrame#agentBubble {
    background-color: #1E2229;
    border: 1.5px solid #A48AFB; /* ai */
    border-radius: 8px;
    margin-right: 50px;
}

QWidget#scriptDrawer {
    background-color: #22262E;
    border: 1px solid #4A5260;
    border-radius: 4px;
}

QLabel#drawerTitle {
    color: #E8ECF1;
    font-size: 12px;
    font-weight: bold;
}

#scriptDrawer QTextEdit {
    background-color: #1E2229;
    border: 1px solid #4A5260;
    border-radius: 4px;
    color: #E8ECF1;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace;
    font-size: 11px;
    padding: 6px;
}

QPushButton#copyBtn {
    background-color: #343B46;
    color: #E8ECF1;
    border: 1px solid #4A5260;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ===== Georeferencer GCP table (design.html ArtboardGeoref) =============== */
QTableView#rsGcpTable {
    gridline-color: #343B46;
    background: #1E2229;
    alternate-background-color: rgba(255,255,255,0.03);
    selection-background-color: rgba(43,182,115,0.08);
    selection-color: #2BB673;
}
QTableView#rsGcpTable::item:selected {
    border-left: 2px solid #2BB673;
}
QTableView#rsGcpTable QHeaderView::section {
    background: qlineargradient(x1:0 y1:0 x2:0 y2:1, stop:0 #22262E, stop:1 #252A33);
    color: #A8B0BC;
    border: none;
    border-bottom: 1px solid #343B46;
    padding: 4px 6px;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: 600;
}

/* ============ Dialogs (unified) ============ */
QDialog {
    background-color: #1A1D23; /* bg-1 */
}

QDialog QGroupBox {
    background-color: #1E2229;
    border: 1px solid #343B46;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
    color: #E8ECF1;
}

QDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #A8B0BC;
    font-size: 11px;
    font-weight: 600;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
    min-height: 28px;
}

/* Primary run buttons (object names used across dialogs) */
QPushButton#rsRunButton,
QPushButton#m_runButton {
    background-color: #2BB673;
    color: #1E2229;
    border: 1px solid #239A61;
    font-weight: 600;
    border-radius: 4px;
    padding: 6px 16px;
}

QPushButton#rsRunButton:hover,
QPushButton#m_runButton:hover {
    background-color: #239A61;
}

QPushButton#rsRunButton:disabled,
QPushButton#m_runButton:disabled {
    background-color: #4A5260;
    border-color: #6B7380;
    color: #A8B0BC;
}

/* ============ Tables / Headers (global) ============ */
QTableView, QTableWidget {
    background: #1E2229;
    border: 1px solid #343B46;
    border-radius: 4px;
    gridline-color: #252A33;
    selection-background-color: rgba(43, 182, 115, 0.18);
    selection-color: #2BB673;
    alternate-background-color: rgba(255, 255, 255, 0.03);
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #22262E, stop:1 #252A33);
    color: #A8B0BC;
    border: none;
    border-right: 1px solid #343B46;
    border-bottom: 1px solid #4A5260;
    padding: 5px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* ============ Form labels ============ */
QFormLayout QLabel, QLabel#rsFormLabel {
    color: #A8B0BC;
}

/* ============ Message / tooltip polish ============ */
QToolTip {
    background-color: #E8ECF1;
    color: #1E2229;
    border: 1px solid #E8ECF1;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 11px;
}

/* Help banners inside dialogs */
QFrame#rsGeorefParamsHelpBanner,
QFrame#rsDialogHelpBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #1A2A24, stop:1 #22262E);
    border: 1px solid #4A5260;
    border-radius: 6px;
}

QLabel#rsDialogHelpSummary {
    color: #E8ECF1;
    font-size: 12px;
}

QLabel#rsDialogStepBadge {
    color: #2BB673;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

/* Tool dialog sections (参数卡) */
QDialog#rsToolDialog {
    background-color: #1A1D23;
}

QFrame#rsDialogSection,
QFrame#rsParamSection {
    background: #1E2229;
    border: 1px solid #343B46;
    border-radius: 6px;
}

QLabel#rsDialogSectionTitle,
QLabel#rsParamSectionTitle {
    color: #E8ECF1;
    font-weight: 600;
    font-size: 12px;
    padding-bottom: 2px;
}

QLabel#rsDialogHint {
    color: #A8B0BC;
    font-size: 11px;
}

QPushButton#rsPrimaryButton {
    background-color: #2BB673;
    color: #1E2229;
    border: 1px solid #239A61;
    border-radius: 4px;
    font-weight: 600;
    padding: 6px 18px;
    min-height: 32px;
    min-width: 96px;
}

QPushButton#rsPrimaryButton:hover {
    background-color: #239A61;
}

QPushButton#rsPrimaryButton:disabled {
    background-color: #4A5260;
    border-color: #6B7380;
    color: #A8B0BC;
}

QPushButton#rsSecondaryButton,
QPushButton#rsDialogHelpBtn,
QPushButton#rsDialogHelpButton,
QPushButton#rsDialogCancelBtn,
QPushButton#rsDialogBrowseBtn {
    background-color: #1E2229;
    border: 1px solid #4A5260;
    border-radius: 4px;
    color: #E8ECF1;
    padding: 5px 12px;
    min-height: 30px;
}

QPushButton#rsSecondaryButton:hover,
QPushButton#rsDialogHelpBtn:hover,
QPushButton#rsDialogHelpButton:hover,
QPushButton#rsDialogCancelBtn:hover,
QPushButton#rsDialogBrowseBtn:hover {
    background-color: #252A33;
    border-color: #6B7380;
}

QLineEdit#rsDialogOutputEdit {
    min-height: 28px;
    padding: 4px 8px;
}

/* Classifier setup bar */
QWidget#rsClassifierSetupBar {
    background: #1E2229;
    border-top: 1px solid #343B46;
}

QToolButton#rsClassifierSetupBar QToolButton,
QWidget#rsClassifierSetupBar QToolButton {
    border: 1px solid #4A5260;
    border-radius: 4px;
    padding: 4px 10px;
    background: #1E2229;
    min-height: 26px;
}

QWidget#rsClassifierSetupBar QToolButton:checked {
    background: rgba(43, 182, 115, 0.12);
    border: 1px solid rgba(43, 182, 115, 0.45);
    color: #239A61;
    font-weight: 600;
}

QWidget#rsClassifierSetupBar QToolButton:disabled {
    color: #8B93A0;
    background: #1A1D23;
}

QPushButton#rsClassifierBtnApply {
    background-color: #2BB673;
    color: #1E2229;
    border: 1px solid #239A61;
    border-radius: 4px;
    font-weight: 600;
    padding: 6px 14px;
    min-height: 30px;
}

QPushButton#rsClassifierBtnApply:hover {
    background-color: #239A61;
}

QPushButton#rsClassifierBtnPreview,
QPushButton#rsClassifierBtnCv {
    background: #1E2229;
    border: 1px solid #4A5260;
    border-radius: 4px;
    min-height: 30px;
    padding: 5px 12px;
}

/* Algorithm dialog */
QGroupBox#rsAlgCommandPreviewGroup {
    background: #22262E;
    border: 1px solid #343B46;
    border-radius: 6px;
    margin-top: 10px;
    font-weight: 600;
}

/* Status bar segments */
QStatusBar QLabel {
    padding: 0 8px;
    color: #A8B0BC;
}

QLabel#rsReadyLabel {
    color: #2BB673;
    font-weight: 600;
}

/* ============ Task panel ============ */
#rsTaskPanel {
  background: #1E2229;
  border-left: 1px solid #343B46;
}
#rsTaskPanelTitle {
  font-size: 14px;
  font-weight: 600;
  color: #E8ECF1;
}
#rsTaskPanelSectionLabel {
  color: #A8B0BC;
  font-size: 11px;
  margin-top: 8px;
}
QPushButton#rsTaskPanelRun[primary="true"] {
  background-color: #2BB673;
  color: #1E2229;
  border: none;
}
QPushButton#rsTaskPanelRun[primary="true"]:hover {
  background-color: #239A61;
}
QPushButton#rsTaskPanelRun:disabled,
QPushButton#rsTaskPanelRun[primary="true"]:disabled {
  background-color: #4A5260;
  border: none;
  color: #A8B0BC;
}
#rsTaskPanelHint {
  color: #A8B0BC;
  font-size: 11px;
}
#rsTaskPanelHint[error="true"] {
  color: #F07167;
}



/* ============ Band Composition Rail (signature chrome) ============ */
#rsBandCompositionRail {
    background: #252A33;
    border: none;
    border-bottom: 1px solid #343B46;
    min-height: 26px;
    max-height: 28px;
}
#rsBandCompositionRail QLabel {
    color: #A8B0BC;
    font-size: 11px;
    padding: 0 4px;
}
#rsBandChip {
    border-radius: 3px;
    min-width: 22px;
    max-width: 36px;
    min-height: 16px;
    max-height: 16px;
    font-size: 10px;
    font-weight: 700;
    color: #FFFFFF;
    qproperty-alignment: AlignCenter;
}
#rsBandChip[role="R"] { background: #F07167; }
#rsBandChip[role="G"] { background: #3DCF6A; }
#rsBandChip[role="B"] { background: #4DA3E0; }
#rsBandChip[role="NIR"] { background: #8B3A3A; }
#rsBandChip[role="Gray"] { background: #A8B0BC; }
#rsBandRangeLabel {
    font-family: 'IBM Plex Mono', 'SF Mono', monospace;
    font-size: 11px;
    color: #E8ECF1;
}
#rsBandMetaLabel {
    font-family: 'IBM Plex Mono', 'SF Mono', monospace;
    font-size: 11px;
    color: #A8B0BC;
}
#rsBandTaskPill {
    background: rgba(43, 182, 115, 0.10);
    border: 1px solid rgba(43, 182, 115, 0.35);
    border-radius: 10px;
    color: #2BB673;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 10px;
}
#rsBandTaskPill[idle="true"] {
    background: transparent;
    border: 1px solid #4A5260;
    color: #A8B0BC;
    font-weight: 400;
}

/* ============ Histogram instrument window ============ */
#rsHistogramChart {
    background: #12141A;
    border: 1px solid #4A5260;
    border-radius: 4px;
}
#rsHistogramStretchRoot QLabel {
    color: #A8B0BC;
}
#rsHistogramStretchRoot QPushButton[primary="true"] {
    background-color: #2BB673;
    color: #1E2229;
    border: 1px solid #239A61;
    font-weight: 600;
}

/* ============ Task Center (rsJobPanelDock) ============ */
#rsJobPanelDock {
    background-color: #1E2229;
}

#rsJobPanelHint {
    color: #A8B0BC;
    font-size: 11px;
    padding: 2px 0px;
}

#rsJobPanelDock QTreeWidget {
    background-color: #1E2229;
    border: 1px solid #343B46;
    border-radius: 4px;
}

#rsJobPanelDock QTreeWidget::item {
    min-height: 24px;
    padding: 2px 4px;
}

#rsJobDetailTabs::pane {
    background-color: #1E2229;
    border: 1px solid #343B46;
    border-radius: 4px;
}

#rsJobDetailView, #rsJobLogView {
    background-color: #1A1D23;
    border: 1px solid #343B46;
    border-radius: 4px;
    font-family: 'IBM Plex Mono', 'SF Mono', 'Cascadia Code', 'Consolas', monospace;
    font-size: 12px;
    color: #E8ECF1;
    padding: 4px;
}

#rsJobDetailView:focus, #rsJobLogView:focus {
    border: 1px solid #2BB673;
}

/* Empty-state hint */
QLabel#rsEmptyHint {
    color: #A8B0BC;
    font-size: 13px;
    padding: 24px;
}

/* Map selection accent (distinct from interactive green) */
QTreeView::item:selected, QTreeWidget::item:selected, QListView::item:selected {
    background-color: rgba(43, 182, 115, 0.10);
    color: #2BB673;
    border-left: 2px solid #2BB673;
}

#rsBandRailHost {
    background: #252A33;
    border: none;
    border-bottom: 1px solid #343B46;
    spacing: 0;
    padding: 0;
}
#rsBandRailHost::separator { width: 0; background: transparent; }

#rsTopChrome {
    background: #1E2229;
    border: none;
    /* Base 154 (ribbon only) + up to 2×32 toolbar rows */
    min-height: 154px;
    max-height: 218px;
}
#rsRibbonDock {
    border: none;
    padding: 0;
    margin: 0;
    min-height: 154px;
    max-height: 218px;
}
#rsRibbonDock > QWidget {
    border: none;
    padding: 0;
    margin: 0;
}
#rsToolbarStrip {
    background: #1E2229;
    border-top: 1px solid #343B46;
}
#rsToolbarStrip QToolBar,
#rsToolbarRow QToolBar {
    background: #1E2229;
    border: none;
    border-bottom: none;
    min-height: 32px;
    max-height: 32px;
    padding: 1px 4px;
    spacing: 2px;
}
#rsToolbarStrip QToolButton,
#rsToolbarRow QToolButton {
    min-height: 24px;
    max-height: 28px;
    min-width: 24px;
    padding: 2px;
    icon-size: 18px;
}
#rsToolbarFlowHost {
    background: #1E2229;
}
#rsToolbarChip {
    background: #1E2229;
    border: 1px solid #343B46;
    border-radius: 4px;
}
#rsToolbarDragGrip {
    background: #252A33;
    border-right: 1px solid #343B46;
}
#rsToolbarDragGrip:hover {
    background: #3DCF6A;
}
#rsToolbarResizeGrip {
    background: #343B46;
    border-left: 1px solid #252A33;
}
#rsToolbarResizeGrip:hover {
    background: #3DCF6A;
}
#rsRibbonHost {
    background: #1E2229;
    border: none;
    border-bottom: 1px solid #343B46;
    spacing: 0;
    padding: 0;
}

#rsRibbonSliderBox { background: transparent; }
#rsRibbonSliderTitle { color: #A8B0BC; font-size: 10px; }
#rsRibbonSliderValue {
    color: #E8ECF1;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace;
    font-size: 10px;
}
#rsRibbonSlider {
    min-height: 16px;
    max-height: 18px;
}
#rsRibbonSlider::groove:horizontal {
    height: 4px; background: #343B46; border-radius: 2px;
}
#rsRibbonSlider::handle:horizontal {
    width: 12px; height: 12px; margin: -4px 0;
    background: #2BB673; border-radius: 6px; border: 1px solid #239A61;
}
#rsRibbonSlider::sub-page:horizontal { background: #2BB673; border-radius: 2px; }
#rsRibbonSystemMenu {
    color: #2BB673; font-weight: 700; font-size: 11px;
    padding: 2px 8px; border: 1px solid transparent; border-radius: 4px;
}
#rsRibbonSystemMenu:hover {
    background: rgba(43, 182, 115, 0.12);
    border: 1px solid rgba(43, 182, 115, 0.40);
}
#rsRibbonSystemMenu::menu-indicator { image: none; width: 0; }

/* ============ ArcGIS Pro–style ribbon ============ */
#rsRibbonBar {
    background: #1E2229;
    border: none;
    border-bottom: 1px solid #343B46;
    min-height: 154px;
}
#rsRibbonQat {
    background: #1A1D23;
    border-bottom: 1px solid #343B46;
}
#rsRibbonQatBrand {
    color: #A8B0BC;
    font-size: 11px;
    font-weight: 600;
    padding: 0 10px;
}
#rsRibbonQatBtn {
    border: 1px solid transparent;
    border-radius: 3px;
    background: transparent;
}
#rsRibbonQatBtn:hover {
    background: rgba(43, 182, 115, 0.12);
    border: 1px solid rgba(43, 182, 115, 0.35);
}
#rsRibbonQatBtn:focus {
    border: 1px solid #2BB673;
}
#rsRibbonQatBtn:disabled {
    color: #8B93A0;
}
#rsRibbonQatSep {
    background: #343B46;
    margin: 0 6px;
}
#rsRibbonTabRow {
    background: #1E2229;
    border-bottom: 1px solid #343B46;
}
QPushButton#rsRibbonTabButton {
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    color: #A8B0BC;
    font-size: 12px;
    padding: 4px 14px;
    margin: 0 1px;
}
QPushButton#rsRibbonTabButton:hover {
    color: #E8ECF1;
    background: #252A33;
}
QPushButton#rsRibbonTabButton:focus {
    border-bottom: 3px solid #2BB673;
    color: #2BB673;
}
QPushButton#rsRibbonTabButton:checked {
    color: #2BB673;
    font-weight: 700;
    border-bottom: 3px solid #2BB673;
    background: #1E2229;
}
QPushButton#rsRibbonTabButton:disabled {
    color: #8B93A0;
}
#rsRibbonStack, #rsRibbonPageScroll, #rsRibbonPage {
    background: #1A1D23;
    border: none;
}
#rsRibbonGroup {
    background: transparent;
    min-width: 64px;
}
#rsRibbonGroupTitle {
    color: #A8B0BC;
    font-size: 10px;
    padding: 1px 4px 2px;
    border-top: 1px solid #343B46;
}
#rsRibbonGroupSep {
    background: #343B46;
    margin: 6px 4px;
}
#rsRibbonLargeBtn {
    color: #E8ECF1;
    font-size: 11px;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px 4px;
    background: transparent;
}
#rsRibbonLargeBtn:hover {
    background: rgba(43, 182, 115, 0.12);
    border: 1px solid rgba(43, 182, 115, 0.35);
}
#rsRibbonLargeBtn:pressed, #rsRibbonLargeBtn:checked {
    background: rgba(43, 182, 115, 0.18);
    border: 1px solid rgba(43, 182, 115, 0.45);
    color: #2BB673;
}
#rsRibbonLargeBtn:focus {
    border: 1px solid #2BB673;
}
#rsRibbonLargeBtn:disabled {
    color: #8B93A0;
    background: transparent;
    border-color: transparent;
}
/* Status bar session meta */
#rsStatusMetaLabel, #rsLayerStatusLabel {
    color: #A8B0BC;
    font-size: 11px;
    padding: 0 2px;
}
#rsLayerStatusLabel {
    color: #E8ECF1;
    font-weight: 500;
}
#rsStatusOpacitySlider {
    min-height: 14px;
    max-height: 16px;
}
#rsStatusOpacitySlider::groove:horizontal {
    height: 4px;
    background: #343B46;
    border-radius: 2px;
}
#rsStatusOpacitySlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    background: #2BB673;
    border-radius: 6px;
}
#rsStatusOpacitySlider::sub-page:horizontal {
    background: #2BB673;
    border-radius: 2px;
}

/* Algorithm dialog parameter form */
#rsAlgParamForm {
    background: transparent;
}
#rsAlgFieldLabel {
    color: #A8B0BC;
    font-size: 12px;
    font-weight: 500;
}
#rsAlgFieldBlock {
    background: transparent;
}
#rsAlgCommandPreviewGroup {
    margin-top: 4px;
}
#rsAlgCommandPreview {
    background: #1A1D23;
    border: 1px solid #343B46;
    border-radius: 4px;
    font-size: 11px;
    color: #E8ECF1;
}
#rsAlgParamScroll {
    border: none;
    background: transparent;
}

/* Ribbon combobox (band pickers, modes, …) */
#rsRibbonComboBox {
    background: transparent;
}
#rsRibbonComboTitle {
    color: #A8B0BC;
    font-size: 10px;
}
QComboBox#rsRibbonCombo {
    background: #1A1D23;
    border: 1px solid #343B46;
    border-radius: 3px;
    padding: 2px 6px;
    min-height: 22px;
    color: #E8ECF1;
    font-size: 11px;
}
QComboBox#rsRibbonCombo:hover {
    border: 1px solid rgba(43, 182, 115, 0.55);
}
QComboBox#rsRibbonCombo:focus {
    border: 1px solid #2BB673;
}
QComboBox#rsRibbonCombo:disabled {
    color: #8B93A0;
    background: #252A33;
}
QComboBox#rsRibbonCombo::drop-down {
    border: none;
    width: 18px;
}
QComboBox#rsRibbonCombo QAbstractItemView {
    background: #1E2229;
    border: 1px solid #343B46;
    selection-background-color: rgba(43, 182, 115, 0.18);
    selection-color: #2BB673;
    outline: none;
}

#rsRibbonPageScroll QScrollBar:horizontal {
    height: 6px;
    background: transparent;
}
#rsRibbonPageScroll QScrollBar::handle:horizontal {
    background: #343B46;
    border-radius: 3px;
    min-width: 24px;
}
#rsRibbonPageScroll QScrollBar::handle:horizontal:hover {
    background: #4A5260;
}
