/*
 * SICNU GEO RS — Light Theme QSS (Canopy Lab)
 * Design tokens: cool paper + canopy teal accent; map-select blue separate.
 *
 * surface.canvas   #F4F6F8
 * surface.panel    #FFFFFF
 * surface.raised   #EEF1F4
 * ink.primary      #1C2430
 * ink.secondary    #5A6573
 * line.subtle      #E2E6EB
 * line.strong      #C5CDD6
 * accent           #0B6E4F  hover #095C42
 * mapSelect        #1B6CA8
 * state.ok/warn/err  #1A7F37 / #B58100 / #C9372C
 * ai               #6E56CF
 * domain veg/water/soil  #2F9E44 / #0B6BCB / #A67C52
 * Font: IBM Plex Sans / IBM Plex Mono · radii 4px · body 13px
 */
/* ============ Global ============ */
QWidget {
    font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans CJK SC', 'Source Han Sans CN', 'WenQuanYi Micro Hei', system-ui, sans-serif;
    font-size: 13px;
    color: #1C2430;
}

QMainWindow {
    background-color: #F4F6F8; /* bg-1 */
}

/* ============ Input Fields ============ */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff; /* bg-0 */
    border: 1px solid #C5CDD6; /* line-2 */
    border-radius: 3px;
    padding: 4px;
    color: #1C2430;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #0B6E4F; /* ac */
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #EEF1F4;
    color: #8A93A0;
    border: 1px solid #E2E6EB;
}

/* ============ Buttons ============ */
QPushButton {
    background-color: #E2E6EB; /* bg-4 */
    border: 1px solid #C5CDD6; /* line-2 */
    border-radius: 4px;
    padding: 5px 12px;
    color: #1C2430;
}

QPushButton:hover {
    background-color: #C5CDD6; /* bg-5 */
}

QPushButton:pressed {
    background-color: #A8B1BC; /* bg-6 */
}

QPushButton:focus {
    border: 1px solid #0B6E4F;
}

QPushButton:disabled {
    background-color: #EEF1F4;
    border-color: #E2E6EB;
    color: #8A93A0;
}

QPushButton[primary="true"] {
    background-color: #0B6E4F; /* ac */
    color: #ffffff;
    border: 1px solid #095C42; /* ac-2 */
    font-weight: bold;
}

QPushButton[primary="true"]:hover {
    background-color: #095C42; /* ac-2 */
}

QPushButton[primary="true"]:focus {
    border: 1px solid #063C2B;
}

QPushButton[primary="true"]:disabled {
    background-color: #C5CDD6;
    border-color: #A8B1BC;
    color: #FFFFFF;
}

QPushButton[ghost="true"] {
    background-color: transparent;
    border: 1px solid #C5CDD6; /* line-2 */
    color: #1C2430;
}

QPushButton[ghost="true"]:hover {
    background-color: #EEF1F4; /* bg-3 */
}

QPushButton[ghost="true"]:disabled {
    border-color: #E2E6EB;
    color: #8A93A0;
}

QPushButton[danger="true"] {
    background-color: transparent;
    border: 1px solid #C9372C; /* err */
    color: #C9372C;
}

QPushButton[danger="true"]:hover {
    background-color: rgba(207, 34, 46, 0.08);
}

QPushButton[danger="true"]:disabled {
    border-color: #E2E6EB;
    color: #8A93A0;
}

QPushButton[ai="true"] {
    background-color: rgba(110, 86, 207, 0.09); /* ai-soft */
    border: 1px solid rgba(110, 86, 207, 0.42); /* ai-line */
    color: #6E56CF; /* ai */
}

QPushButton[ai="true"]:hover {
    background-color: rgba(110, 86, 207, 0.15);
}

QPushButton[ai="true"]:disabled {
    border-color: #E2E6EB;
    color: #8A93A0;
}

/* ============ Progress Bar ============ */
QProgressBar {
    background-color: #EEF1F4; /* bg-3 */
    border: 1px solid #C5CDD6;
    border-radius: 5px;
    height: 10px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #0B6E4F; /* ac */
    border-radius: 4px;
}

/* ============ Tree and Lists ============ */
QTreeView, QTreeWidget, QListView {
    background-color: #ffffff;
    border: 1px solid #E2E6EB; /* line-1 */
    show-decoration-selected: 1;
}

QTreeView:focus, QTreeWidget:focus, QListView:focus {
    border: 1px solid #0B6E4F;
}

QTreeView::item, QTreeWidget::item, QListView::item {
    padding: 3px;
    min-height: 22px; /* row-h */
}

QTreeView::item:hover, QTreeWidget::item:hover, QListView::item:hover {
    background-color: #EEF1F4; /* bg-3 */
}

QTreeView::item:selected, QTreeWidget::item:selected, QListView::item:selected {
    background-color: rgba(11, 110, 79, 0.10); /* ac-soft */
    color: #0B6E4F; /* ac */
    border-left: 2px solid #0B6E4F;
}

/* ============ Map Canvas ============ */
QGraphicsView {
    background-color: #E8ECF0; /* map-bg */
    border: 1px solid #C5CDD6;
    border-radius: 4px;
}

QGraphicsView:focus {
    border: 1px solid #0B6E4F; /* ac */
}

/* ============ Scroll Areas ============ */
QScrollArea {
    background-color: #F8FAFB;
    border: 1px solid #C5CDD6;
    border-radius: 4px;
}

/* ============ Docking ============ */
QDockWidget {
    color: #1C2430; /* t-0 */
    font-weight: bold;
    border: 1px solid #E2E6EB; /* line-1 */
}

QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F8FAFB, stop:1 #EEF1F4);
    padding: 6px;
    padding-left: 10px;
    color: #1C2430;
    font-weight: bold;
    font-size: 11px;
    border-bottom: 1px solid #C5CDD6; /* line-2 */
    min-height: 26px; /* header-h */
}

/* ============ Tabs ============ */
QTabWidget::pane {
    border: 1px solid #C5CDD6;
    border-radius: 4px;
    background-color: #ffffff;
}

QTabBar::tab {
    background: #E2E6EB; /* bg-4 */
    border: 1px solid #C5CDD6;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 12px;
    margin-right: 2px;
    color: #5A6573; /* t-2 */
}

QTabBar::tab:focus {
    border-color: #0B6E4F;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-color: #C5CDD6;
    color: #0B6E4F; /* ac */
    font-weight: bold;
    border-top: 2px solid #0B6E4F;
}

QTabBar::tab:hover {
    background: #ffffff;
    border-color: #C5CDD6;
    color: #1C2430;
}

QTabBar::tab:bottom {
    border-top: none;
    border-bottom: 1px solid #C5CDD6;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

QTabBar::tab:bottom:selected {
    border-bottom: 2px solid #0B6E4F;
    border-top: none;
}

QDockWidget::close-button, QDockWidget::float-button {
    border: none;
    background: transparent;
    padding: 2px;
    border-radius: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #E2E6EB;
}

/* ============ Menu Bar ============ */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #f4f6f9);
    border-bottom: 1px solid #C5CDD6;
    color: #1C2430;
    font-size: 12px;
    min-height: 30px;
    spacing: 0px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    margin: 2px 1px 2px 0;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #EEF1F4; /* bg-3 */
    color: #1C2430;
}

QMenuBar::item:pressed {
    background-color: rgba(11, 110, 79, 0.10);
    color: #0B6E4F;
}

/* ============ Menu (with icons) ============ */
QMenu {
    background-color: #ffffff;
    border: 1px solid #C5CDD6;
    border-radius: 6px;
    color: #1C2430;
    padding: 6px 4px;
}

QMenu::item {
    padding: 6px 28px 6px 8px;
    border-radius: 4px;
    margin: 1px 4px;
    min-height: 22px;
    icon-size: 16px;
}

QMenu::item:selected {
    background-color: rgba(11, 110, 79, 0.12); /* ac-soft */
    color: #095C42; /* ac-2 */
}

QMenu::item:disabled {
    color: #8A93A0; /* t-4 */
    background: transparent;
}

QMenu::icon {
    padding-left: 6px;
    padding-right: 8px;
}

QMenu::separator {
    height: 1px;
    background: #E2E6EB; /* line-1 */
    margin: 5px 10px;
}

QMenu::right-arrow {
    width: 10px;
    height: 10px;
    margin-right: 6px;
}

QLabel#rsMenuSectionTitle {
    color: #5A6573;
    font-size: 11px;
}

/* ============ Toolbar ============ */
QToolBar {
    background-color: #ffffff; /* bg-0 */
    border-bottom: 1px solid #C5CDD6;
    spacing: 3px;
    padding: 5px 6px;
    min-height: 38px;
}

QToolBar::handle {
    background: #E2E6EB;
    width: 2px;
    margin: 6px 2px;
    border-radius: 1px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 6px;
    color: #1C2430;
    font-size: 11px;
    min-height: 28px;
    min-width: 28px;
    icon-size: 20px;
}

QToolButton:hover {
    background-color: #EEF1F4; /* bg-3 */
    border: 1px solid #E2E6EB; /* line-1 */
}

QToolButton:checked, QToolButton:pressed {
    background-color: rgba(11, 110, 79, 0.10); /* ac-soft */
    border: 1px solid rgba(11, 110, 79, 0.40); /* ac-line */
    color: #0B6E4F; /* ac */
    font-weight: bold;
}

QToolButton:disabled {
    color: #8A93A0;
}

QToolBar::separator {
    width: 1px;
    background: #E2E6EB; /* line-1 */
    margin: 6px 4px;
}

/* ============ Status Bar ============ */
QStatusBar {
    background-color: #F4F6F8; /* bg-1 */
    border-top: 1px solid #C5CDD6;
    color: #5A6573; /* t-2 */
    min-height: 22px;
}

/* ============ CheckBox & Tree Indicator ============ */
QCheckBox::indicator, QTreeView::indicator {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    border: 1px solid #A8B1BC;
    background-color: #ffffff;
}

QCheckBox::indicator:checked, QTreeView::indicator:checked {
    background-color: #0B6E4F; /* ac */
    border: 1px solid #0B6E4F;
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIzIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiPjxwb2x5bGluZSBwb2ludHM9IjIwIDYgOSAxNyA0IDEyIi8+PC9zdmc+);
}

QCheckBox::indicator:unchecked, QTreeView::indicator:unchecked {
    background-color: #ffffff;
}

/* ============ Splitters & Dock Separators ============ */
QSplitter::handle {
    background-color: #E2E6EB;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover, QSplitter::handle:pressed {
    background-color: #0B6E4F; /* ac */
}

QMainWindow::separator {
    background-color: #E2E6EB;
    width: 4px;
    height: 4px;
}

QMainWindow::separator:hover {
    background-color: #0B6E4F;
}

/* ============ Scrollbars ============ */
QScrollBar:vertical {
    border: none;
    background: #F4F6F8;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #C5CDD6;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #A8B1BC;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #F4F6F8;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #C5CDD6;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #A8B1BC;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============ RsPanel ============ */
#rsPanel { background: #ffffff; border: none; }
#rsPanelHeader {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F8FAFB, stop:1 #EEF1F4);
    border-bottom: 1px solid #C5CDD6;
}
#rsPanelTitle {
    color: #1C2430; font-weight: 600; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.08em;
}
QToolButton#rsPanelAction { border: none; border-radius: 2px; background: transparent; }
QToolButton#rsPanelAction:hover { background: #EEF1F4; }
#rsPanelBody { background: #ffffff; }

/* ============ RsTabBar ============ */
#rsTabBar { background: #F4F6F8; border-bottom: 1px solid #C5CDD6; }
QToolButton#rsTab {
    border: none; background: transparent; color: #5A6573;
    padding: 0 12px; font-size: 11px; border-right: 1px solid #E2E6EB;
}
QToolButton#rsTab:hover { color: #1C2430; }
QToolButton#rsTab:checked {
    background: #ffffff; color: #1C2430;
    border-bottom: 2px solid #0B6E4F; /* ac */
}

/* ============ RsToolBar ============ */
#rsToolBar { background: #ffffff; border-bottom: 1px solid #C5CDD6; }
#rsToolGroup { border-right: 1px solid #E2E6EB; }
QToolButton#rsToolBtn {
    border: 1px solid transparent; border-radius: 3px; padding: 0 8px;
    min-height: 26px; color: #1C2430; font-size: 11px;
}
QToolButton#rsToolBtn:hover { background: #EEF1F4; color: #1C2430; }
QToolButton#rsToolBtn:checked {
    background: rgba(11, 110, 79, 0.10); color: #0B6E4F;
    border: 1px solid rgba(11, 110, 79, 0.40);
}

/* ============ RsStatusBar ============ */
#rsStatusBar { background: #F4F6F8; border-top: 1px solid #C5CDD6; }
#rsStatusBar QLabel {
    font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 11px;
    color: #5A6573; padding: 0 10px; border-right: 1px solid #E2E6EB;
}
QLabel#rsSegOk { color: #1a7f37; }
QLabel#rsSegMuted { color: #5A6573; }

/* ============ RsSearchInput ============ */
#rsSearchInput { background: #F4F6F8; border: 1px solid #C5CDD6; border-radius: 3px; }
QLineEdit#rsSearchEdit { background: transparent; border: none; font-size: 12px; color: #1C2430; }

/* ============ RsConsole ============ */
#rsConsole { background: #ffffff; border-top: 1px solid #E2E6EB; }
QPlainTextEdit#rsConsoleView {
    background: #ffffff; border: none; padding: 6px 12px;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 12px;
    color: #5A6573;
}

/* ============ Property Panel ============ */
#rsPropScroll { background: #ffffff; border: none; }
QLabel#rsSectionHeader {
    color: #5A6573; font-size: 10px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em; padding: 8px 10px 4px;
}
QLabel#rsPropKey { color: #5A6573; font-size: 12px; }
QLabel#rsPropVal { color: #1C2430; font-size: 12px; }
QLabel#rsPropValMono {
    color: #1C2430; font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 12px;
}
QLabel#rsPropEmpty { color: #5A6573; font-size: 12px; padding: 24px; }

/* ============ Map Overlays ============ */
#mapOverlayContainer { background: #E8ECF0; }
QLabel#mapInfoPill {
    background: rgba(255,255,255,0.92); border: 1px solid rgba(20,23,28,0.10);
    border-radius: 3px; padding: 4px 8px;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 11px; color: #1C2430;
}
QToolButton#mapBandBtn {
    background: rgba(255,255,255,0.92); border: 1px solid rgba(20,23,28,0.10);
    border-radius: 3px; padding: 4px 9px; font-size: 11px; color: #1C2430;
}
QToolButton#mapBandBtn:checked {
    background: #ffffff; color: #0B6E4F; border: 1px solid rgba(11,110,79,0.40); font-weight: 600;
}
QLabel#mapNorth {
    background: rgba(255,255,255,0.92); border: 1px solid rgba(20,23,28,0.10);
    border-radius: 17px; color: #0B6E4F; font-weight: 700; font-size: 12px;
}
QLabel#mapScaleBar {
    background: rgba(255,255,255,0.92); border: 1px solid rgba(20,23,28,0.10);
    border-radius: 3px; padding: 4px 8px;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace; font-size: 11px; color: #1C2430;
}

/* ============ Brand ============ */
QLabel#rsBrandLogo {
    background: #0B6E4F; /* ac */
    color: #ffffff; font-weight: 700; font-size: 10px;
    border-radius: 3px; min-width: 18px; min-height: 18px;
    qproperty-alignment: AlignCenter;
}
QLabel#rsBrandName {
    color: #1C2430; font-weight: 600; letter-spacing: 0.08em; padding: 0 8px;
}
QLabel#rsBrandVersion {
    color: #5A6573; font-size: 11px; padding: 0 8px;
}
QWidget#rsMenuBarBrand, QWidget#rsMenuBarRight {
    background: transparent;
}

/* ============ Splash Screen ============ */
QWidget#splashContainer {
    background-color: #ffffff;
    border: 2px solid #0B6E4F;
    border-radius: 8px;
}

QLabel#splashTitle {
    color: #0B6E4F;
    font-size: 30px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#splashSubtitle {
    color: #5A6573;
    font-size: 13px;
    margin-bottom: 30px;
}

QLabel#splashStatus {
    color: #0B6E4F;
    font-size: 11px;
    font-weight: bold;
}

/* ============ Agent Dock ============ */
QScrollArea#agentChatArea {
    background-color: #F4F6F8;
    border: 1px solid #C5CDD6;
    border-radius: 4px;
}

QLabel#typingIndicator {
    color: #5A6573;
    font-style: italic;
    font-size: 11px;
    margin-left: 10px;
}

QFrame#userBubble {
    background-color: #EEF1F4;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    margin-left: 50px;
}

QFrame#agentBubble {
    background-color: #ffffff;
    border: 1.5px solid #6E56CF; /* ai */
    border-radius: 8px;
    margin-right: 50px;
}

QWidget#scriptDrawer {
    background-color: #F8FAFB;
    border: 1px solid #C5CDD6;
    border-radius: 4px;
}

QLabel#drawerTitle {
    color: #1C2430;
    font-size: 12px;
    font-weight: bold;
}

#scriptDrawer QTextEdit {
    background-color: #ffffff;
    border: 1px solid #C5CDD6;
    border-radius: 4px;
    color: #1C2430;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace;
    font-size: 11px;
    padding: 6px;
}

QPushButton#copyBtn {
    background-color: #E2E6EB;
    color: #1C2430;
    border: 1px solid #C5CDD6;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ===== Georeferencer GCP table (design.html ArtboardGeoref) =============== */
QTableView#rsGcpTable {
    gridline-color: #E2E6EB;
    background: #ffffff;
    alternate-background-color: rgba(20,23,28,0.02);
    selection-background-color: rgba(11,110,79,0.08);
    selection-color: #0B6E4F;
}
QTableView#rsGcpTable::item:selected {
    border-left: 2px solid #0B6E4F;
}
QTableView#rsGcpTable QHeaderView::section {
    background: qlineargradient(x1:0 y1:0 x2:0 y2:1, stop:0 #F8FAFB, stop:1 #EEF1F4);
    color: #5A6573;
    border: none;
    border-bottom: 1px solid #E2E6EB;
    padding: 4px 6px;
    text-transform: uppercase;
    font-size: 9px;
    font-weight: 600;
}

/* ============ Dialogs (unified) ============ */
QDialog {
    background-color: #F4F6F8; /* bg-1 */
}

QDialog QGroupBox {
    background-color: #ffffff;
    border: 1px solid #E2E6EB;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
    color: #1C2430;
}

QDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #5A6573;
    font-size: 11px;
    font-weight: 600;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
    min-height: 28px;
}

/* Primary run buttons (object names used across dialogs) */
QPushButton#rsRunButton,
QPushButton#m_runButton {
    background-color: #0B6E4F;
    color: #ffffff;
    border: 1px solid #095C42;
    font-weight: 600;
    border-radius: 4px;
    padding: 6px 16px;
}

QPushButton#rsRunButton:hover,
QPushButton#m_runButton:hover {
    background-color: #095C42;
}

QPushButton#rsRunButton:disabled,
QPushButton#m_runButton:disabled {
    background-color: #C5CDD6;
    border-color: #A8B1BC;
    color: #5A6573;
}

/* ============ Tables / Headers (global) ============ */
QTableView, QTableWidget {
    background: #ffffff;
    border: 1px solid #E2E6EB;
    border-radius: 4px;
    gridline-color: #EEF1F4;
    selection-background-color: rgba(11, 110, 79, 0.12);
    selection-color: #095C42;
    alternate-background-color: rgba(20, 23, 28, 0.02);
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F8FAFB, stop:1 #EEF1F4);
    color: #5A6573;
    border: none;
    border-right: 1px solid #E2E6EB;
    border-bottom: 1px solid #C5CDD6;
    padding: 5px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* ============ Form labels ============ */
QFormLayout QLabel, QLabel#rsFormLabel {
    color: #5A6573;
}

/* ============ Message / tooltip polish ============ */
QToolTip {
    background-color: #1C2430;
    color: #ffffff;
    border: 1px solid #1C2430;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 11px;
}

/* Help banners inside dialogs */
QFrame#rsGeorefParamsHelpBanner,
QFrame#rsDialogHelpBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #F0F7F4, stop:1 #f6f8fa);
    border: 1px solid #C5CDD6;
    border-radius: 6px;
}

QLabel#rsDialogHelpSummary {
    color: #1C2430;
    font-size: 12px;
}

QLabel#rsDialogStepBadge {
    color: #0B6E4F;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

/* Tool dialog sections (参数卡) */
QDialog#rsToolDialog {
    background-color: #F4F6F8;
}

QFrame#rsDialogSection,
QFrame#rsParamSection {
    background: #ffffff;
    border: 1px solid #E2E6EB;
    border-radius: 6px;
}

QLabel#rsDialogSectionTitle,
QLabel#rsParamSectionTitle {
    color: #1C2430;
    font-weight: 600;
    font-size: 12px;
    padding-bottom: 2px;
}

QLabel#rsDialogHint {
    color: #5A6573;
    font-size: 11px;
}

QPushButton#rsPrimaryButton {
    background-color: #0B6E4F;
    color: #ffffff;
    border: 1px solid #095C42;
    border-radius: 4px;
    font-weight: 600;
    padding: 6px 18px;
    min-height: 32px;
    min-width: 96px;
}

QPushButton#rsPrimaryButton:hover {
    background-color: #095C42;
}

QPushButton#rsPrimaryButton:disabled {
    background-color: #C5CDD6;
    border-color: #A8B1BC;
    color: #5A6573;
}

QPushButton#rsSecondaryButton,
QPushButton#rsDialogHelpBtn,
QPushButton#rsDialogHelpButton,
QPushButton#rsDialogCancelBtn,
QPushButton#rsDialogBrowseBtn {
    background-color: #ffffff;
    border: 1px solid #C5CDD6;
    border-radius: 4px;
    color: #1C2430;
    padding: 5px 12px;
    min-height: 30px;
}

QPushButton#rsSecondaryButton:hover,
QPushButton#rsDialogHelpBtn:hover,
QPushButton#rsDialogHelpButton:hover,
QPushButton#rsDialogCancelBtn:hover,
QPushButton#rsDialogBrowseBtn:hover {
    background-color: #EEF1F4;
    border-color: #A8B1BC;
}

QLineEdit#rsDialogOutputEdit {
    min-height: 28px;
    padding: 4px 8px;
}

/* Classifier setup bar */
QWidget#rsClassifierSetupBar {
    background: #ffffff;
    border-top: 1px solid #E2E6EB;
}

QToolButton#rsClassifierSetupBar QToolButton,
QWidget#rsClassifierSetupBar QToolButton {
    border: 1px solid #C5CDD6;
    border-radius: 4px;
    padding: 4px 10px;
    background: #ffffff;
    min-height: 26px;
}

QWidget#rsClassifierSetupBar QToolButton:checked {
    background: rgba(11, 110, 79, 0.12);
    border: 1px solid rgba(11, 110, 79, 0.45);
    color: #095C42;
    font-weight: 600;
}

QWidget#rsClassifierSetupBar QToolButton:disabled {
    color: #8A93A0;
    background: #F4F6F8;
}

QPushButton#rsClassifierBtnApply {
    background-color: #0B6E4F;
    color: #ffffff;
    border: 1px solid #095C42;
    border-radius: 4px;
    font-weight: 600;
    padding: 6px 14px;
    min-height: 30px;
}

QPushButton#rsClassifierBtnApply:hover {
    background-color: #095C42;
}

QPushButton#rsClassifierBtnPreview,
QPushButton#rsClassifierBtnCv {
    background: #ffffff;
    border: 1px solid #C5CDD6;
    border-radius: 4px;
    min-height: 30px;
    padding: 5px 12px;
}

/* Algorithm dialog */
QGroupBox#rsAlgCommandPreviewGroup {
    background: #F8FAFB;
    border: 1px solid #E2E6EB;
    border-radius: 6px;
    margin-top: 10px;
    font-weight: 600;
}

/* Status bar segments */
QStatusBar QLabel {
    padding: 0 8px;
    color: #5A6573;
}

QLabel#rsReadyLabel {
    color: #0B6E4F;
    font-weight: 600;
}

QLabel#rsReadyBusy {
    color: #8C5B00;
    font-weight: 600;
}

/* ============ Task panel ============ */
#rsTaskPanel {
  background: #ffffff;
  border-left: 1px solid #E2E6EB;
}
#rsTaskPanelTitle {
  font-size: 14px;
  font-weight: 600;
  color: #1C2430;
}
#rsTaskPanelSectionLabel {
  color: #5A6573;
  font-size: 11px;
  margin-top: 8px;
}
QPushButton#rsTaskPanelRun[primary="true"] {
  background-color: #0B6E4F;
  color: #ffffff;
  border: none;
}
QPushButton#rsTaskPanelRun[primary="true"]:hover {
  background-color: #095C42;
}
QPushButton#rsTaskPanelRun:disabled,
QPushButton#rsTaskPanelRun[primary="true"]:disabled {
  background-color: #C5CDD6;
  border: none;
  color: #5A6573;
}
#rsTaskPanelHint {
  color: #5A6573;
  font-size: 11px;
}
#rsTaskPanelHint[error="true"] {
  color: #C9372C;
}



/* ============ Band Composition Rail (signature chrome) ============ */
#rsBandCompositionRail {
    background: #EEF1F4;
    border: none;
    border-bottom: 1px solid #E2E6EB;
    min-height: 26px;
    max-height: 28px;
}
#rsBandCompositionRail QLabel {
    color: #5A6573;
    font-size: 11px;
    padding: 0 4px;
}
#rsBandChip {
    border-radius: 3px;
    min-width: 22px;
    max-width: 36px;
    min-height: 16px;
    max-height: 16px;
    font-size: 10px;
    font-weight: 700;
    color: #FFFFFF;
    qproperty-alignment: AlignCenter;
}
#rsBandChip[role="R"] { background: #C9372C; }
#rsBandChip[role="G"] { background: #2F9E44; }
#rsBandChip[role="B"] { background: #1B6CA8; }
#rsBandChip[role="NIR"] { background: #8B3A3A; }
#rsBandChip[role="Gray"] { background: #5A6573; }
#rsBandRangeLabel {
    font-family: 'IBM Plex Mono', 'SF Mono', monospace;
    font-size: 11px;
    color: #1C2430;
}
#rsBandMetaLabel {
    font-family: 'IBM Plex Mono', 'SF Mono', monospace;
    font-size: 11px;
    color: #5A6573;
}
#rsBandTaskPill {
    background: rgba(11, 110, 79, 0.10);
    border: 1px solid rgba(11, 110, 79, 0.35);
    border-radius: 10px;
    color: #0B6E4F;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 10px;
}
#rsBandTaskPill[idle="true"] {
    background: transparent;
    border: 1px solid #C5CDD6;
    color: #5A6573;
    font-weight: 400;
}

/* ============ Histogram instrument window ============ */
#rsHistogramChart {
    background: #1C1F24;
    border: 1px solid #C5CDD6;
    border-radius: 4px;
}
#rsHistogramStretchRoot QLabel {
    color: #5A6573;
}
#rsHistogramStretchRoot QPushButton[primary="true"] {
    background-color: #0B6E4F;
    color: #FFFFFF;
    border: 1px solid #095C42;
    font-weight: 600;
}

/* ============ Task Center (rsJobPanelDock) ============ */
#rsJobPanelDock {
    background-color: #FFFFFF;
}

#rsJobPanelHint {
    color: #5A6573;
    font-size: 11px;
    padding: 2px 0px;
}

#rsJobPanelDock QTreeWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 4px;
}

#rsJobPanelDock QTreeWidget::item {
    min-height: 24px;
    padding: 2px 4px;
}

#rsJobDetailTabs::pane {
    background-color: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 4px;
}

#rsJobDetailView, #rsJobLogView {
    background-color: #F8FAFB;
    border: 1px solid #E2E6EB;
    border-radius: 4px;
    font-family: 'IBM Plex Mono', 'SF Mono', 'Cascadia Code', 'Consolas', monospace;
    font-size: 12px;
    padding: 4px;
}

#rsJobDetailView:focus, #rsJobLogView:focus {
    border: 1px solid #0B6E4F;
}

/* Empty-state hint */
QLabel#rsEmptyHint {
    color: #5A6573;
    font-size: 13px;
    padding: 24px;
}

/* Map selection accent (distinct from interactive green) */
QTreeView::item:selected, QTreeWidget::item:selected, QListView::item:selected {
    background-color: rgba(11, 110, 79, 0.10);
    color: #0B6E4F;
    border-left: 2px solid #0B6E4F;
}

#rsBandRailHost {
    background: #EEF1F4;
    border: none;
    border-bottom: 1px solid #E2E6EB;
    spacing: 0;
    padding: 0;
}
#rsBandRailHost::separator { width: 0; background: transparent; }

/* Top chrome: ribbon + full-width band rail (pinned top dock, full window width) */
#rsTopChrome {
    background: #FFFFFF;
    border: none;
}
#rsRibbonDock {
    border: none;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    padding: 0;
    margin: 0;
    /* Base chrome 154 (ribbon only) + up to 2 toolbar rows (32px each) */
    min-height: 154px;
    max-height: 218px;
}
#rsRibbonDock > QWidget {
    border: none;
    padding: 0;
    margin: 0;
}
#rsTopChrome {
    min-height: 154px;
    max-height: 218px;
    background: #FFFFFF;
}
/* Product toolbars under ribbon — content-width bars (not full-window stretch).
   Override global QToolBar { min-height: 38px } so a 32px strip row can paint icons. */
#rsToolbarStrip {
    background: #FFFFFF;
    border-top: 1px solid #E2E6EB;
}
#rsToolbarStrip QToolBar,
#rsToolbarRow QToolBar {
    background: #FFFFFF;
    border: none;
    border-bottom: none;
    min-height: 32px;
    max-height: 32px;
    padding: 1px 4px;
    spacing: 2px;
}
#rsToolbarStrip QToolButton,
#rsToolbarRow QToolButton {
    min-height: 24px;
    max-height: 28px;
    min-width: 24px;
    padding: 2px;
    icon-size: 18px;
}
/* Adaptive flow toolbars under ribbon */
#rsToolbarFlowHost {
    background: #FFFFFF;
}
#rsToolbarChip {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 4px;
}
#rsToolbarDragGrip {
    background: #EEF1F4;
    border-right: 1px solid #E2E6EB;
}
#rsToolbarDragGrip:hover {
    background: #0B6E4F;
}
#rsToolbarResizeGrip {
    background: #E2E6EB;
    border-left: 1px solid #C5CDD6;
}
#rsToolbarResizeGrip:hover {
    background: #0B6E4F;
}
#rsRibbonHost {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E2E6EB;
    spacing: 0;
    padding: 0;
}

/* Ribbon sliders */
#rsRibbonSliderBox { background: transparent; }
#rsRibbonSliderTitle {
    color: #5A6573;
    font-size: 10px;
}
#rsRibbonSliderValue {
    color: #1C2430;
    font-family: 'IBM Plex Mono', 'SF Mono', monospace;
    font-size: 10px;
}
#rsRibbonSlider {
    min-height: 16px;
    max-height: 18px;
}
#rsRibbonSlider::groove:horizontal {
    height: 4px;
    background: #E2E6EB;
    border-radius: 2px;
}
#rsRibbonSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    background: #0B6E4F;
    border-radius: 6px;
    border: 1px solid #095C42;
}
#rsRibbonSlider::sub-page:horizontal {
    background: #0B6E4F;
    border-radius: 2px;
}
#rsRibbonSystemMenu {
    color: #0B6E4F;
    font-weight: 700;
    font-size: 11px;
    padding: 2px 8px;
    border: 1px solid transparent;
    border-radius: 4px;
}
#rsRibbonSystemMenu:hover {
    background: rgba(11, 110, 79, 0.10);
    border: 1px solid rgba(11, 110, 79, 0.35);
}
#rsRibbonSystemMenu::menu-indicator { image: none; width: 0; }

/* ============ ArcGIS Pro–style ribbon ============ */
#rsRibbonBar {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E2E6EB;
    min-height: 126px;
}
#rsRibbonQat {
    background: #F4F6F8;
    border-bottom: 1px solid #E2E6EB;
}
#rsRibbonQatBrand {
    color: #5A6573;
    font-size: 11px;
    font-weight: 600;
    padding: 0 10px;
}
#rsRibbonQatBtn {
    border: 1px solid transparent;
    border-radius: 3px;
    background: transparent;
}
#rsRibbonQatBtn:hover {
    background: rgba(11, 110, 79, 0.10);
    border: 1px solid rgba(11, 110, 79, 0.25);
}
#rsRibbonQatBtn:focus {
    border: 1px solid #0B6E4F;
}
#rsRibbonQatBtn:disabled {
    color: #8A93A0;
}
#rsRibbonQatSep {
    background: #C5CDD6;
    margin: 0 6px;
}
#rsRibbonTabRow {
    background: #FFFFFF;
    border-bottom: 1px solid #E2E6EB;
}
QPushButton#rsRibbonTabButton {
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    color: #5A6573;
    font-size: 12px;
    padding: 4px 14px;
    margin: 0 1px;
}
QPushButton#rsRibbonTabButton:hover {
    color: #1C2430;
    background: #F4F6F8;
}
QPushButton#rsRibbonTabButton:focus {
    border-bottom: 3px solid #0B6E4F;
    color: #0B6E4F;
}
QPushButton#rsRibbonTabButton:checked {
    color: #0B6E4F;
    font-weight: 700;
    border-bottom: 3px solid #0B6E4F;
    background: #FFFFFF;
}
QPushButton#rsRibbonTabButton:disabled {
    color: #8A93A0;
}
#rsRibbonCollapseBtn {
    border: 1px solid transparent;
    border-radius: 3px;
    background: transparent;
    color: #5A6573;
    padding: 2px 4px;
    margin: 2px 6px;
}
#rsRibbonCollapseBtn:hover {
    background: rgba(11, 110, 79, 0.10);
    border: 1px solid rgba(11, 110, 79, 0.25);
    color: #1C2430;
}
#rsRibbonCollapseBtn:focus {
    border: 1px solid #0B6E4F;
}
#rsRibbonCollapseBtn:disabled {
    color: #8A93A0;
}
#rsRibbonStack, #rsRibbonPageScroll, #rsRibbonPage {
    background: #FAFBFC;
    border: none;
}
#rsRibbonGroup {
    background: transparent;
    min-width: 64px;
}
#rsRibbonGroupTitle {
    color: #8A93A0;
    font-size: 10px;
    padding: 1px 4px 2px;
    border-top: 1px solid #E2E6EB;
}
#rsRibbonGroupSep {
    background: #E2E6EB;
    margin: 6px 4px;
}
#rsRibbonLargeBtn {
    color: #1C2430;
    font-size: 11px;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px 4px;
    background: transparent;
}
#rsRibbonLargeBtn:hover {
    background: rgba(11, 110, 79, 0.08);
    border: 1px solid rgba(11, 110, 79, 0.30);
}
#rsRibbonLargeBtn:pressed, #rsRibbonLargeBtn:checked {
    background: rgba(11, 110, 79, 0.14);
    border: 1px solid rgba(11, 110, 79, 0.45);
    color: #0B6E4F;
}
#rsRibbonLargeBtn:focus {
    border: 1px solid #0B6E4F;
}
#rsRibbonLargeBtn:disabled {
    color: #8A93A0;
    background: transparent;
    border-color: transparent;
}
/* Status bar session meta */
#rsStatusMetaLabel, #rsLayerStatusLabel {
    color: #5A6573;
    font-size: 11px;
    padding: 0 2px;
}
#rsLayerStatusLabel {
    color: #1C2430;
    font-weight: 500;
}
#rsStatusOpacitySlider {
    min-height: 14px;
    max-height: 16px;
}
#rsStatusOpacitySlider::groove:horizontal {
    height: 4px;
    background: #E2E6EB;
    border-radius: 2px;
}
#rsStatusOpacitySlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    background: #0B6E4F;
    border-radius: 6px;
}
#rsStatusOpacitySlider::sub-page:horizontal {
    background: #0B6E4F;
    border-radius: 2px;
}

/* Algorithm dialog parameter form */
#rsAlgParamForm {
    background: transparent;
}
#rsAlgFieldLabel {
    color: #5A6573;
    font-size: 12px;
    font-weight: 500;
}
#rsAlgFieldBlock {
    background: transparent;
}
#rsAlgCommandPreviewGroup {
    margin-top: 4px;
}
#rsAlgCommandPreview {
    background: #F4F6F8;
    border: 1px solid #E2E6EB;
    border-radius: 4px;
    font-size: 11px;
    color: #1C2430;
}
#rsAlgParamScroll {
    border: none;
    background: transparent;
}

/* Ribbon combobox (band pickers, modes, …) */
#rsRibbonComboBox {
    background: transparent;
}
#rsRibbonComboTitle {
    color: #5A6573;
    font-size: 10px;
}
QComboBox#rsRibbonCombo {
    background: #FFFFFF;
    border: 1px solid #C5CDD6;
    border-radius: 3px;
    padding: 2px 6px;
    min-height: 22px;
    color: #1C2430;
    font-size: 11px;
}
QComboBox#rsRibbonCombo:hover {
    border: 1px solid rgba(11, 110, 79, 0.55);
}
QComboBox#rsRibbonCombo:focus {
    border: 1px solid #0B6E4F;
}
QComboBox#rsRibbonCombo:disabled {
    color: #8A93A0;
    background: #F4F6F8;
}
QComboBox#rsRibbonCombo::drop-down {
    border: none;
    width: 18px;
}
QComboBox#rsRibbonCombo QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #C5CDD6;
    selection-background-color: rgba(11, 110, 79, 0.12);
    selection-color: #0B6E4F;
    outline: none;
}

#rsRibbonPageScroll QScrollBar:horizontal {
    height: 6px;
    background: transparent;
}
#rsRibbonPageScroll QScrollBar::handle:horizontal {
    background: #C5CDD6;
    border-radius: 3px;
    min-width: 24px;
}
#rsRibbonPageScroll QScrollBar::handle:horizontal:hover {
    background: #A8B1BC;
}

/* ============ Empty State Widget ============ */
sicnu--RsEmptyStateWidget, #RsEmptyStateWidget {
    background-color: transparent;
}
#rsEmptyStateTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1C2430;
}
#rsEmptyStateDesc {
    font-size: 12px;
    color: #5A6573;
}

/* ============ Pipeline Editor Dock ============ */
#rsPipelineToolBar {
    background-color: #F8FAFB;
    border-bottom: 1px solid #E2E6EB;
    padding: 2px;
}
#rsPipelineToolBar QToolButton {
    color: #1C2430;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 3px;
    border: 1px solid transparent;
}
#rsPipelineToolBar QToolButton:hover {
    background-color: #E2E6EB;
    border: 1px solid #C5CDD6;
}

/* ============ Preset Catalog ============ */
#rsPresetHeader {
    font-weight: bold;
    font-size: 13px;
    color: #0B6E4F;
}
#rsPresetList {
    background-color: #FFFFFF;
    color: #1C2430;
    border: 1px solid #C5CDD6;
    border-radius: 4px;
}
#rsPresetList::item {
    padding: 8px;
    border-bottom: 1px solid #E2E6EB;
}
#rsPresetList::item:selected {
    background-color: rgba(11, 110, 79, 0.12);
    color: #0B6E4F;
}
#rsPresetDesc {
    color: #5A6573;
    font-size: 11px;
    padding: 6px;
    background: #F4F6F8;
    border: 1px solid #E2E6EB;
    border-radius: 4px;
}

/* ============ Copilot & Run Inspector ============ */
#runInspectorContainer {
    background-color: #F8FAFB;
    border: 1px solid #E2E6EB;
    border-radius: 6px;
    padding: 4px;
}
#userBubble {
    background-color: #E6F4EE;
    color: #1C2430;
    border: 1px solid #B8E2D1;
    border-radius: 6px;
    padding: 6px;
}
#agentBubble {
    background-color: #F4F6F8;
    color: #1C2430;
    border: 1px solid #E2E6EB;
    border-radius: 6px;
    padding: 6px;
}
#agentReasoning {
    color: #5A6573;
    font-style: italic;
}
#toolCallCard {
    background-color: #F8FAFB;
    border: 1px solid #0B6E4F;
    border-radius: 6px;
    padding: 6px;
}
#planApprovalCard {
    background-color: #F8FAFB;
    border: 1px solid #0B6E4F;
    border-radius: 6px;
    padding: 8px;
}

/* ============ Secondary Map View Header ============ */
#rsSecondaryMapViewHeader {
    background: #F4F5F7;
    border-bottom: 1px solid #E2E6EB;
}
#rsSecondaryMapViewHeader[active="true"] {
    background: #E6F4EE;
    border-bottom: 1px solid #0B6E4F;
}

