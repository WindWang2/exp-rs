# ExpRSConfig.cmake — package configuration for find_package(ExpRS)
#
# Provides:
#   ExpRS::SDK            plugin-facing API (headers + operator contract +
#                         jsoncpp + operator link leaf). Link this from
#                         plugin targets.
#   ExpRS::sicnu_sdk      host-side plugin infrastructure archive (rarely
#                         needed by third parties).
#
# Consumes:
#   EXP_RS_SDK_ROOT (optional) — install prefix used when the package was
#   located outside its prefix (advanced; normally unnecessary).

@PACKAGE_INIT@

include( CMakeFindDependencyMacro )

# Reproduce the host build's jsoncpp canonicalization: the exported targets
# reference a plain `jsoncpp` target, which we materialize here from
# whatever the platform provides. No hard find_dependency: the fallback
# below locates the system library without a CMake config package.
if ( NOT TARGET jsoncpp )
  find_package( jsoncpp QUIET )
  if ( TARGET JsonCpp::JsonCpp )
    add_library( jsoncpp INTERFACE IMPORTED )
    set_target_properties( jsoncpp PROPERTIES INTERFACE_LINK_LIBRARIES JsonCpp::JsonCpp )
  elseif ( TARGET jsoncpp_lib )
    add_library( jsoncpp INTERFACE IMPORTED )
    set_target_properties( jsoncpp PROPERTIES INTERFACE_LINK_LIBRARIES jsoncpp_lib )
  elseif ( TARGET jsoncpp_static )
    add_library( jsoncpp INTERFACE IMPORTED )
    set_target_properties( jsoncpp PROPERTIES INTERFACE_LINK_LIBRARIES jsoncpp_static )
  else()
    # Last resort: system lib + standard include dir.
    find_path( JSONCPP_INCLUDE_DIR json/json.h PATH_SUFFIXES jsoncpp )
    find_library( JSONCPP_LIBRARY NAMES jsoncpp )
    if ( JSONCPP_INCLUDE_DIR AND JSONCPP_LIBRARY )
      add_library( jsoncpp INTERFACE IMPORTED )
      set_target_properties( jsoncpp PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${JSONCPP_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "${JSONCPP_LIBRARY}" )
    else()
      set( ExpRS_jsoncpp_NOT_FOUND TRUE )
    endif()
  endif()
endif()

if ( ExpRS_jsoncpp_NOT_FOUND )
  set( ${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
    "jsoncpp (the operator JSON type) was not found on this system" )
  set( ${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE )
  return()
endif()

include( "${CMAKE_CURRENT_LIST_DIR}/ExpRSTargets.cmake" )

# Friendly umbrella alias: ExpRS::SDK == ExpRS::exprs_sdk (the plugin-facing
# API target). Plugins link ExpRS::SDK.
if ( NOT TARGET ExpRS::SDK )
  add_library( ExpRS::SDK ALIAS ExpRS::exprs_sdk )
endif()

# Version compatibility surface the plugin build should embed in its
# manifest (abi_version / api_version). Available after find_package(ExpRS):
set( ExpRS_PLUGIN_API_VERSION "@EXP_RS_PLUGIN_API_VERSION@" )
set( ExpRS_PLUGIN_ABI_VERSION "@EXP_RS_PLUGIN_ABI_VERSION@" )

check_required_components( ExpRS )
