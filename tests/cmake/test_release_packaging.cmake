cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${TEST_DIR}/source")
file(WRITE "${TEST_DIR}/source/README.md" "Packaging fixture\n")
file(WRITE "${TEST_DIR}/source/payload.txt" "installed payload\n")
file(WRITE "${TEST_DIR}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(PackagingFixture NONE)
set(COMPLETE_VERSION "9.8.7")
install(FILES "${CMAKE_SOURCE_DIR}/payload.txt" DESTINATION bin)
include("${PACKAGE_MODULE}")
]=])

function(run_checked)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Packaging command failed (${result}): ${ARGV}\n${output}\n${error}")
  endif()
endfunction()

# Exercise the module's platform default and an explicit generator override.
foreach(mode IN ITEMS default override)
  set(extra_args "")
  if(mode STREQUAL "override")
    set(extra_args "-DCPACK_GENERATOR=ZIP")
  endif()
  set(build_dir "${TEST_DIR}/${mode}")
  run_checked("${CMAKE_COMMAND}" -S "${TEST_DIR}/source" -B "${build_dir}"
    "-DPACKAGE_MODULE=${PACKAGE_MODULE}" ${extra_args})
  run_checked("${CMAKE_COMMAND}" --build "${build_dir}" --target package --config Release -j2)
  if(WIN32 OR mode STREQUAL "override")
    set(extension zip)
  else()
    set(extension tar.gz)
  endif()
  file(GLOB archives "${build_dir}/sicnu-geo-rs-9.8.7-*.${extension}")
  list(LENGTH archives archive_count)
  if(NOT archive_count EQUAL 1)
    message(FATAL_ERROR "Expected one ${extension} archive, found: ${archives}")
  endif()
  list(GET archives 0 archive)
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${build_dir}/unpacked")
  file(GLOB payloads "${build_dir}/unpacked/*/bin/payload.txt")
  list(LENGTH payloads payload_count)
  if(NOT payload_count EQUAL 1)
    message(FATAL_ERROR "The archive is missing the installed payload")
  endif()
  list(GET payloads 0 payload)
  file(READ "${payload}" content)
  if(NOT content STREQUAL "installed payload\n")
    message(FATAL_ERROR "Installed payload changed inside the archive")
  endif()
endforeach()
message(STATUS "CPack default and override archives contain the installed payload")
