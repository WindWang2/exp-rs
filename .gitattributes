# Vendored libraries — exclude from language statistics
itk_ref/ linguist-vendored
otb_ref/ linguist-vendored

# Prevent line-ending conversion in vendored sources (avoids massive diffs)
itk_ref/** -text
otb_ref/** -text

# D7: batch scripts must keep CRLF - cmd.exe label seek misbehaves on LF-only
# files (scripts using goto/call :label). PowerShell handles both, but keep
# the pair uniform for editors on Windows.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Runtime recipes and audited patch hashes must survive Windows checkouts.
data/python/*/requirements.lock text eol=lf
vendor/pi/** text=auto eol=lf
vendor/node/*.json text eol=lf
pi/product-runtime/** text eol=lf

# Generators byte-compare these published references with their LF output.
data/contracts/*.snap.json text eol=lf
docs/generated/help/*.md text eol=lf
pi/knowledge/capability-*.md text eol=lf

# Keep repository control files stable; patch context is verbatim upstream data.
.gitattributes text eol=lf
.gitignore text eol=lf
vendor/pi/patches/*.patch -whitespace
