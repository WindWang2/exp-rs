{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-default",
      "displayName": "Developer Default Debug",
      "description": "Standard debug build with tests enabled",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TESTS": "ON",
        "ENABLE_LOCAL_BUILD_SHORTCUTS": "ON"
      }
    },
    {
      "name": "offline-lab",
      "displayName": "Offline Teaching-Lab Profile",
      "description": "Teaching-lab profile (cmake/SicnuLabProfile.cmake): no vendored OTB/ITK, no ONNX provider, no vendored GDAL, no embedded Python, no pybind11 fetch, no verification suite. Configures and builds with zero network egress; the shipped operator set is unchanged.",
      "binaryDir": "${sourceDir}/build-lab",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SICNU_LAB_PROFILE": "ON",
        "ENABLE_LOCAL_BUILD_SHORTCUTS": "ON"
      }
    },
    {
      "name": "ci-fast",
      "displayName": "CI Fast Required Lane",
      "description": "Fast release build for pull request verification",
      "binaryDir": "${sourceDir}/build-ci-fast",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_TESTS": "ON",
        "ENABLE_LOCAL_BUILD_SHORTCUTS": "ON"
      }
    },
    {
      "name": "ci-full",
      "displayName": "CI Full Linux Integration Lane",
      "description": "Full Linux integration build with OTB and Python worker support",
      "binaryDir": "${sourceDir}/build-ci-full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_TESTS": "ON",
        "SICNU_BUILD_OTB": "ON",
        "SICNU_EMBED_PYTHON": "ON"
      }
    },
    {
      "name": "sanitizer-debug",
      "displayName": "Sanitizer Instrumented Build",
      "description": "Debug build with ASan and UBSan enabled",
      "binaryDir": "${sourceDir}/build-sanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TESTS": "ON",
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "release-package",
      "displayName": "Release Package Build",
      "description": "Optimized release build with LTO and installation support",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_TESTS": "OFF",
        "ENABLE_LTO": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-default",
      "configurePreset": "dev-default",
      "jobs": 1
    },
    {
      "name": "offline-lab",
      "configurePreset": "offline-lab",
      "jobs": 1
    },
    {
      "name": "ci-fast",
      "configurePreset": "ci-fast",
      "jobs": 2
    },
    {
      "name": "ci-full",
      "configurePreset": "ci-full",
      "jobs": 2
    },
    {
      "name": "sanitizer-debug",
      "configurePreset": "sanitizer-debug",
      "jobs": 1
    },
    {
      "name": "release-package",
      "configurePreset": "release-package",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "dev-default",
      "configurePreset": "dev-default",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "CTEST_PARALLEL_LEVEL": "1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-fast",
      "configurePreset": "ci-fast",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "CTEST_PARALLEL_LEVEL": "1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-full",
      "configurePreset": "ci-full",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "CTEST_PARALLEL_LEVEL": "1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizer-debug",
      "configurePreset": "sanitizer-debug",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "CTEST_PARALLEL_LEVEL": "1"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
