   "/home/kevin/projects/rs-studio/exp-rs-developer-platform-3/examples/plugins/external-tools-demo" : {
      "manifest" : {
         "abi_version" : 1,
         "api_version" : "3.0",
         "capabilities" : [ "external_tools", "operator" ],
         "description" : "Pure-manifest plugin: wraps a command-line tool as an operator without shipping compiled code. demo:wordcount counts words/lines of a text file via the bundled script (python3).",
         "entrypoint_kind" : "manifest",
         "id" : "org.example.external-tools",
         "license" : "BSD-2-Clause",
         "manifest_version" : 1,
         "name" : "Demo External Tool Plugin",
         "operators" : [
            {
               "description" : "Counts lines/words/bytes of the 'input' text file using the bundled python script (external process, argv-only spawn).",
               "determinism_grade" : "bit_exact",
               "display_name" : "Demo Word Count",
               "external" : {
                  "argv" : [ "python3", "${plugin_dir}/resources/wordcount.py", "${input}" ],
                  "inherit_environment" : false,
                  "stderr_limit_bytes" : 1048576,
                  "stdout_limit_bytes" : 65536,
                  "timeout_seconds" : 120
               },
               "group" : "demo",
               "id" : "demo:wordcount",
               "inputs" : [
                  {
                     "description" : "Path of the text file to inspect",
                     "name" : "input",
                     "required" : true,
                     "type" : "string"
                  }
               ],
               "memory_policy" : "external_process",
               "outputs" : [],
               "supports_cancel" : true
            }
         ],
         "permissions" : [ "external_process", "filesystem_read" ],
         "vendor" : "ExpRS Examples",
         "version" : "1.0.0"
      },
      "mtime" : 1788559006
