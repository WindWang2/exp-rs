# Python
__pycache__/
*.pyc
.pytest_cache/

# Build trees (all out-of-source variants)
build/
build-*/
cmake-build/
cmake-build*/
Testing/
# CMake may emit this under a build tree; do not ignore a root copy if tracked intentionally
**/CTestCustom.cmake

# Shared objects / logs / runtime DB
*.so
*.a
*.log
symbology-style.db
*.aux.xml
compile_commands.json

# Compiler artifacts must never return to the tree (PR #831 leaked ~5 MB of
# MSVC .obj/.pdb to the repo root). Wavefront OBJ models, if ever needed,
# would require an explicit negation here.
*.obj
*.pdb

# Screenshots / local images at root (assets live under images/ or docs/)
/*.png

# Local large rasters under data/; re-include tracked configs only.
# Sample rasters/vectors (data/samples/, sample_crops.tif, test_vectors.geojson)
# are intentionally NOT tracked — tests synthesise fixtures at runtime instead.
data/*
!data/processing/
!data/processing/**
!data/tools/
!data/tools/**
!data/schemas/
!data/schemas/**
!data/help/
!data/help/**
# Cartographic component/template library and the spatial-scientist benchmark
# task set are tracked config, not local rasters.
!data/cartography/
!data/cartography/**
!data/benchmarks/
!data/benchmarks/**
!data/pipelines/
!data/pipelines/**
# Lab grading rules are tracked metadata (D4), not local rasters.
# LabSpec lab definitions are small tracked text: the single source of truth
# for guided workflows, generated docs and (D4/D7) auto-grading.
!data/labs/
!data/labs/**
# Lab step outputs (guided runs resolve outputs/... to /output/labs/<labId>/).
/output/
# CN satellite product metadata templates (band-role tables, field maps;
# ADR 0146) are tracked config — imagery itself never lands here.
!data/products/
!data/products/**
# Harness 4.0 scientific recipes are tracked metadata, not local data.
!data/agent/
!data/agent/**
# D3 lab content track: LabSpecs/pipelines/data-specs/grading intents are
# tracked config, not rasters. Generated fixtures stay untracked via the
# data/labs/_tmp/ rule at the end of this file (last match wins).
!data/labs/
!data/labs/**

# D6 unified RS glossary (terminology layer shared by i18n, help and the
# agent) is tracked config, not local raster data.
!data/terms/
!data/terms/**

# Qt translations: sicnu_zh_CN.ts is tracked; the compiled .qm is generated
# into the build tree by the sicnu_i18n target and never committed.
resources/translations/*.qm

# Built-in spectral library and material priors (D12) are tracked, redistributable data.
!data/spectral/
!data/spectral/**

# Test golden data always tracked
!tests/data/
!tests/data/**

# Reference trees (local / optional)
qgis_ref/
refs/
boost_ref/
.context/

# Upstream reference trees — large, locally rebuildable, never tracked.
# (Replaces the former per-subdirectory otb_ref/ allowlist; the whole tree
# is local-only now.)
itk_ref/
otb_ref/

# .agents/ holds transient agent workspaces (implementer briefings, progress notes) —
# not project source. Keep the project-level AGENTS.md config and skills.
.agents/*/
!.agents/skills/
!.agents/skills/**



# README showcase imagery (large GIFs/PNGs) — not needed for build/runtime.
images/README-md/

# Local optional dependency trees (GDAL/PROJ/GEOS/Boost unpacks — not source of truth)
vendor/

