# Python
__pycache__/
*.pyc
.pytest_cache/

# Build trees (all out-of-source variants)
build/
build-*/
cmake-build/
cmake-build*/
Testing/
# CMake may emit this under a build tree; do not ignore a root copy if tracked intentionally
**/CTestCustom.cmake

# Shared objects / logs / runtime DB
*.so
*.a
*.log
symbology-style.db
*.aux.xml
compile_commands.json

# Compiler artifacts must never return to the tree (PR #831 leaked ~5 MB of
# MSVC .obj/.pdb to the repo root). Wavefront OBJ models, if ever needed,
# would require an explicit negation here.
*.obj
*.pdb

# Screenshots / local images at root (assets live under images/ or docs/)
/*.png

# Local large rasters under data/; re-include tracked configs only.
# Sample rasters/vectors (data/samples/, sample_crops.tif, test_vectors.geojson)
# are intentionally NOT tracked — tests synthesise fixtures at runtime instead.
data/*
!data/processing/
!data/processing/**
!data/tools/
!data/tools/**
!data/schemas/
!data/schemas/**
!data/help/
!data/help/**
# Cartographic component/template library and the spatial-scientist benchmark
# task set are tracked config, not local rasters.
!data/cartography/
!data/cartography/**
!data/benchmarks/
!data/benchmarks/**
!data/pipelines/
!data/pipelines/**
# LabSpec lab definitions are small tracked text: the single source of truth
# for guided workflows, generated docs and (D4/D7) auto-grading.
!data/labs/
!data/labs/**
# Lab step outputs (guided runs resolve outputs/... to output/labs/<labId>/).
output/
# Harness 4.0 scientific recipes are tracked metadata, not local data.
!data/agent/
!data/agent/**

# Test golden data always tracked
!tests/data/
!tests/data/**

# Reference trees (local / optional)
qgis_ref/
refs/
boost_ref/
.context/

# Upstream reference trees — large, locally rebuildable, never tracked.
# (Replaces the former per-subdirectory otb_ref/ allowlist; the whole tree
# is local-only now.)
itk_ref/
otb_ref/

# .agents/ holds transient agent workspaces (implementer briefings, progress notes) —
# not project source. Keep the project-level AGENTS.md config and skills.
.agents/*/
!.agents/skills/
!.agents/skills/**



# README showcase imagery (large GIFs/PNGs) — not needed for build/runtime.
images/README-md/

# Local optional dependency trees (GDAL/PROJ/GEOS/Boost unpacks — not source of truth)
vendor/

# Superpowers / agent worktrees / local planning sessions
.worktrees/
.superpowers/
.gstack/
.planning/*
!.planning/unified-help-diagnostics-6/
!.planning/cartography-platform-7/
!.planning/dataset-experiment-7/
!.planning/geospatial-data-fabric-8/
!.planning/scientific-processing-8/
!.planning/scientific-algorithms-9/
!.planning/plugin-platform-8/
!.planning/verification-platform-8/
!.planning/spatial-scientist-harness-8/
!.planning/unified-contract-verification-9/
!.planning/model-runtime-multimodal-9/
!.planning/scientific-mlops-9/
!.planning/execution-concurrency-lifecycle-9/
!.planning/cartography-platform-9/
!.planning/professional-workbench-9/
!.planning/plugin-platform-9/
!.planning/geospatial-data-fabric-9/
.zcode/

# IDE / editor / OS artifacts
.vscode/
.idea/
.cache/
*.swp
*.swo
*~
.DS_Store
compile_flags.txt
.scratch/
user-history.db
vcpkg_installed/
run_sicnu_geo_rs.bat

# Agent-session planning artifacts (audit leftovers) must not be committed at the repo root.
# Root-anchored so data/benchmarks/ (tracked benchmark task sets) is unaffected.
/benchmarks/

# Re-ignore Python caches: the "!tests/data/**" negation above would otherwise
# un-ignore them again (last match wins).
__pycache__/
*.pyc

# Plugin discovery manifest index cache
.exprs-manifest-index.json

# Workspace Governance 3.0: per-project governance index (SQLite, regenerable)
*.governance.db
*.governance.db-*
*.governance.db.wal
*.governance.db.shm
