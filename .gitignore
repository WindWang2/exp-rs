# Python
__pycache__/
*.pyc
.pytest_cache/

# Build trees (all out-of-source variants)
build/
build-*/
cmake-build/
cmake-build*/
Testing/
# CMake may emit this under a build tree; do not ignore a root copy if tracked intentionally
**/CTestCustom.cmake

# Shared objects / logs / runtime DB
*.so
*.a
*.log
symbology-style.db
*.aux.xml
compile_commands.json

# Screenshots / local images at root (assets live under images/ or docs/)
/*.png

# Local large rasters under data/; re-include tracked configs only.
# Sample rasters/vectors (data/samples/, sample_crops.tif, test_vectors.geojson)
# are intentionally NOT tracked — tests synthesise fixtures at runtime instead.
data/*
!data/processing/
!data/processing/**
!data/tools/
!data/tools/**
!data/schemas/
!data/schemas/**
!data/pipelines/
!data/pipelines/**

# Test golden data always tracked
!tests/data/
!tests/data/**

# Reference trees (local / optional)
qgis_ref/
refs/
boost_ref/
.context/

# Upstream reference trees — large, locally rebuildable, never tracked.
# (Replaces the former per-subdirectory otb_ref/ allowlist; the whole tree
# is local-only now.)
itk_ref/
otb_ref/

# .agents/ holds transient agent workspaces (implementer briefings, progress notes) —
# not project source. Keep the project-level AGENTS.md config and skills.
.agents/*/
!.agents/skills/
!.agents/skills/**



# README showcase imagery (large GIFs/PNGs) — not needed for build/runtime.
images/README-md/

# Local optional dependency trees (GDAL/PROJ/GEOS/Boost unpacks — not source of truth)
vendor/

# Superpowers / agent worktrees / local planning sessions
.worktrees/
.superpowers/
.gstack/
.planning/
.zcode/

# IDE / editor / OS artifacts
.vscode/
.idea/
.cache/
*.swp
*.swo
*~
.DS_Store
compile_flags.txt
.scratch/
user-history.db
vcpkg_installed/
run_sicnu_geo_rs.bat

# Agent-session planning artifacts (audit leftovers) must not be committed at the repo root.
benchmarks/

# Re-ignore Python caches: the "!tests/data/**" negation above would otherwise
# un-ignore them again (last match wins).
__pycache__/
*.pyc
