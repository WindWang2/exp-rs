{
  "agent": {
    "name": "scripted-reference",
    "version": "1.0.0"
  },
  "case_id": "classification/ensemble-transient",
  "explanation": "Trained rf-7 and classified the scene; evidence classified-map holds accuracy 0.87.",
  "schema": "sicnu.agentbench.script/v1",
  "script_id": "ref/ensemble-transient",
  "seed": 7,
  "steps": [
    {
      "input": {
        "labels": "work://case/labels.gpkg"
      },
      "on_failure": "abort",
      "payload": {
        "model_id": "rf-7",
        "output_path": "work://case/model.json"
      },
      "tokens": 120,
      "tool": "rs:train_classifier"
    },
    {
      "input": {
        "model": "work://case/model.json"
      },
      "on_failure": "retry_once",
      "payload": {
        "fields": {
          "accuracy": 0.87,
          "classes": 5
        },
        "output_path": "work://case/classes.tif"
      },
      "tokens": 120,
      "tool": "rs:classify"
    },
    {
      "evidence": "classified-map",
      "input": {},
      "on_failure": "abort",
      "payload": {
        "fields": {
          "accuracy": 0.87
        },
        "output_path": "work://case/classes.tif",
        "verdict": "PASS"
      },
      "tokens": 120,
      "tool": "harness:verify"
    }
  ]
}
