[
  {
    "id": "family:filter",
    "kind": "family_default",
    "family": "filter",
    "modality": ["optical", "sar", "thermal", "dem"],
    "resource": { "cost_class": "light", "large_raster_safe": true },
    "side_effects": false,
    "verification": {
      "expected_kind": "raster",
      "checks": ["existence", "opens", "dimensions", "finite_fraction", "nodata_fraction"]
    },
    "limitations": [
      "Spatial filters mix neighbouring pixels — never feed filtered products into bi-temporal change science without recording the kernel",
      "NoData neighbourhoods shrink: filtered edges may carry different valid coverage than the input"
    ]
  },
  {
    "id": "rs:morphology",
    "family": "filter",
    "extends": "family:filter"
  },
  {
    "id": "rs:sieve",
    "family": "filter",
    "extends": "family:filter",
    "verification": {
      "expected_kind": "raster",
      "checks": ["existence", "opens", "dimensions", "class_domain"]
    },
    "limitations": ["Removes small polygonal classes; class domain may shrink by design"]
  },
  {
    "id": "rs:fill_holes",
    "family": "filter",
    "extends": "family:filter"
  },
  {
    "id": "rs:connected_components",
    "family": "filter",
    "extends": "family:filter",
    "artifacts": { "output": { "kind": "raster", "dtype": "int32" } },
    "limitations": ["Component labels are arbitrary integers, not science values"]
  },
  {
    "id": "rs:majority_filter",
    "family": "filter",
    "extends": "family:filter",
    "verification": {
      "expected_kind": "raster",
      "checks": ["existence", "opens", "dimensions", "class_domain"]
    },
    "limitations": ["Majority voting assumes categorical input; continuous rasters must not pass through"]
  },
  {
    "id": "rs:focal_stats",
    "family": "filter",
    "extends": "family:filter"
  },
  {
    "id": "rs:proximity",
    "family": "filter",
    "extends": "family:filter",
    "artifacts": { "output": { "kind": "raster", "dtype": "float32" } },
    "limitations": ["Distance units follow the raster CRS — geographic CRSs give degrees, not meters"]
  },
  {
    "id": "rs:local_extrema",
    "family": "filter",
    "extends": "family:filter"
  },
  {
    "id": "opencv:gaussian_blur",
    "family": "filter",
    "extends": "family:filter"
  },
  {
    "id": "opencv:mean_blur",
    "family": "filter",
    "extends": "family:filter"
  },
  {
    "id": "opencv:median_blur",
    "family": "filter",
    "extends": "family:filter",
    "limitations": [
      "Median filter preserves edges but is only defined for integer/cv_8u style buffers — float scenes round"
    ]
  },
  {
    "id": "opencv:sobel",
    "family": "filter",
    "extends": "family:filter",
    "artifacts": { "output": { "kind": "raster", "dtype": "float32" } }
  },
  {
    "id": "opencv:laplacian",
    "family": "filter",
    "extends": "family:filter",
    "artifacts": { "output": { "kind": "raster", "dtype": "float32" } }
  },
  {
    "id": "opencv:canny",
    "family": "filter",
    "extends": "family:filter",
    "artifacts": { "output": { "kind": "raster", "dtype": "uint8" } },
    "limitations": ["Edge map is binary; hysteresis thresholds are scene-dependent"]
  }
]
