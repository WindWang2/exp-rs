{
  "schema_version": "1.0",
  "kind": "harness_recipe",
  "recipe_id": "harness.temporal_classify_prep",
  "title": "Temporal feature stack for classification",
  "intent": "temporal",
  "family": "temporal",
  "modality": "temporal",
  "sensors": [
    "sentinel-2",
    "landsat-8",
    "landsat-9",
    "modis"
  ],
  "description": "Index series + harmonic fit assembled into a feature cube for classification consumers.",
  "slots": [
    {
      "name": "collection",
      "kind": "collection",
      "description": "Registered temporal collection (spatial:temporal tools).",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "series",
      "operator_id": "rs:temporal_index_series",
      "params": {
        "collection": "$collection.path",
        "index": "NDVI",
        "output": "$outputs.ndvi_series"
      },
      "verification": "raster"
    },
    {
      "id": "stack",
      "operator_id": "rs:feature_stack",
      "params": {
        "reference": "$collection.path",
        "output": "$outputs.feature_cube",
        "feature_id": "temporal_ndvi"
      },
      "verification": "raster"
    }
  ],
  "outputs": [
    {
      "name": "ndvi_series",
      "from_step": "series",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "feature_cube",
      "from_step": "stack",
      "port": "output",
      "kind": "raster"
    }
  ],
  "verification": {
    "enabled": true
  },
  "map_output": {
    "from_step": "series",
    "renderer_hint": "singleband_pseudocolor"
  },
  "capabilities": [
    "rs:temporal_index_series",
    "rs:feature_stack"
  ],
  "expected_artifacts": [
    {
      "name": "ndvi_series",
      "kind": "raster"
    },
    {
      "name": "feature_cube",
      "kind": "raster"
    }
  ]
}
