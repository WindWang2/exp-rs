{
  "schema_version": "1.0",
  "kind": "harness_recipe",
  "recipe_id": "harness.temporal_ndvi_phenology",
  "title": "Crop phenology metrics (NDVI series)",
  "intent": "phenology",
  "family": "temporal",
  "modality": "temporal",
  "sensors": [
    "sentinel-2",
    "landsat-8",
    "landsat-9",
    "modis"
  ],
  "description": "NDVI index series -> smoothing -> phenology metrics -> summary report. The canonical phenology chain.",
  "slots": [
    {
      "name": "collection",
      "kind": "collection",
      "description": "Registered temporal collection (spatial:temporal tools).",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "series",
      "operator_id": "rs:temporal_index_series",
      "params": {
        "collection": "$collection.path",
        "index": "NDVI",
        "output": "$outputs.ndvi_series"
      },
      "verification": "raster"
    },
    {
      "id": "smooth",
      "operator_id": "rs:temporal_smooth",
      "params": {
        "collection": "$collection.path",
        "band_role": "ndvi",
        "method": "savgol",
        "output": "$outputs.smoothed"
      },
      "verification": "raster"
    },
    {
      "id": "phenology",
      "operator_id": "rs:temporal_phenology",
      "params": {
        "collection": "$collection.path",
        "band_role": "ndvi",
        "output": "$outputs.phenology"
      },
      "verification": "raster"
    },
    {
      "id": "summary",
      "operator_id": "rs:temporal_summary",
      "params": {
        "collection": "$collection.path",
        "band_role": "ndvi",
        "include_median": true,
        "output": "$outputs.summary",
        "verification": "report"
      },
      "verification": "raster"
    }
  ],
  "outputs": [
    {
      "name": "ndvi_series",
      "from_step": "series",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "phenology",
      "from_step": "phenology",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "summary",
      "from_step": "summary",
      "port": "output",
      "kind": "report"
    }
  ],
  "verification": {
    "enabled": true
  },
  "map_output": {
    "from_step": "series",
    "renderer_hint": "singleband_pseudocolor"
  },
  "aliases": [
    "harness.temporal_ndvi_phenology_whittaker"
  ],
  "presets": {
    "whittaker": {
      "step_params": {
        "smooth": {
          "method": "whittaker"
        }
      }
    }
  },
  "capabilities": [
    "rs:temporal_index_series",
    "rs:temporal_smooth",
    "rs:temporal_phenology",
    "rs:temporal_summary"
  ],
  "expected_artifacts": [
    {
      "name": "ndvi_series",
      "kind": "raster"
    },
    {
      "name": "phenology",
      "kind": "raster"
    },
    {
      "name": "summary",
      "kind": "report"
    }
  ]
}
