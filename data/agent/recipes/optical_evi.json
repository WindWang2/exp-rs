{
  "schema_version": "1.0",
  "kind": "harness_recipe",
  "recipe_id": "harness.optical_evi",
  "title": "EVI enhanced vegetation index",
  "intent": "evi",
  "family": "optical-index",
  "modality": "optical",
  "sensors": [
    "sentinel-2",
    "landsat-8",
    "landsat-9"
  ],
  "description": "inspect -> optional QA mask -> EVI -> optional threshold class map. Orchestrates existing operators only; the evi preflight pack verifies the required band roles and radiometric state.",
  "slots": [
    {
      "name": "primary",
      "kind": "raster",
      "description": "Optical reflectance product with the bands required for EVI.",
      "required": true
    },
    {
      "name": "qa",
      "kind": "raster",
      "description": "Optional QA/cloud mask raster consumed by rs:qa_mask.",
      "required": false
    }
  ],
  "steps": [
    {
      "id": "mask",
      "operator_id": "rs:qa_mask",
      "params": {
        "input": "$qa.path",
        "output": "$outputs.mask"
      },
      "verification": "raster",
      "when_slot": "qa"
    },
    {
      "id": "index",
      "operator_id": "rs:spectral_index",
      "params": {
        "input": "$primary.path",
        "index": "EVI",
        "output": "$outputs.evi"
      },
      "verification": "raster"
    },
    {
      "id": "classify",
      "operator_id": "rs:threshold_raster",
      "params": {
        "input": "$outputs.evi",
        "output": "$outputs.classified",
        "thresholdMethod": "manual",
        "threshold": "$params.threshold",
        "cleanup": "open"
      },
      "verification": "raster",
      "when_param": "threshold",
      "params_when_skipped": {
        "input": "$outputs.evi",
        "output": "$outputs.classified",
        "thresholdMethod": "statistical",
        "statisticalK": 2.0,
        "cleanup": "open"
      }
    }
  ],
  "outputs": [
    {
      "name": "evi",
      "from_step": "index",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "classified",
      "from_step": "classify",
      "port": "output",
      "kind": "raster"
    }
  ],
  "verification": {
    "enabled": true
  },
  "map_output": {
    "from_step": "index",
    "renderer_hint": "categorized"
  },
  "aliases": [
    "harness.optical_evi_landsat"
  ],
  "presets": {
    "landsat": {
      "step_params": {
        "index": {
          "scale": 0.0001
        },
        "classify": {
          "cleanup": "majority"
        }
      }
    }
  },
  "capabilities": [
    "rs:qa_mask",
    "rs:spectral_index",
    "rs:threshold_raster"
  ],
  "expected_artifacts": [
    {
      "name": "evi",
      "kind": "raster"
    },
    {
      "name": "classified",
      "kind": "raster"
    }
  ]
}
