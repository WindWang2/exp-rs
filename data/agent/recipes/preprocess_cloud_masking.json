{
 "schema_version": "1.0",
 "kind": "harness_recipe",
 "recipe_id": "harness.preprocess_cloud_masking",
 "title": "Cloud/QA mask preparation",
 "intent": "qa",
 "family": "preprocessing",
 "modality": "optical",
 "sensors": [
  "sentinel-2",
  "landsat-8",
  "landsat-9"
 ],
 "description": "QA bit decoding -> mask raster -> applied mask producing a clean analysis product.",
 "slots": [
  {
   "name": "primary",
   "kind": "raster",
   "description": "Reflectance product.",
   "required": true
  },
  {
   "name": "qa",
   "kind": "raster",
   "description": "QA band product.",
   "required": true
  }
 ],
 "steps": [
  {
   "id": "mask",
   "operator_id": "rs:qa_mask",
   "params": {
    "input": "$qa.path",
    "output": "$outputs.mask",
    "bits": "$params.qa_bits"
   },
   "verification": "raster",
   "when_param": "qa_bits",
   "params_when_skipped": {
    "input": "$qa.path",
    "output": "$outputs.mask"
   }
  },
  {
   "id": "apply",
   "operator_id": "rs:apply_mask",
   "params": {
    "input": "$primary.path",
    "mask": "$outputs.mask",
    "output": "$outputs.masked",
    "align_mask": true
   },
   "verification": "raster"
  }
 ],
 "outputs": [
  {
   "name": "mask",
   "from_step": "mask",
   "port": "output",
   "kind": "raster"
  },
  {
   "name": "masked",
   "from_step": "apply",
   "port": "output",
   "kind": "raster"
  }
 ],
 "verification": {
  "enabled": true
 },
 "map_output": {
  "from_step": "mask",
  "renderer_hint": "singleband_pseudocolor"
 }
}