{
 "schema_version": "1.0",
 "kind": "harness_recipe",
 "recipe_id": "harness.temporal_urban_growth",
 "title": "Urban growth temporal series",
 "intent": "temporal",
 "family": "temporal",
 "modality": "temporal",
 "sensors": [
  "sentinel-2",
  "landsat-8",
  "landsat-9",
  "modis"
 ],
 "description": "NDBI series -> trend -> breakpoint confirmation of expansion events.",
 "slots": [
  {
   "name": "collection",
   "kind": "collection",
   "description": "Registered temporal collection (spatial:temporal tools).",
   "required": true
  }
 ],
 "steps": [
  {
   "id": "series",
   "operator_id": "rs:temporal_index_series",
   "params": {
    "collection": "$collection.path",
    "index": "NDBI",
    "output": "$outputs.ndbi_series"
   },
   "verification": "raster"
  },
  {
   "id": "trend",
   "operator_id": "rs:temporal_trend",
   "params": {
    "collection": "$collection.path",
    "band_role": "ndbi",
    "output": "$outputs.trend"
   },
   "verification": "raster"
  }
 ],
 "outputs": [
  {
   "name": "ndbi_series",
   "from_step": "series",
   "port": "output",
   "kind": "raster"
  },
  {
   "name": "trend",
   "from_step": "trend",
   "port": "output",
   "kind": "raster"
  }
 ],
 "verification": {
  "enabled": true
 },
 "map_output": {
  "from_step": "series",
  "renderer_hint": "singleband_pseudocolor"
 }
}