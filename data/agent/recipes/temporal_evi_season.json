{
  "schema_version": "1.0",
  "kind": "harness_recipe",
  "recipe_id": "harness.temporal_evi_season",
  "title": "Crop season EVI profile",
  "intent": "phenology",
  "family": "temporal",
  "modality": "temporal",
  "sensors": [
    "sentinel-2",
    "landsat-8",
    "landsat-9",
    "modis"
  ],
  "description": "EVI series with smoothing and phenology extraction — MODIS-friendly (EVI avoids soil background).",
  "slots": [
    {
      "name": "collection",
      "kind": "collection",
      "description": "Registered temporal collection (spatial:temporal tools).",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "series",
      "operator_id": "rs:temporal_index_series",
      "params": {
        "collection": "$collection.path",
        "index": "EVI",
        "output": "$outputs.evi_series"
      },
      "verification": "raster"
    },
    {
      "id": "smooth",
      "operator_id": "rs:temporal_smooth",
      "params": {
        "collection": "$collection.path",
        "band_role": "evi",
        "method": "savgol",
        "output": "$outputs.smoothed"
      },
      "verification": "raster"
    },
    {
      "id": "phenology",
      "operator_id": "rs:temporal_phenology",
      "params": {
        "collection": "$collection.path",
        "band_role": "evi",
        "output": "$outputs.phenology"
      },
      "verification": "raster"
    }
  ],
  "outputs": [
    {
      "name": "evi_series",
      "from_step": "series",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "phenology",
      "from_step": "phenology",
      "port": "output",
      "kind": "raster"
    }
  ],
  "verification": {
    "enabled": true
  },
  "map_output": {
    "from_step": "series",
    "renderer_hint": "singleband_pseudocolor"
  },
  "capabilities": [
    "rs:temporal_index_series",
    "rs:temporal_smooth",
    "rs:temporal_phenology"
  ],
  "expected_artifacts": [
    {
      "name": "evi_series",
      "kind": "raster"
    },
    {
      "name": "phenology",
      "kind": "raster"
    }
  ]
}
