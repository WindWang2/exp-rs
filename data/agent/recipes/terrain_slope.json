{
  "schema_version": "1.0",
  "kind": "harness_recipe",
  "recipe_id": "harness.terrain_slope",
  "title": "Slope product",
  "intent": "terrain",
  "family": "terrain",
  "modality": "terrain",
  "sensors": [
    "dem"
  ],
  "description": "Slope in degrees from a projected DEM; the terrain pack warns on geographic CRS.",
  "slots": [
    {
      "name": "primary",
      "kind": "raster",
      "description": "Hydrologically consistent DEM (projected CRS).",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "terrain",
      "operator_id": "rs:terrain_analysis",
      "params": {
        "input": "$primary.path",
        "output": "$outputs.slope",
        "product": "slope"
      },
      "verification": "raster"
    }
  ],
  "outputs": [
    {
      "name": "slope",
      "from_step": "terrain",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "aspect",
      "from_step": "terrain",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "hillshade",
      "from_step": "terrain",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "roughness",
      "from_step": "terrain",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "tpi",
      "from_step": "terrain",
      "port": "output",
      "kind": "raster"
    },
    {
      "name": "tri",
      "from_step": "terrain",
      "port": "output",
      "kind": "raster"
    }
  ],
  "verification": {
    "enabled": true
  },
  "map_output": {
    "from_step": "terrain",
    "renderer_hint": "singleband_pseudocolor"
  },
  "aliases": [
    "harness.terrain_aspect",
    "harness.terrain_hillshade",
    "harness.terrain_roughness",
    "harness.terrain_tpi",
    "harness.terrain_tri"
  ],
  "presets": {
    "aspect": {
      "step_params": {
        "terrain": {
          "output": "$outputs.aspect",
          "product": "aspect"
        }
      },
      "keep_outputs": [
        "aspect"
      ]
    },
    "hillshade": {
      "step_params": {
        "terrain": {
          "output": "$outputs.hillshade",
          "product": "hillshade"
        }
      },
      "keep_outputs": [
        "hillshade"
      ]
    },
    "roughness": {
      "step_params": {
        "terrain": {
          "output": "$outputs.roughness",
          "product": "roughness"
        }
      },
      "keep_outputs": [
        "roughness"
      ]
    },
    "tpi": {
      "step_params": {
        "terrain": {
          "output": "$outputs.tpi",
          "product": "tpi"
        }
      },
      "keep_outputs": [
        "tpi"
      ]
    },
    "tri": {
      "step_params": {
        "terrain": {
          "output": "$outputs.tri",
          "product": "tri"
        }
      },
      "keep_outputs": [
        "tri"
      ]
    }
  },
  "capabilities": [
    "rs:terrain_analysis"
  ],
  "expected_artifacts": [
    {
      "name": "slope",
      "kind": "raster"
    },
    {
      "name": "aspect",
      "kind": "raster"
    },
    {
      "name": "hillshade",
      "kind": "raster"
    },
    {
      "name": "roughness",
      "kind": "raster"
    },
    {
      "name": "tpi",
      "kind": "raster"
    },
    {
      "name": "tri",
      "kind": "raster"
    }
  ]
}
