{
  "schema_version": "1.0",
  "kind": "harness_recipe",
  "recipe_id": "harness.sar_water",
  "title": "SAR open-water mapping",
  "intent": "sar_water",
  "family": "water",
  "modality": "sar",
  "sensors": [
    "sentinel-1"
  ],
  "description": "Calibrate -> speckle -> threshold dark water. Single-scene; sar pack warns on missing calibration.",
  "slots": [
    {
      "name": "primary",
      "kind": "raster",
      "description": "SAR GRD scene.",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "calibrate",
      "operator_id": "rs:sar_calibrate",
      "params": {
        "input": "$primary.path",
        "output": "$outputs.calibrated"
      },
      "verification": "raster"
    },
    {
      "id": "speckle",
      "operator_id": "rs:sar_speckle",
      "params": {
        "input": "$outputs.calibrated",
        "output": "$outputs.filtered",
        "method": "lee",
        "looks": 2
      },
      "verification": "raster"
    },
    {
      "id": "water",
      "operator_id": "rs:threshold_raster",
      "params": {
        "input": "$outputs.filtered",
        "output": "$outputs.water_extent",
        "thresholdMethod": "statistical",
        "statisticalK": 1.5,
        "cleanup": "open"
      },
      "verification": "raster"
    }
  ],
  "outputs": [
    {
      "name": "water_extent",
      "from_step": "water",
      "port": "output",
      "kind": "raster"
    }
  ],
  "verification": {
    "enabled": true
  },
  "map_output": {
    "from_step": "water",
    "renderer_hint": "categorized"
  },
  "aliases": [
    "harness.sar_water_lee",
    "harness.sar_water_lee-sigma",
    "harness.sar_water_refined-lee"
  ],
  "presets": {
    "lee": {
      "description": "identical chain to canonical (alias preset)"
    },
    "lee-sigma": {
      "step_params": {
        "speckle": {
          "method": "lee_sigma"
        }
      }
    },
    "refined-lee": {
      "step_params": {
        "speckle": {
          "method": "refined_lee"
        }
      }
    }
  },
  "capabilities": [
    "rs:sar_calibrate",
    "rs:sar_speckle",
    "rs:threshold_raster"
  ],
  "expected_artifacts": [
    {
      "name": "water_extent",
      "kind": "raster"
    }
  ]
}
