{
 "schema_version": "1.0",
 "kind": "harness_recipe",
 "recipe_id": "harness.terrain_visualization_stack",
 "title": "Terrain visualization stack (hillshade + slope + aspect)",
 "intent": "terrain",
 "family": "terrain",
 "modality": "terrain",
 "sensors": [
  "dem"
 ],
 "description": "Slope + aspect + roughness foundation products consumed by hydrological tooling. Visualization preset for cartographic context pages.",
 "slots": [
  {
   "name": "primary",
   "kind": "raster",
   "description": "Filled DEM.",
   "required": true
  }
 ],
 "steps": [
  {
   "id": "slope",
   "operator_id": "rs:terrain_analysis",
   "params": {
    "input": "$primary.path",
    "output": "$outputs.slope",
    "product": "slope"
   },
   "verification": "raster"
  },
  {
   "id": "aspect",
   "operator_id": "rs:terrain_analysis",
   "params": {
    "input": "$primary.path",
    "output": "$outputs.aspect",
    "product": "aspect"
   },
   "verification": "raster"
  },
  {
   "id": "roughness",
   "operator_id": "rs:terrain_analysis",
   "params": {
    "input": "$primary.path",
    "output": "$outputs.roughness",
    "product": "roughness"
   },
   "verification": "raster"
  }
 ],
 "outputs": [
  {
   "name": "slope",
   "from_step": "slope",
   "port": "output",
   "kind": "raster"
  },
  {
   "name": "aspect",
   "from_step": "aspect",
   "port": "output",
   "kind": "raster"
  },
  {
   "name": "roughness",
   "from_step": "roughness",
   "port": "output",
   "kind": "raster"
  }
 ],
 "verification": {
  "enabled": true
 },
 "map_output": {
  "from_step": "slope",
  "renderer_hint": "singleband_pseudocolor"
 }
}