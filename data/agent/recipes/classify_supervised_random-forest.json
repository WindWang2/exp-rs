{
 "schema_version": "1.0",
 "kind": "harness_recipe",
 "recipe_id": "harness.classify_supervised_random-forest",
 "title": "Supervised classification (Random Forest)",
 "intent": "classify",
 "family": "classification",
 "modality": "model",
 "sensors": [
  "sentinel-2",
  "landsat-8",
  "landsat-9",
  "sentinel-1"
 ],
 "description": "Feature raster + training samples -> supervised classification -> majority filter. Emits accuracy metrics when a test split is configured. Method preset: Random Forest.",
 "slots": [
  {
   "name": "primary",
   "kind": "raster",
   "description": "Multi-band feature raster.",
   "required": true
  },
  {
   "name": "training",
   "kind": "vector",
   "description": "Training sample polygons/points with a class attribute.",
   "required": true
  }
 ],
 "steps": [
  {
   "id": "classify",
   "operator_id": "rs:supervised_classification",
   "params": {
    "input": "$primary.path",
    "training": "$training.path",
    "output": "$outputs.classification",
    "method": "random_forest",
    "testSplit": "$params.test_split"
   },
   "verification": "raster",
   "when_param": "test_split",
   "params_when_skipped": {
    "input": "$primary.path",
    "training": "$training.path",
    "output": "$outputs.classification",
    "method": "$params.method"
   }
  },
  {
   "id": "clean",
   "operator_id": "rs:majority_filter",
   "params": {
    "input": "$outputs.classification",
    "output": "$outputs.classification_clean",
    "kernel": 3
   },
   "verification": "raster"
  }
 ],
 "outputs": [
  {
   "name": "classification",
   "from_step": "classify",
   "port": "output",
   "kind": "raster"
  },
  {
   "name": "classification_clean",
   "from_step": "clean",
   "port": "output",
   "kind": "raster"
  }
 ],
 "verification": {
  "enabled": true
 },
 "map_output": {
  "from_step": "classify",
  "renderer_hint": "categorized"
 }
}