{
 "schema_version": "1.0",
 "kind": "harness_recipe",
 "recipe_id": "harness.optical_flood_ndwi",
 "title": "Optical flood extent (NDWI threshold)",
 "intent": "flood",
 "family": "flood",
 "modality": "optical",
 "sensors": [
  "sentinel-2",
  "landsat-8",
  "landsat-9"
 ],
 "description": "inspect -> QA mask -> NDWI -> Otsu-style statistical threshold -> morphological cleanup. Optional DEM branch records inundation context.",
 "slots": [
  {
   "name": "primary",
   "kind": "raster",
   "description": "Post-event optical reflectance (Green + NIR).",
   "required": true
  },
  {
   "name": "qa",
   "kind": "raster",
   "description": "Optional QA/cloud mask.",
   "required": false
  },
  {
   "name": "dem",
   "kind": "raster",
   "description": "Optional DEM for terrain context products.",
   "required": false
  }
 ],
 "steps": [
  {
   "id": "mask",
   "operator_id": "rs:qa_mask",
   "params": {
    "input": "$qa.path",
    "output": "$outputs.mask"
   },
   "verification": "raster",
   "when_slot": "qa"
  },
  {
   "id": "ndwi",
   "operator_id": "rs:spectral_index",
   "params": {
    "input": "$primary.path",
    "index": "NDWI",
    "output": "$outputs.ndwi"
   },
   "verification": "raster"
  },
  {
   "id": "water",
   "operator_id": "rs:threshold_raster",
   "params": {
    "input": "$outputs.ndwi",
    "output": "$outputs.water_extent",
    "thresholdMethod": "statistical",
    "statisticalK": 1.5,
    "cleanup": "majority",
    "minAreaPixels": 8
   },
   "verification": "raster"
  },
  {
   "id": "dem_product",
   "operator_id": "rs:terrain_analysis",
   "params": {
    "input": "$dem.path",
    "output": "$outputs.dem_slope",
    "product": "slope"
   },
   "verification": "raster",
   "when_slot": "dem"
  }
 ],
 "outputs": [
  {
   "name": "ndwi",
   "from_step": "ndwi",
   "port": "output",
   "kind": "raster"
  },
  {
   "name": "water_extent",
   "from_step": "water",
   "port": "output",
   "kind": "raster"
  }
 ],
 "verification": {
  "enabled": true
 },
 "map_output": {
  "from_step": "ndwi",
  "renderer_hint": "categorized"
 }
}