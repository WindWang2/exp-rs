              "goal": "Bitemporal difference across mixed radiometric chains",
              "intent": "change",
              "inputs": [
                {
                  "name": "t1",
                  "ref": "$fixture"
                },
                {
                  "name": "t2",
                  "ref": "declared-reflectance"
                }
              ],
              "nodes": [
                {
                  "id": "diff",
