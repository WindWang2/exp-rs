      "case_id": "impossible/plan-with-unknown-operator-not-compilable",
      "category": "impossible_task",
      "description": "A plan naming a nonexistent operator is structurally valid JSON but refuses to compile",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "red",
          "nir"
        ],
        "nodata": -9999.0
      },
      "steps": [
        {
          "tool": "harness:plan",
          "input": {
            "plan": {
              "schema_version": "2.0",
              "kind": "execution_plan",
              "plan_id": "plan-hallucinated",
              "intent": "ndvi",
              "inputs": [
                {
                  "name": "primary",
                  "ref": "$fixture"
                }
              ],
              "steps": [
                {
                  "id": "s1",
                  "operator_id": "rs:magic_ndvi_super",
                  "params": {}
                }
              ],
              "outputs": [
                {
                  "name": "out",
                  "from_step": "s1",
                  "port": "output",
                  "kind": "raster"
                }
              ]
            }
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "compilable",
                "equals": false
              },
              {
                "path": "issues",
                "exists": true
              }
            ]
          }
        }
      ]
    },
