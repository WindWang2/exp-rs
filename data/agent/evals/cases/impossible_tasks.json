{
  "cases": [
    {
      "case_id": "impossible/classify-without-training-blocked",
      "category": "impossible_task",
      "description": "Supervised classification without training samples is blocked before execution",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "red",
          "nir"
        ],
        "nodata": -9999.0
      },
      "steps": [
        {
          "tool": "harness:preflight",
          "input": {
            "intent": "classify",
            "inputs": [
              {
                "name": "primary",
                "ref": "$fixture"
              }
            ]
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "preflight.verdict",
                "equals": "blocked"
              }
            ]
          }
        }
      ]
    },
