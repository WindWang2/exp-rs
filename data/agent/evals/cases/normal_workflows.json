{
  "cases": [
    {
      "case_id": "normal/ndvi-preflight-ok",
      "category": "normal_workflow",
      "description": "NDVI preflight passes on a red+nir surface-reflectance scene",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "red",
          "nir"
        ],
        "nodata": -9999.0,
        "metadata": {
          "SICNU_RADIOMETRIC_STATE": "surface_reflectance"
        }
      },
      "steps": [
        {
          "tool": "spatial:understand",
          "input": {
            "asset": "$fixture"
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "dataset_understanding.modality",
                "equals": "optical"
              }
            ]
          }
        },
        {
          "tool": "harness:preflight",
          "input": {
            "intent": "ndvi",
            "inputs": [
              {
                "name": "primary",
                "ref": "$fixture"
              }
            ]
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "preflight.verdict",
                "equals": "ok"
              }
            ]
          }
        }
      ]
    },
    {
      "foreach": {
        "var": "INDEX",
        "values": [
          "evi",
          "ndwi",
          "nbr"
        ]
      },
      "case_id": "normal/index-$INDEX-preflight-ok",
      "category": "normal_workflow",
      "description": "$INDEX preflight passes on a scene carrying all needed roles",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "blue",
          "green",
          "red",
          "nir",
          "swir"
