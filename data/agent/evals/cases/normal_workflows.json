    {
      "case_id": "normal/recipe-instantiate-ndvi",
      "category": "normal_workflow",
      "description": "NDVI recipe instantiates to a structurally valid plan",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "red",
          "nir"
        ],
        "nodata": -9999.0
      },
      "steps": [
        {
          "tool": "harness:instantiate_recipe",
          "input": {
            "recipe_id": "harness.optical_ndvi",
            "bindings": {
              "slots": {
                "primary": "$fixture"
              }
            }
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "plan.kind",
                "equals": "execution_plan"
              },
              {
                "path": "plan.steps",
                "exists": true
              }
            ]
          }
        },
        {
          "tool": "harness:plan",
          "input": {
            "plan": "$previous.plan"
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "compilable",
                "equals": true
              }
            ]
          }
        }
      ]
    },
    {
