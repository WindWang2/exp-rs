        "nodata": -9999.0,
        "metadata": {
          "SICNU_RADIOMETRIC_STATE": "surface_reflectance"
        }
      },
      "steps": [
        {
          "tool": "harness:preflight",
          "input": {
            "intent": "$INDEX",
            "inputs": [
              {
                "name": "primary",
                "ref": "$fixture"
              }
            ]
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "preflight.verdict",
                "equals": "ok"
              }
            ]
          }
        }
      ]
    },
