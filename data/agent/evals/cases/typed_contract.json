{
  "cases": [
    {
      "case_id": "typed-contract/preflight-carries-intent-document",
      "category": "typed_contract",
      "description": "The preflight answer carries the typed intent contract beside the verdict",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "red",
          "nir"
        ],
        "nodata": -9999.0,
        "metadata": {
          "SICNU_RADIOMETRIC_STATE": "surface_reflectance"
        }
      },
      "steps": [
        {
          "tool": "harness:preflight",
          "input": {
            "intent": "ndvi",
            "inputs": [
              {
                "name": "primary",
                "ref": "$fixture"
              }
            ]
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "preflight.verdict",
                "equals": "ok"
              },
              {
                "path": "intent_document.schema",
                "equals": "harness.intent/1.0"
              },
              {
                "path": "intent_document.intent",
                "equals": "ndvi"
              }
            ]
          }
        }
      ]
    },
    {
      "case_id": "typed-contract/resolve-intent-exposes-required-facts",
      "category": "typed_contract",
      "description": "Intent resolution surfaces the typed fact contract, not just a keyword",
      "steps": [
        {
          "tool": "harness:resolve_intent",
          "input": {
            "goal": "map the flood extent"
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "intent",
                "equals": "flood"
              },
              {
                "path": "intent_document.schema",
                "equals": "harness.intent/1.0"
              },
              {
                "path": "intent_document.required_facts",
                "exists": true
              },
              {
                "path": "intent_document.quality_expectations",
                "exists": true
              }
            ]
          }
        }
      ]
    },
    {
      "case_id": "typed-contract/fact-status-distinguishes-assumed-modality",
      "category": "typed_contract",
      "description": "Understoods facts carry status: CRS is known, modality is an assumption",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "red",
          "nir"
        ],
        "nodata": -9999.0
      },
      "steps": [
        {
          "tool": "spatial:understand",
          "input": {
            "asset": "$fixture"
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "dataset_understanding.fact_status.crs",
                "equals": "known"
              },
              {
                "path": "dataset_understanding.fact_status.modality",
                "equals": "assumed"
              },
              {
                "path": "dataset_understanding.fact_status.radiometric_state",
                "equals": "unknown"
              }
            ]
          }
        }
      ]
    },
    {
      "case_id": "typed-contract/declared-metadata-is-known-not-assumed",
      "category": "typed_contract",
      "description": "Metadata-declared facts (radiometric state) are known; absence is unknown",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "red",
          "nir"
        ],
        "nodata": -9999.0,
        "metadata": {
          "SICNU_RADIOMETRIC_STATE": "toa"
        }
      },
      "steps": [
        {
          "tool": "spatial:understand",
          "input": {
            "asset": "$fixture"
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "dataset_understanding.fact_status.radiometric_state",
                "equals": "known"
              },
              {
                "path": "dataset_understanding.radiometric_state",
                "equals": "toa"
              }
            ]
          }
        }
      ]
    },
    {
      "case_id": "typed-contract/sar-flood-co-pol-is-advice-not-assumption",
      "category": "typed_contract",
      "description": "Co-pol preference on SAR flood mapping grades as advice and never blocks",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "vv"
        ],
        "nodata": -9999.0,
        "metadata": {
          "SICNU_PRODUCT_TYPE": "SENTINEL-1",
          "SICNU_RADIOMETRIC_STATE": "sigma0"
        }
      },
      "steps": [
        {
          "tool": "harness:preflight",
          "input": {
            "intent": "sar_flood",
            "inputs": [
              {
                "name": "before",
                "ref": "$fixture"
              },
              {
                "name": "after",
                "ref": "$fixture"
              }
            ]
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "preflight.verdict",
