{
  "cases": [
    {
      "case_id": "anti-hallucination/plan-dangling-output-dropped-deterministically",
      "category": "anti_hallucination",
      "description": "Repair drops outputs referencing unknown steps; science issues stay advisory",
      "steps": [
        {
          "tool": "harness:repair_plan",
          "input": {
            "plan": {
              "schema_version": "2.0",
              "kind": "execution_plan",
              "plan_id": "plan-repair",
              "intent": "",
              "steps": [
                {
                  "id": "a",
                  "operator_id": "rs:band_math",
                  "params": {}
                },
                {
                  "id": "a",
                  "operator_id": "rs:band_math",
                  "params": {}
                }
              ],
              "outputs": [
                {
                  "name": "ghost",
                  "from_step": "missing-step",
                  "port": "output",
                  "kind": "raster"
                }
              ]
            }
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "compilable",
                "equals": true
              },
              {
                "path": "repair_log",
                "exists": true
              }
            ]
          }
        }
      ]
    },
    {
      "case_id": "anti-hallucination/unknown-preset-fails-typed",
      "category": "anti_hallucination",
      "description": "An unknown recipe preset is INVALID_PARAMETER, never silently ignored",
      "fixture": {
        "kind": "raster",
        "width": 8,
        "height": 8,
        "bands": [
          "red",
          "nir"
        ],
        "nodata": -9999.0
      },
      "steps": [
        {
          "tool": "harness:instantiate_recipe",
          "input": {
            "recipe_id": "harness.optical_ndvi",
            "bindings": {
              "slots": {
                "primary": "$fixture"
              },
              "preset": "sentinel-3-olci"
            }
          },
          "expect": {
            "success": false,
            "error_code": "INVALID_PARAMETER"
          }
        }
      ]
    },
    {
      "case_id": "anti-hallucination/unknown-intent-in-plan-refused",
      "category": "anti_hallucination",
      "description": "A plan declaring an invented intent is refused at read time",
      "steps": [
        {
          "tool": "harness:plan",
          "input": {
            "plan": {
              "schema_version": "2.0",
              "kind": "execution_plan",
              "plan_id": "plan-bad-intent",
              "intent": "crop_circle_detection",
              "steps": [
                {
                  "id": "s1",
                  "operator_id": "rs:band_math",
                  "params": {}
                }
              ],
              "outputs": []
            }
          },
          "expect": {
            "success": false,
            "error_code": "INVALID_PLAN"
          }
        }
      ]
    },
    {
      "case_id": "anti-hallucination/repair-never-invents-science",
      "category": "anti_hallucination",
      "description": "Repair leaves an unknown-operator plan uncompilable and advisory — it never substitutes an operator",
      "steps": [
        {
          "tool": "harness:repair_plan",
          "input": {
            "plan": {
              "schema_version": "2.0",
              "kind": "execution_plan",
              "plan_id": "plan-unknown-op",
              "intent": "",
              "steps": [
                {
                  "id": "s1",
                  "operator_id": "rs:not_a_real_operator",
                  "params": {}
                }
              ],
              "outputs": []
            }
          },
          "expect": {
            "success": true,
            "asserts": [
              {
                "path": "compilable",
                "equals": false
              },
              {
                "path": "issues[0].code",
                "equals": "INVALID_PLAN"
              }
            ]
          }
        }
      ]
    },
    {
      "case_id": "anti-hallucination/understand-non-dataset-file",
      "category": "anti_hallucination",
      "description": "A file that opens as neither raster nor vector is a typed failure",
      "steps": [
        {
          "tool": "spatial:understand",
          "input": {
            "asset": "$tmp/plain.txt"
          },
          "expect": {
            "success": false,
            "error_code": "DATASET_NOT_FOUND"
          }
        }
      ],
      "fixture": {
        "kind": "text",
        "name": "plain.txt",
        "content": "definitely not a geospatial dataset"
      }
    }
  ]
}