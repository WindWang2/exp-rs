{
 "schema_version": "1.0",
 "kind": "style_spec",
 "id": "style.water-extent",
 "version": 1,
 "description": "Binary surface-water extent (0 dry, 1 water) with a token-linked water color and transparent dry class.",
 "token_set_ref": "scientific-light",
 "semantics": [
  "water",
  "flood"
 ],
 "applies_to": "raster",
 "raster": {
  "renderertype": "singleband_pseudocolor",
  "band": 1,
  "classification": {
   "mode": "discrete",
   "classes": [
    {
     "min": 0,
     "max": 0.5,
     "label": "dry",
     "color": "token:colors.background"
    },
    {
     "min": 0.5,
     "max": 1,
     "label": "water",
     "color": "token:colors.water"
    }
   ]
  }
 }
}