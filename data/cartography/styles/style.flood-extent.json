{
 "schema_version": "1.0",
 "kind": "style_spec",
 "id": "style.flood-extent",
 "version": 1,
 "description": "Flood event extent classes: normal channel, flooded, receding.",
 "token_set_ref": "scientific-light",
 "semantics": [
  "flood",
  "water"
 ],
 "applies_to": "raster",
 "raster": {
  "renderertype": "singleband_pseudocolor",
  "band": 1,
  "classification": {
   "mode": "discrete",
   "classes": [
    {
     "min": 0,
     "max": 1,
     "label": "normal channel",
     "color": "#4a7fb5"
    },
    {
     "min": 1,
     "max": 2,
     "label": "flooded",
     "color": "#d73027"
    },
    {
     "min": 2,
     "max": 3,
     "label": "receding",
     "color": "#fdae61"
    }
   ]
  }
 }
}