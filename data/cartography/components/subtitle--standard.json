{
  "id": "subtitle/standard",
  "version": 1,
  "category": "subtitle",
  "semantic_roles": [
    "title.subtitle"
  ],
  "description": "Secondary line under the main title: product, region, or date context.",
  "parameters": {
    "font": {
      "size_pt": 13
    }
  },
  "defaults": {
    "font": {
      "bold": false
    }
  },
  "layout_constraints": {
    "anchor": "edge",
    "preferred_positions": [
      "top-center",
      "top-left"
    ],
    "margin_mm": 8,
    "max_count_per_page": 1
  },
  "compatibility": {
    "requires_map_frame": false
  },
  "data_bindings": [
    {
      "name": "text",
      "source": "params.subtitle",
      "required": true
    }
  ]
}
