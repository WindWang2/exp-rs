{
  "id": "legend/categorical",
  "version": 1,
  "category": "legend",
  "semantic_roles": [
    "legend.primary"
  ],
  "description": "Class-based legend for categorical rasters and vectors.",
  "parameters": {
    "title": "图例",
    "columns": 1
  },
  "defaults": {
    "semantic_role": "legend.primary"
  },
  "variants": [
    {
      "id": "single-column",
      "description": "Vertical single-column legend (default)."
    },
    {
      "id": "multi-column",
      "description": "Two-column legend for wide class sets.",
      "parameters": {
        "columns": 2
      }
    },
    {
      "id": "compact",
      "description": "Compact legend without subtitle spacing.",
      "parameters": {
        "compact": true
      }
    }
  ],
  "layout_constraints": {
    "anchor": "free",
    "preferred_positions": [
      "right-rail",
      "bottom-rail"
    ],
    "margin_mm": 6,
    "max_count_per_page": 2,
    "min_size_mm": [
      30,
      20
    ]
  },
  "compatibility": {
    "requires_map_frame": true,
    "map_types": [
      "raster",
      "vector"
    ],
    "result_types": [
      "classification",
      "land_cover",
      "categorical"
    ]
  },
  "data_bindings": [
    {
      "name": "renderer",
      "source": "map_ref.renderer",
      "required": false,
      "description": "Entries mirror the linked map renderer when auto-update is on."
    }
  ]
}
