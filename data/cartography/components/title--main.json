{
  "id": "title/main",
  "version": 1,
  "category": "title",
  "semantic_roles": [
    "title.main"
  ],
  "description": "Primary map title. Token style 'title' (20pt bold by default); one per page.",
  "parameters": {
    "font": {
      "size_pt": 20,
      "bold": true
    }
  },
  "defaults": {
    "semantic_role": "title.main"
  },
  "variants": [
    {
      "id": "standard",
      "description": "Full-width title band at the top of the page.",
      "defaults": {
        "rect_mm": [
          12,
          6,
          273,
          14
        ]
      }
    },
    {
      "id": "compact",
      "description": "Left-aligned compact title for dense layouts.",
      "parameters": {
        "font": {
          "size_pt": 16
        }
      }
    }
  ],
  "layout_constraints": {
    "anchor": "edge",
    "preferred_positions": [
      "top-center",
      "top-left"
    ],
    "margin_mm": 8,
    "max_count_per_page": 1,
    "min_size_mm": [
      40,
      8
    ]
  },
  "compatibility": {
    "requires_map_frame": false
  },
  "validation": {
    "min_font_pt": 12
  },
  "data_bindings": [
    {
      "name": "text",
      "source": "params.title",
      "required": true,
      "description": "Map title text; bilingual texts use 'title/bilingual'."
    }
  ]
}
