{
  "id": "colorbar/asymmetric",
  "version": 1,
  "category": "color-bar",
  "semantic_roles": [
    "colorbar.primary"
  ],
  "description": "Asymmetric diverging strip where the neutral point is off-center (declared min/mid/max).",
  "parameters": {
    "ramp": "diverging",
    "width_mm": 70,
    "height_mm": 8
  },
  "layout_constraints": {
    "anchor": "edge",
    "preferred_positions": [
      "bottom-center"
    ],
    "margin_mm": 8,
    "max_count_per_page": 2,
    "min_size_mm": [
      50,
      6
    ]
  },
  "compatibility": {
    "requires_map_frame": true
  },
  "data_bindings": [
    {
      "name": "min",
      "source": "params.min",
      "required": true
    },
    {
      "name": "mid",
      "source": "params.mid",
      "required": true
    },
    {
      "name": "max",
      "source": "params.max",
      "required": true
    }
  ]
}
