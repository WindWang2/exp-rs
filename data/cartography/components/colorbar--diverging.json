{
  "id": "colorbar/diverging",
  "version": 1,
  "category": "color-bar",
  "semantic_roles": [
    "colorbar.primary"
  ],
  "description": "Diverging ramp centered on a neutral midpoint (anomalies, change magnitude, NDVI anomalies).",
  "parameters": {
    "ramp": "diverging",
    "width_mm": 70,
    "height_mm": 8
  },
  "layout_constraints": {
    "anchor": "edge",
    "preferred_positions": [
      "bottom-center"
    ],
    "margin_mm": 8,
    "max_count_per_page": 2,
    "min_size_mm": [
      50,
      6
    ]
  },
  "compatibility": {
    "requires_map_frame": true,
    "result_types": [
      "change",
      "anomaly",
      "index"
    ]
  },
  "data_bindings": [
    {
      "name": "range",
      "source": "raster.statistics",
      "required": true
    },
    {
      "name": "midpoint",
      "source": "params.midpoint",
      "required": false
    }
  ]
}
