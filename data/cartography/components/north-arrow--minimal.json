{
  "id": "north-arrow/minimal",
  "version": 1,
  "category": "north-arrow",
  "semantic_roles": [
    "north_arrow.primary"
  ],
  "description": "Simple grid-north arrow for clean thematic layouts.",
  "parameters": {
    "size_mm": 10,
    "north_mode": "grid"
  },
  "defaults": {
    "svg": ":/images/north_arrows/default.svg",
    "semantic_role": "north_arrow.primary"
  },
  "layout_constraints": {
    "anchor": "corner",
    "preferred_positions": [
      "top-right",
      "bottom-left"
    ],
    "margin_mm": 6,
    "max_count_per_page": 1,
    "min_size_mm": [
      6,
      6
    ]
  },
  "compatibility": {
    "requires_map_frame": true
  }
}
