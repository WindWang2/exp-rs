{
  "id": "chart/table",
  "version": 1,
  "category": "chart",
  "semantic_roles": [
    "chart.statistics"
  ],
  "description": "Two-column label/value table (class areas, counts, metrics); deterministic 64-row cap with an overflow row.",
  "parameters": {},
  "defaults": {
    "chart": {
      "kind": "table",
      "binding": {
        "mode": "inline",
        "data": []
      },
      "style": {
        "label_column": "Class",
        "value_column": "Value"
      }
    }
  },
  "layout_constraints": {
    "anchor": "free",
    "margin_mm": 6,
    "min_size_mm": [
      30,
      20
    ]
  },
  "compatibility": {
    "requires_map_frame": false,
    "result_types": [
      "classification",
      "land_cover",
      "categorical",
      "statistics"
    ]
  },
  "data_bindings": [
    {
      "name": "rows",
      "source": "params.table_rows",
      "required": true,
      "description": "[{label, value}] rows rendered in listed order."
    }
  ],
  "variants": [
    {
      "id": "zebra"
    },
    {
      "id": "plain"
    }
  ]
}