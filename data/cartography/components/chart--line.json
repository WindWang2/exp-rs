{
  "id": "chart/line",
  "version": 1,
  "category": "chart",
  "semantic_roles": [
    "chart.trend"
  ],
  "description": "Line chart (profiles, trends).",
  "parameters": {
    "kind": "line"
  },
  "defaults": {
    "chart": {
      "kind": "line",
      "binding": {
        "mode": "inline",
        "data": []
      }
    }
  },
  "layout_constraints": {
    "anchor": "free",
    "preferred_positions": [
      "bottom-rail",
      "right-rail"
    ],
    "margin_mm": 6,
    "max_count_per_page": 4,
    "min_size_mm": [
      30,
      25
    ]
  },
  "compatibility": {
    "requires_map_frame": false,
    "result_types": [
      "time_series",
      "continuous"
    ]
  },
  "data_bindings": [
    {
      "name": "data",
      "source": "params.chart_data",
      "required": true,
      "description": "inline [{label, value}] or vector_expression {layer, x_expression, y_expression}."
    }
  ],
  "variants": [
    {
      "id": "single-series"
    },
    {
      "id": "multi-series",
      "description": "Multiple series; binding.data is a list of series.",
      "parameters": {
        "series_field": "series"
      }
    }
  ]
}
