{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sicnu-geo-rs/schemas/labspec_schema.json",
  "title": "SICNU GEO RS LabSpec",
  "description": "Declarative specification of an undergraduate remote-sensing lab: objectives, principles, data requirements, executable pipeline, operators, grading intent and assessment questions. NOTE (D3 track): authored pending D2's canonical schema; when D2 merges, D2's schema is authoritative and these specs migrate.",
  "type": "object",
  "required": [
    "schema", "id", "version", "title", "theme", "audience",
    "objectives", "principles", "data", "pipeline", "operators",
    "steps", "grading_ref", "expected_results", "questions"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sicnu.labspec.v1",
      "description": "Format identifier."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Stable lab identifier, e.g. temporal_analysis."
    },
    "version": { "type": "string", "default": "1.0" },
    "title": {
      "type": "string",
      "description": "Display title (中文)."
    },
    "theme": {
      "type": "string",
      "description": "Capability theme, e.g. temporal / sar / hyperspectral / cartography."
    },
    "audience": {
      "type": "string",
      "description": "Target course/level, e.g. 遥感导论本科生."
    },
    "duration_minutes": { "type": "integer", "minimum": 30 },
    "prerequisites": {
      "type": "array",
      "description": "Lab ids or concepts the student should have completed.",
      "items": { "type": "string" }
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" },
      "description": "实验目的 (numbered in docs by array order)."
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "body"],
        "properties": {
          "heading": { "type": "string" },
          "body": { "type": "string" },
          "formulas": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Formulae in plain text/LaTeX-ish notation."
          },
          "refs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Textbook/paper references."
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["spec_ref", "offline"],
      "properties": {
        "spec_ref": {
          "type": "string",
          "description": "Path to the data requirement spec consumed by D1, e.g. data/labs/data-specs/<id>.json."
        },
        "offline": {
          "type": "boolean",
          "const": true,
          "description": "Lab environment must not require network access."
        },
        "description": { "type": "string" }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": {
          "type": "string",
          "description": "Path to the headless pipeline JSON (pipeline_schema.json format)."
        },
        "runner": {
          "type": "string",
          "default": "sicnu_geo_rs_cli --pipeline <ref>",
          "description": "Headless invocation."
        },
        "description": { "type": "string" }
      }
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operator_id", "role"],
        "properties": {
          "operator_id": {
            "type": "string",
            "pattern": "^[a-z]+:[a-z0-9_]+$",
            "description": "Registered RSOperator id; must resolve in the Processing Registry."
          },
          "role": { "type": "string" },
          "params_digest": {
            "type": "object",
            "description": "Human-readable summary of the parameter bindings used by this lab."
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "title", "detail"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string", "description": "中文操作指导." },
          "operator_id": { "type": "string" },
          "headless_note": {
            "type": "string",
            "description": "How this step is covered by the headless pipeline."
          }
        }
      }
    },
    "grading_ref": {
      "type": "object",
      "required": ["intent_ref", "grader_owner"],
      "properties": {
        "intent_ref": {
          "type": "string",
          "description": "Path to the grading assertion intent, e.g. data/labs/grading/<id>.intent.json."
        },
        "grader_owner": {
          "type": "string",
          "description": "Track that implements the grader (D3 writes intent only; D4 implements)."
        }
      }
    },
    "expected_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim"],
        "properties": {
          "claim": { "type": "string" },
          "artifact": {
            "type": "string",
            "description": "Output file the student can inspect."
          },
          "tolerance_note": {
            "type": "string",
            "description": "Acceptance statistics/tolerances (mirrored in grading intent)."
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": { "type": "string" },
          "hint": { "type": "string" }
        }
      }
    },
    "glossary": {
      "type": "array",
      "description": "Inline terminology (fallback until D6 glossary lands); keep terms consistent across labs.",
      "items": {
        "type": "object",
        "required": ["term", "definition"],
        "properties": {
          "term": { "type": "string" },
          "en": { "type": "string" },
          "definition": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Cross-track dependencies this lab declares (declared, not fixed here).",
      "items": {
        "type": "object",
        "required": ["kind", "ref", "note"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["track", "test", "data", "schema"]
          },
          "ref": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Honest-scope notes: executable subset statements, typed refusals, caveats."
    }
  }
}
