{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sicnu.lab.rules/1",
  "title": "SICNU lab grading rules (authoring contract)",
  "description": "One file per lab: data/labs/grading/<lab_id>.rules.json. The grading engine validates these constraints in code (output_verifier.cpp is authoritative; kind list synced with kKnownKinds, artifact kinds raster|file, lab platform 12.0). See docs/labs/GRADING.md.",
  "type": "object",
  "required": [
    "schema_version",
    "lab_id",
    "title",
    "artifact",
    "assertions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "sicnu.lab.rules/1"
    },
    "lab_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "raster",
            "file"
          ],
          "description": "raster = the artifact is a GeoTIFF submission graded by the raster kernels; file = the artifact is a document (PNG map / MapSpec JSON) checked by file_check kernels"
        }
      },
      "required": [
        "kind"
      ]
    },
    "passing_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 60
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/assertion"
      }
    }
  },
  "definitions": {
    "assertion": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "weight",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "range",
            "mean_sigma",
            "gain_invariance",
            "nodata_ratio",
            "histogram_shape",
            "classification_kappa",
            "confusion_marginals",
            "change_area_interval",
            "crs_grid",
            "zone_stats",
            "band_layout",
            "spatial_agreement",
            "series_separation",
            "spectral_signature",
            "file_check",
            "provenance"
          ]
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "severity": {
          "enum": [
            "normal",
            "blocking"
          ],
          "default": "normal"
        },
        "params": {
          "type": "object"
        },
        "derivation": {
          "type": "string"
        }
      }
    },
    "band": {
      "type": "integer",
      "minimum": 1
    },
    "ratio01": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "truth_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inline"
          ],
          "properties": {
            "inline": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      ]
    }
  }
}
