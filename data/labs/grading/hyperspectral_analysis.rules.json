{
  "schema_version": "sicnu.lab.rules/1",
  "lab_id": "hyperspectral_analysis",
  "title": "实验10 SAM 分类标签判分（labspec hyperspectral_analysis 主产物）",
  "artifact": { "kind": "raster" },
  "passing_score": 60,
  "assertions": [
    {
      "id": "labels.zone_accuracy",
      "kind": "spatial_agreement",
      "weight": 70,
      "severity": "normal",
      "params": {
        "band": 1,
        "truth": { "path": "../../../tests/fixtures/lab/hsi_zones.tif" },
        "zone_expected": [
          { "zone": 1, "label": 0 },
          { "zone": 2, "label": 1 },
          { "zone": 3, "label": 2 }
        ],
        "min_accuracy": 0.95
      },
      "derivation": "H3（lab10 intent）：三个纯区内正确标签像元占比 >= 95%（映射 1->0, 2->1, 3->2）。位置敏感：整体正确率或混淆矩阵不能暴露'纯区内部标签错位'，逐区精度可以。fixture 为三条纯 stripe（x<86, x<171, 其余）。"
    },
    {
      "id": "labels.complete",
      "kind": "nodata_ratio",
      "weight": 15,
      "severity": "normal",
      "params": {
        "band": 1,
        "min_ratio": 0.0,
        "max_ratio": 0.0
      },
      "derivation": "H3 前置：标签栅格不允许 NoData 空洞（SAM 对全像元输出标签；空洞即漏分）。"
    },
    {
      "id": "grid.labels",
      "kind": "crs_grid",
      "weight": 15,
      "severity": "blocking",
      "params": {
        "epsg": 4326,
        "width": 256,
        "height": 256,
        "pixel_size_x": 0.001,
        "pixel_size_y": 0.001,
        "band_count": 1
      },
      "derivation": "H3 前置：角度栅格与标签栅格同网格（intent 原文）。"
    }
  ]
}
