{
  "id": "otb_bilateral_filter",
  "name": "OTB Smoothing (Gaussian)",
  "group": "Image Filtering",
  "group_id": "filtering",
  "command": "otbcli_Smoothing",
  "tags": ["otb", "filter", "smoothing", "gaussian", "custom"],
  "parameters": [
    {"name": "INPUT", "type": "raster", "description": "Input raster"},
    {"name": "OUTPUT", "type": "output_raster", "description": "Filtered output raster"},
    {"name": "SPATIAL", "type": "number", "description": "Gaussian spatial standard deviation (pixels)", "default": 3.0}
  ],
  "args": ["-in", "{INPUT}", "-out", "{OUTPUT}", "-type", "gaussian", "-type.gaussian.stdev", "{SPATIAL}"]
}