{
  "id": "otb_bilateral_filter",
  "name": "OTB Bilateral Filter",
  "group": "Image Filtering",
  "group_id": "filtering",
  "command": "otbcli_BilateralImageFilter",
  "tags": ["otb", "filter", "bilateral", "smoothing", "custom"],
  "parameters": [
    {"name": "INPUT", "type": "raster", "description": "Input raster"},
    {"name": "OUTPUT", "type": "output_raster", "description": "Filtered output raster"},
    {"name": "RANGE", "type": "number", "description": "Range standard deviation", "default": 15.0},
    {"name": "SPATIAL", "type": "number", "description": "Spatial standard deviation", "default": 3.0}
  ],
  "args": ["-in", "{INPUT}", "-out", "{OUTPUT}", "-filter.range", "{RANGE}", "-filter.spatial", "{SPATIAL}"]
}