{
  "id": "otb_block_matching",
  "name": "OTB Block Matching (Stereo)",
  "group": "Stereo",
  "group_id": "stereo",
  "command": "otbcli_BlockMatching",
  "tags": ["otb", "stereo", "disparity", "block matching", "custom"],
  "parameters": [
    {"name": "LEFT", "type": "raster", "description": "Left epipolar image"},
    {"name": "RIGHT", "type": "raster", "description": "Right epipolar image"},
    {"name": "OUTPUT", "type": "output_raster", "description": "Disparity map output"},
    {"name": "WINDOW", "type": "number", "description": "Correlation window radius", "default": 4}
  ],
  "args": ["-io.inleft", "{LEFT}", "-io.inright", "{RIGHT}", "-io.out", "{OUTPUT}", "-bm.metric", "ssd", "-bm.radius", "{WINDOW}"]
}