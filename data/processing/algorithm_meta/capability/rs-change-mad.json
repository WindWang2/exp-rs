{
  "capability": {
    "applicability": {
      "land_cover": [
        "城市",
        "农田"
      ],
      "scenes": [
        "辐射差异较大时的稳健变化检测",
        "多波段统计变化检测"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": true
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "multipass_streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "两期影像网格不一致",
        "remedy": "先 rs:align 对齐"
      },
      {
        "code": "NOT_SUPPORTED",
        "when": "样本像元过少导致协方差估计不稳定",
        "remedy": "保证足够重叠区域样本"
      }
    ],
    "family": "change",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "after",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        },
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "before",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "numeric",
          "name": "mean",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "method",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "stddev",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "0",
          "name": "afterBand",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "name": "beforeBand",
          "required": false,
          "type": "integer"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "optical"
    ],
    "operator_group": "temporal",
    "prerequisites": [
      "Before and after rasters must be co-registered and same size (grid compatibility is preflighted)."
    ],
    "schema_version": 2,
    "summary": "MAD 变化检测（多元变化检测）：对两期多波段做典型相关变换后取方差不变分量，自动突出真实变化。",
    "teaching_use": {
      "concepts": [
        "典型相关",
        "MAD 变量",
        "方差不变"
      ],
      "courses": [
        "遥感数字图像处理",
        "统计方法"
      ],
      "exercise": "对光照差异明显的两期影像执行 MAD 并与差值法比较虚警率。"
    }
  },
  "description": "Multivariate Alteration Detection change magnitude (canonical correlation analysis, multi-pass streaming).",
  "display_name": "Multivariate Alteration Detection",
  "id": "rs:change_mad",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "change-detection",
    "temporal"
  ]
}
