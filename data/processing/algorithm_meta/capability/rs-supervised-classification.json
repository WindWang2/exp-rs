{
  "capability": {
    "applicability": {
      "land_cover": [
        "农田",
        "森林",
        "城市",
        "水体"
      ],
      "scenes": [
        "土地覆盖/利用制图",
        "作物分布制图"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": false,
      "memory_policy": "full_raster",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "TRAINING_INVALID",
        "when": "训练样本缺失、类间不平衡或类别数不一致",
        "remedy": "检查训练样本覆盖所有类别且每类有足够样本"
      },
      {
        "code": "MODEL_INCOMPATIBLE",
        "when": "输入波段数与模型期望特征数不符",
        "remedy": "让模型与特征波段集一致，或用 rs:feature_stack 重排特征"
      }
    ],
    "family": "classification",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "input",
          "required": true
        },
        {
          "data_kind": "vector",
          "name": "training",
          "required": false
        }
      ],
      "outputs": [
        {
          "data_kind": "integer",
          "name": "classes",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "imbalanceWarnings",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "kappa",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "meanConfidence",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "mode",
          "required": true
        },
        {
          "data_kind": "raster",
          "file_format": "tif",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "overallAccuracy",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "perClassMetrics",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "trainSamples",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "trainSamplesByClass",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "bands",
          "required": false,
          "type": "integer"
        },
        {
          "default": "class_id",
          "name": "classField",
          "required": false,
          "type": "string"
        },
        {
          "default": "5000",
          "name": "maxSamplesPerClass",
          "required": false,
          "type": "integer"
        },
        {
          "default": "svm",
          "enum": [
            "svm",
            "normal_bayes",
            "rf",
            "mlp",
            "knn",
            "min_distance",
            "mahalanobis"
          ],
          "name": "method",
          "required": false,
          "type": "enum"
        },
        {
          "name": "modelIn",
          "required": false,
          "type": "string"
        },
        {
          "name": "modelOut",
          "required": false,
          "type": "string"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "name": "probabilityOutput",
          "required": false,
          "type": "string"
        },
        {
          "default": "true",
          "name": "scale",
          "required": false,
          "type": "boolean"
        },
        {
          "default": "42",
          "name": "seed",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "name": "testSplit",
          "required": false,
          "type": "numeric"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "optical",
      "sar",
      "multimodal"
    ],
    "operator_group": "classification",
    "prerequisites": [
      "Train mode: training polygons must overlap the raster",
      "Predict-only: modelIn must match method and band set",
      "需要标注训练数据；输入特征建议先统一网格与量纲。"
    ],
    "schema_version": 2,
    "summary": "监督分类：基于训练样本（随机森林/ SVM 等按 model 参数）对影像逐像元分类，输出类别图与精度报告。",
    "teaching_use": {
      "concepts": [
        "监督分类",
        "训练样本",
        "混淆矩阵"
      ],
      "courses": [
        "遥感数字图像处理",
        "模式识别"
      ],
      "exercise": "用 5 类训练样本完成研究区土地覆盖分类，并以 30% 独立样本评价总体精度。"
    }
  },
  "description": "Train or apply SVM/NormalBayes classification on multi-band rasters.",
  "display_name": "Supervised Classification",
  "gpu": false,
  "id": "rs:supervised_classification",
  "input": "raster",
  "notes": "NormalBayes / SVM / KMeans with cross-validation, per-class metrics and probability outputs. Model sidecar records features and validation results for compatibility checks.",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "supervised",
    "classification",
    "svm",
    "model"
  ],
  "task": "classification"
}
