            "linear",
            "percent_clip",
            "stddev",
            "histogram_equalize",
            "piecewise"
          ],
          "name": "method",
          "required": false,
          "type": "enum"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "name": "piecewisePoints",
          "required": false,
          "type": "string"
        },
        {
          "default": "2",
          "name": "stddevK",
          "required": false,
          "type": "numeric"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "optical",
      "sar",
      "thermal",
      "dem"
    ],
    "operator_group": "enhancement",
    "prerequisites": [],
