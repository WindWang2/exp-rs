{
  "capability": {
    "applicability": {
      "land_cover": [
        "山地",
        "丘陵",
        "河谷"
      ],
      "scenes": [
        "地形因子制图",
        "滑坡/水土流失分析的基础图层"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "INVALID_PARAMETER",
        "when": "Z 因子与 DEM 垂直单位不匹配（度 vs 米）",
        "remedy": "确认 Z 因子参数与 DEM 高程单位一致"
      },
      {
        "code": "CRS_MISMATCH",
        "when": "DEM 使用地理坐标系导致坡度计算错误",
        "remedy": "先重投影到投影坐标系（米制）再计算"
      }
    ],
    "family": "terrain",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "input",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "integer",
          "name": "height",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "product",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "width",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "30",
          "name": "cellSize",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "-9999",
          "name": "nodata",
          "required": false,
          "type": "numeric"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "slope",
          "enum": [
            "slope",
            "aspect",
            "hillshade",
            "roughness",
            "tri",
            "tpi",
            "curvature_profile",
            "curvature_plan",
            "curvature_total",
            "hillshade_multidirectional",
            "local_relief"
          ],
          "name": "product",
          "required": true,
          "type": "enum"
        },
        {
          "default": "315",
          "name": "sunAzimuth",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "45",
          "name": "sunElevation",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "1",
          "name": "zFactor",
          "required": false,
          "type": "numeric"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "dem"
    ],
    "operator_group": "terrain",
    "prerequisites": [
      "建议使用投影坐标系（米制）的 DEM。"
    ],
    "schema_version": 2,
    "summary": "地形参数分析：由 DEM 计算坡度、坡向、山体阴影等地形因子，是所有地形定量化分析的入口。",
    "teaching_use": {
      "concepts": [
        "坡度",
        "坡向",
        "山体阴影"
      ],
      "courses": [
        "GIS 原理",
        "地形分析"
      ],
      "exercise": "由 SRTM DEM 生成坡度、坡向与山体阴影三张图层并叠加判读。"
    }
  },
  "description": "Compute slope, aspect, hillshade, roughness, TRI, or TPI from a DEM.",
  "display_name": "Terrain Analysis",
  "id": "rs:terrain_analysis",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "terrain",
    "dem",
    "slope",
    "hillshade"
  ]
}
