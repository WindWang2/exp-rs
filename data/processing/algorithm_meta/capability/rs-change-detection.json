{
  "capability": {
    "applicability": {
      "land_cover": [
        "城市",
        "农田",
        "森林",
        "水体"
      ],
      "scenes": [
        "土地覆盖变化检测",
        "灾害应急变化速报"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": true
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "multipass_streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "两期影像网格/配准不一致",
        "remedy": "先用 rs:align 配准到同一网格"
      },
      {
        "code": "TIME_ORDER_INVALID",
        "when": "before/after 顺序颠倒",
        "remedy": "确认 before 为早期影像"
      },
      {
        "code": "MODALITY_MISMATCH",
        "when": "两期数据模态不一致（光学 vs SAR）",
        "remedy": "同模态两期数据才能直接比较"
      }
    ],
    "family": "change",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "after",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        },
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "before",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "numeric",
          "name": "changedArea",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "changedAreaUnit",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "changedPercent",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "changedPixels",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "mean",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "method",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "stddev",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "thresholdUsed",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "totalPixels",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "0",
          "name": "afterBand",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "name": "beforeBand",
          "required": false,
          "type": "integer"
        },
        {
          "default": "none",
          "enum": [
            "none",
            "erode",
            "dilate",
            "open",
            "close"
          ],
          "name": "cleanup",
          "required": false,
          "type": "enum"
        },
        {
          "default": "1",
          "name": "cleanupIterations",
          "required": false,
          "type": "integer"
        },
        {
          "default": "false",
          "name": "makeMask",
          "required": false,
          "type": "boolean"
        },
        {
          "default": "difference",
          "enum": [
            "difference",
            "normalized_difference",
            "ratio",
            "cva",
            "mad",
            "change_mask"
          ],
          "name": "method",
          "required": false,
          "type": "enum"
        },
        {
          "default": "0",
          "name": "minAreaPixels",
          "required": false,
          "type": "integer"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "90",
          "name": "percentile",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "2",
          "name": "statisticalK",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "0.500000",
          "name": "threshold",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "manual",
          "enum": [
            "manual",
            "otsu",
            "percentile",
            "statistical"
          ],
          "name": "thresholdMethod",
          "required": false,
          "type": "enum"
        }
      ]
    },
    "limitations": [
      "ratio outputs after/before (NaN where before is <= 0); cva and mad stream over 256x256 tiles in O(tile*bands + bands^2) memory (mad is multi-pass); makeMask writes a UInt8 0/1 mask with manual/Otsu/percentile/statistical thresholds and optional morphological cleanup."
    ],
    "modality": [
      "optical"
    ],
    "operator_group": "temporal",
    "prerequisites": [
      "Before and after rasters must be co-registered and same size (grid compatibility is preflighted).",
      "两期影像须同模态、同网格、可比辐射量纲。"
    ],
    "schema_version": 2,
    "summary": "通用双时相变化检测入口：按 method 选择差值/比值/CVA 等策略生成变化图，需两期配准影像。",
    "teaching_use": {
      "concepts": [
        "双时相变化检测",
        "变化阈值"
      ],
      "courses": [
        "遥感数字图像处理"
      ],
      "exercise": "对两期城市影像执行变化检测并按阈值提取新建区。"
    }
  },
  "description": "Detect changes between two co-registered raster images.",
  "display_name": "Change Detection",
  "gpu": false,
  "id": "rs:change_detection",
  "input": "raster",
  "notes": "Difference / ratio / normalized difference / CVA with Otsu, percentile, statistical, or manual thresholds, morphological cleanup, minimum mapping unit, and area statistics. Inputs must share grid and radiometric state.",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "change-detection",
    "temporal",
    "difference"
  ],
  "task": "change-detection"
}
