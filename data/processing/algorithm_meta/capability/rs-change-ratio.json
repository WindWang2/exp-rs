{
  "capability": {
    "applicability": {
      "land_cover": [
        "植被",
        "裸土"
      ],
      "scenes": [
        "光照差异较大的两期比较",
        "矿物蚀变粗查"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": true
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "两期影像网格不一致",
        "remedy": "先 rs:align 对齐"
      }
    ],
    "family": "change",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "after",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        },
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "before",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "numeric",
          "name": "mean",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "method",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "stddev",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "0",
          "name": "afterBand",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "name": "beforeBand",
          "required": false,
          "type": "integer"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "optical"
    ],
    "operator_group": "temporal",
    "prerequisites": [
      "Before and after rasters must be co-registered and same size (grid compatibility is preflighted)."
    ],
    "schema_version": 2,
    "summary": "比值法变化检测：两期影像相比值突出比例型变化，对乘性光照差异比差值法更稳健。",
    "teaching_use": {
      "concepts": [
        "影像比值",
        "乘性噪声"
      ],
      "courses": [
        "遥感数字图像处理"
      ],
      "exercise": "对两期影像做比值检测并讨论光照差异下差值法的误报。"
    }
  },
  "description": "Ratio change after / before (NaN where before is <= 0).",
  "display_name": "Change Ratio",
  "id": "rs:change_ratio",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "change-detection",
    "temporal"
  ]
}
