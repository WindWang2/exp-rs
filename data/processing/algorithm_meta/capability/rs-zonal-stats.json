      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "CRS_MISMATCH",
        "when": "分区矢量与栅格坐标系不一致",
        "remedy": "统一两者坐标系后重算"
      },
      {
        "code": "INVALID_PARAMETER",
        "when": "统计量名称不在支持列表",
        "remedy": "从 mean/sum/min/max/quantile 中选择"
      }
    ],
    "family": "raster_spatial",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "input",
          "required": true
        },
        {
          "data_kind": "vector",
          "name": "vector",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "table",
          "file_format": "csv",
          "name": "output",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "bands",
          "required": false,
          "type": "integer"
        },
        {
          "name": "layer",
          "required": false,
          "type": "string"
        },
        {
          "default": "true",
          "name": "median",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "name": "zoneField",
          "required": false,
          "type": "string"
        }
      ]
    },
    "limitations": [
      "Overlapping zones: last feature wins (input order), matching rs:rasterize.",
      "Median is budgeted (shared 16M-value collection); zones beyond it are flagged while their other statistics stay exact.",
      "stddev is the population statistic (divided by N)."
    ],
    "modality": [
      "optical",
      "sar",
      "thermal",
      "dem"
    ],
    "operator_group": "raster-vector",
    "prerequisites": [
      "Value raster carries a CRS and a north-up geotransform.",
      "Zone features carry geometry; a declared zoneField must exist on every feature.",
      "分区与栅格需同一 CRS；必要时先 rs:align。"
    ],
    "schema_version": 2,
    "summary": "分区统计：按矢量/栅格分区计算内部像元的均值/总和/分位数等，输出区域属性表，是报表与评价的核心算子。",
    "teaching_use": {
