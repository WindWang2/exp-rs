{
  "capability": {
    "applicability": {
      "land_cover": [
        "水体",
        "农田",
        "建成区（SAR）"
      ],
      "scenes": [
        "洪涝范围快速制图",
        "农作物倒伏监测"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": true
    },
    "determinism": {
      "grade": "tolerance",
      "large_raster_safe": true,
      "memory_policy": "multipass_streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "两期影像网格不一致",
        "remedy": "先用 rs:align 或 rs:sar_geocode 配准到同一网格"
      },
      {
        "code": "TIME_ORDER_INVALID",
        "when": "before/after 时相顺序颠倒",
        "remedy": "确认 before 早于 after"
      }
    ],
    "family": "sar",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "modality": "sar",
          "name": "inputA",
          "required": true
        },
        {
          "data_kind": "raster",
          "modality": "sar",
          "name": "inputB",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "numeric",
          "name": "changedPercent",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "changedPixels",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "evaluatedPixels",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "magnitudeDomain",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "thresholdUsed",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "1",
          "name": "bandA",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "bandB",
          "required": false,
          "type": "integer"
        },
        {
          "default": "none",
          "enum": [
            "none",
            "erode",
            "dilate",
            "open",
            "close"
          ],
          "name": "cleanup",
          "required": false,
          "type": "enum"
        },
        {
          "default": "1",
          "name": "cleanupIterations",
          "required": false,
          "type": "integer"
        },
        {
          "default": "linear_power",
          "enum": [
            "linear_power",
            "db"
          ],
          "name": "inputDomain",
          "required": false,
          "type": "enum"
        },
        {
          "default": "0",
          "name": "minAreaPixels",
          "required": false,
          "type": "integer"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "90",
          "name": "percentile",
          "required": false,
          "type": "numeric"
        },
        {
          "name": "polarizations",
          "required": false,
          "type": "string"
        },
        {
          "name": "sensor",
          "required": false,
          "type": "string"
        },
        {
          "default": "2",
          "name": "statisticalK",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "0",
          "name": "threshold",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "otsu",
          "enum": [
            "manual",
            "otsu",
            "percentile",
            "statistical"
          ],
          "name": "thresholdMethod",
          "required": false,
          "type": "enum"
        }
      ]
    },
    "limitations": [
      "Incoherent change only — no coherent/interferometric phase analysis.",
      "Scenes must share CRS, pixel size, origin and extent; no hidden resampling is applied.",
      "If either input declares SICNU_SAR_DOMAIN=db and inputDomain is left at linear_power, the operator refuses (pass inputDomain=db to convert, or convert first)."
    ],
    "modality": [
      "sar"
    ],
    "operator_group": "sar",
    "prerequisites": [
      "两期 SAR 影像须同极化、同网格；建议先 rs:sar_speckle 滤波。"
    ],
    "schema_version": 2,
    "summary": "SAR 双时相变化检测：比较两景配准 SAR 影像的后向散射幅度差异，探测地表变化（洪涝、倒伏、滑坡引起的幅度变化等；不含 InSAR 相位）。",
    "teaching_use": {
      "concepts": [
        "SAR 变化检测",
        "后向散射差异"
      ],
      "courses": [
        "微波遥感"
      ],
      "exercise": "对洪水前后两景 Sentinel-1 计算比值变化图并提取淹没区。"
    }
  },
  "description": "Detect change between two co-registered SAR scenes: log-ratio magnitude (dB) thresholded into a change mask (manual, Otsu, percentile or statistical).",
  "display_name": "SAR Change Detection",
  "id": "rs:sar_change",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "sar",
    "change",
    "change-detection"
  ]
}
