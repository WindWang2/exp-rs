{
  "capability": {
    "applicability": {
      "land_cover": [
        "城市",
        "农田",
        "森林"
      ],
      "scenes": [
        "多波段变化强度制图",
        "城市扩张多维度检测"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": true
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "multipass_streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "两期影像网格不一致",
        "remedy": "先 rs:align 对齐"
      },
      {
        "code": "INVALID_PARAMETER",
        "when": "两期波段数不一致",
        "remedy": "保证两期使用相同波段集"
      }
    ],
    "family": "change",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "after",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        },
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "before",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "numeric",
          "name": "mean",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "method",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "stddev",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "0",
          "name": "afterBand",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "name": "beforeBand",
          "required": false,
          "type": "integer"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "optical"
    ],
    "operator_group": "temporal",
    "prerequisites": [
      "Before and after rasters must be co-registered and same size (grid compatibility is preflighted).",
      "两期影像同网格、同波段集。"
    ],
    "schema_version": 2,
    "summary": "变化向量分析（CVA）：在多波段空间计算两期变化向量的模长，全面刻画多波段变化强度。",
    "teaching_use": {
      "concepts": [
        "变化向量",
        "欧氏距离"
      ],
      "courses": [
        "遥感数字图像处理"
      ],
      "exercise": "对 6 波段两期影像做 CVA 并分析变化强度空间格局。"
    }
  },
  "description": "Change Vector Analysis magnitude across all bands (sqrt of summed squared band deltas).",
  "display_name": "Change Vector Analysis",
  "id": "rs:change_cva",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "change-detection",
    "temporal"
  ]
}
