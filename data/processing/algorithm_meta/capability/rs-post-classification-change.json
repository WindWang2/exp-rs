      "large_raster_safe": true,
      "memory_policy": "multipass_streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "两期分类图网格不一致",
        "remedy": "先 rs:align 最近邻对齐"
      },
      {
        "code": "INVALID_PARAMETER",
        "when": "两期分类体系（类别数/编码）不一致",
        "remedy": "统一类别编码或提供映射表"
      }
    ],
    "family": "change",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "after",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "before",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "numeric",
          "name": "changedPercent",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "changedPixels",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "classCount",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "fromTotals",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "netChange",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "toTotals",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "totalPixels",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "transitionMatrix",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "unchangedPixels",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "0",
          "name": "afterBand",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "name": "beforeBand",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "name": "class_count",
          "required": false,
          "type": "integer"
        },
        {
          "name": "class_labels",
          "required": false,
          "type": "string"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        }
      ]
    },
    "limitations": [
      "Change-type codes are UInt16: class_count must be <= 255 so before * classCount + after fits; auto class_count derives from the maximum observed class + 1."
    ],
    "modality": [
      "optical",
      "sar",
      "multimodal"
    ],
    "operator_group": "change-detection",
    "prerequisites": [
      "Both inputs are thematic rasters with a shared class coding; before/after grids must be aligned (grid compatibility is preflighted).",
      "两期分类图须同一分类体系与网格。"
    ],
    "schema_version": 2,
    "summary": "分类后变化检测：对两期分类图做类别转移矩阵与变化/保留图输出，变化类型可解释，精度受两期分类质量约束。",
    "teaching_use": {
      "concepts": [
        "转移矩阵",
        "分类后比较"
      ],
      "courses": [
        "遥感应用分析"
      ],
