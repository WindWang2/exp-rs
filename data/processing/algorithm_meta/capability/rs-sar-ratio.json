          "data_kind": "raster",
          "modality": "sar",
          "name": "inputB",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "integer",
          "name": "bands",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "outputType",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "1",
          "name": "bandA",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "bandB",
          "required": false,
          "type": "integer"
        },
        {
          "default": "linear_power",
