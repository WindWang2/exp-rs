          "required": false,
          "type": "enum"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "log_ratio",
          "enum": [
            "ratio",
            "log_ratio",
            "log_difference"
          ],
          "name": "outputType",
          "required": false,
          "type": "enum"
        },
        {
          "name": "polarizations",
          "required": false,
          "type": "string"
        },
        {
          "name": "sensor",
          "required": false,
          "type": "string"
        }
      ]
    },
    "limitations": [
      "Scenes must share CRS, pixel size, origin and extent; no hidden resampling is applied.",
