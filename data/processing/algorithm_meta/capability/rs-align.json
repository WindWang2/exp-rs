{
  "capability": {
    "applicability": {
      "land_cover": [
        "任意地物"
      ],
      "scenes": [
        "多源数据融合前的网格统一",
        "变化检测/堆叠/掩膜前的配准"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "CRS_MISMATCH",
        "when": "输入坐标系不一致",
        "remedy": "先统一重投影或在参数中声明目标 CRS"
      },
      {
        "code": "INVALID_PARAMETER",
        "when": "目标分辨率或参考图层缺失",
        "remedy": "指定参考栅格或显式给出目标网格参数"
      }
    ],
    "family": "raster_spatial",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "input",
          "required": true
        },
        {
          "data_kind": "raster",
          "grid_relation": "defines-target-grid",
          "modality": "raster",
          "name": "reference",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "boolean",
          "name": "alreadyAligned",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "height",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "width",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "false",
          "name": "categorical",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "near",
          "enum": [
            "near",
            "bilinear",
            "cubic",
            "cubicspline",
            "lanczos",
            "average",
            "mode",
            "rms"
          ],
          "name": "resampling",
          "required": false,
          "type": "enum"
        },
        {
          "name": "warpMemoryLimitBytes",
          "required": false,
          "type": "numeric"
        }
      ]
    },
    "limitations": [
      "Rotated or flipped reference grids are refused; no hidden resampling of the reference itself."
    ],
    "modality": [
      "optical",
      "sar",
      "thermal",
      "dem"
    ],
    "operator_group": "raster",
    "prerequisites": [
      "作为网格修复器，建议在任何多输入栅格运算前执行。"
    ],
    "schema_version": 2,
    "summary": "网格对齐（shared-grid builder）：把多幅栅格重采样/裁剪到统一网格（原点、分辨率、范围），是 ADR 0098 同一网格契约的标准执行算子。",
    "teaching_use": {
      "concepts": [
        "重采样",
        "网格对齐",
        "配准"
      ],
      "courses": [
        "GIS 原理",
        "遥感数字图像处理"
      ],
      "exercise": "把 DEM 与 Sentinel-2 影像对齐到 10m 统一网格。"
    }
  },
  "description": "Warp a raster exactly onto a reference raster's grid (CRS, origin, resolution and extent) so multi-input operators accept the pair; identical grids publish a lossless copy.",
  "display_name": "Align Raster To Reference",
  "id": "rs:align",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "grid",
    "alignment"
  ]
}
