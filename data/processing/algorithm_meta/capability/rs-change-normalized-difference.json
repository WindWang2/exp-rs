{
  "capability": {
    "applicability": {
      "land_cover": [
        "植被",
        "水体"
      ],
      "scenes": [
        "指数时序变化（如 dNDVI）",
        "归一化变化制图"
      ]
    },
    "band_roles": {
      "nir": 1,
      "swir": 1
    },
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": true
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "两期影像网格不一致",
        "remedy": "先 rs:align 对齐"
      }
    ],
    "family": "change",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "after",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        },
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "name": "before",
          "radiometric_state": [
            "digital_number",
            "radiance",
            "toa_reflectance",
            "surface_reflectance"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "numeric",
          "name": "mean",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "method",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "stddev",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "0",
          "name": "afterBand",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "name": "beforeBand",
          "required": false,
          "type": "integer"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "optical"
    ],
    "operator_group": "temporal",
    "prerequisites": [
      "Before and after rasters must be co-registered and same size (grid compatibility is preflighted)."
    ],
    "schema_version": 2,
    "summary": "归一化差值变化检测：(a-b)/(a+b) 形式压制公共乘性因子，兼顾差值与比值的优点。",
    "teaching_use": {
      "concepts": [
        "归一化差值",
        "相对变化"
      ],
      "courses": [
        "遥感数字图像处理"
      ],
      "exercise": "对两期 NDVI 做归一化差值并比较与简单差值的检测结果。"
    }
  },
  "description": "Normalized difference change (after - before) / (after + before).",
  "display_name": "Change Normalized Difference",
  "id": "rs:change_normalized_difference",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "change-detection",
    "temporal"
  ]
}
