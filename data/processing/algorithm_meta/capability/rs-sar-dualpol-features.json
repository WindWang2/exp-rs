{
  "capability": {
    "applicability": {
      "land_cover": [
        "农田",
        "植被（SAR）"
      ],
      "scenes": [
        "雷达植被指数生产",
        "SAR 分类特征工程"
      ]
    },
    "band_roles": {
      "vh": 1,
      "vv": 1
    },
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "POLARIZATION_MISMATCH",
        "when": "数据缺少双极化通道之一",
        "remedy": "确认输入包含 VV 与 VH 两个通道"
      }
    ],
    "family": "sar",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "input",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "string",
          "name": "feature",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "auto",
          "enum": [
            "auto",
            "linear",
            "db"
          ],
          "name": "domain",
          "required": false,
          "type": "enum"
        },
        {
          "default": "rvi",
          "enum": [
            "ratio",
            "normalized_difference",
            "log_ratio",
            "rvi",
            "span"
          ],
          "name": "feature",
          "required": true,
          "type": "enum"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "2",
          "name": "vh_band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "vv_band",
          "required": false,
          "type": "integer"
        }
      ]
    },
    "limitations": [
      "rvi is the dual-pol Sentinel-1 approximation 4VH/(VV+VH), NOT the quad-pol RVI (needs a second cross-pol channel this platform does not model).",
      "Nonpositive linear-power values are outside the SAR domain and yield NaN, never clamped."
    ],
    "modality": [
      "sar"
    ],
    "operator_group": "sar",
    "prerequisites": [
      "Input should be radiometrically calibrated backscatter (rs:sar_calibrate)."
    ],
    "schema_version": 2,
    "summary": "双极化特征提取：从 VV/VH 双通道计算比值、极化分解量等特征，服务作物分类与地表类型识别。",
    "teaching_use": {
      "concepts": [
        "极化比",
        "双极化分解"
      ],
      "courses": [
        "微波遥感"
      ],
      "exercise": "计算 VH/VV 比值图并分析其在水稻生育期中的变化。"
    }
  },
  "description": "Dual-polarization feature rasters (ratio, normalized difference, log ratio, dual-pol RVI, span) from VV/VH calibrated backscatter.",
  "display_name": "SAR Dual-Pol Features",
  "gpu": false,
  "id": "rs:sar_dualpol_features",
  "input": "raster",
  "notes": "Tile-streamed element-wise features on linear power; dB inputs are converted before the kernel so the output domain is independent of the input domain; bit-exact grade.",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "sar",
    "dual-pol",
    "rvi"
  ],
  "task": "sar-feature-engineering"
