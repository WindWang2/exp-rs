    "limitations": [
      "Plane-fit RTC model, NOT range-Doppler terrain correction.",
      "The DEM must be co-registered with the input in radar geometry; no resampling is performed.",
      "Facets with a local incidence angle >= 85° are masked as layover/shadow.",
      "Always writes two bands (gamma0 + validity mask). rs:sar_terrain_correction is the 3-band product (gamma0 + mask + local incidence)."
    ],
    "modality": [
      "sar"
    ],
    "operator_group": "sar",
    "prerequisites": [
      "sigma0 raster (linear power) and a DEM on the exact same grid (radar geometry for GRD products), plus the scene incidence angle and the antenna look azimuth (headingDeg + lookDirection, or an explicit lookAzimuthDeg).",
      "需要 DEM；在定标（rs:sar_calibrate）之后执行。"
    ],
    "schema_version": 2,
    "summary": "SAR 地形辐射平坦化（Gamma Flat / terrain flattening）：以实际散射面积归一化后向散射，使山地 gamma0 接近真实地表。",
    "teaching_use": {
      "concepts": [
        "地形平坦化",
        "实际散射面积"
      ],
      "courses": [
        "微波遥感"
      ],
      "exercise": "对山区 Sentinel-1 执行 terrain flattening 并评估坡面gamma0的稳定性。"
    }
  },
  "description": "Radiometric terrain flattening: sigma0 to gamma0 (sigma0·cosθ0/cosθi) using a co-registered DEM in radar geometry. Writes band 1 = gamma0 and band 2 = validity mask (1/0/255).",
  "display_name": "SAR Terrain Flattening",
  "id": "rs:sar_terrain_flatten",
  "input": "raster",
  "output": "raster",
