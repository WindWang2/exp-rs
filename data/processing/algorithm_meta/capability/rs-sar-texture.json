{
  "capability": {
    "applicability": {
      "land_cover": [
        "城市",
        "农田",
        "森林（SAR）"
      ],
      "scenes": [
        "SAR 分类特征增强",
        "建筑区提取"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "tolerance",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "INVALID_PARAMETER",
        "when": "窗口或位移参数非法",
        "remedy": "窗口取奇数且大于 1"
      },
      {
        "code": "INSUFFICIENT_MEMORY",
        "when": "超大影像 GLCM 全图计算内存超限",
        "remedy": "分幅处理或减小窗口"
      }
    ],
    "family": "sar",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "modality": "sar",
          "name": "input",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "integer",
          "name": "bands",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "measures",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "1",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "enum": [
            "0",
            "45",
            "90",
            "135"
          ],
          "name": "directionDeg",
          "required": false,
          "type": "enum"
        },
        {
          "default": "1",
          "name": "displacement",
          "required": false,
          "type": "integer"
        },
        {
          "name": "measures",
          "required": false,
          "type": "string"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "name": "polarizations",
          "required": false,
          "type": "string"
        },
        {
          "default": "16",
          "name": "quantLevels",
          "required": false,
          "type": "integer"
        },
        {
          "name": "sensor",
          "required": false,
          "type": "string"
        },
        {
          "default": "5",
          "name": "windowSize",
          "required": false,
          "type": "integer"
        }
      ]
    },
    "limitations": [
      "Windows containing NoData produce NaN in every measure.",
      "Quantization is equal-width per window, so measures are not directly comparable across windows with different dynamic ranges."
    ],
    "modality": [
      "sar"
    ],
    "operator_group": "sar",
    "prerequisites": [
      "Calibrated SAR intensity raster (rs:sar_calibrate first) so window statistics operate on physically scaled data.",
      "Each window is quantized to quantLevels equal-width bins spanning the window's [min, max]."
    ],
    "schema_version": 2,
    "summary": "SAR 纹理特征提取：基于 GLCM 等计算方差/对比度/熵等纹理量，补充后向散射之外的地表信息。",
    "teaching_use": {
      "concepts": [
        "GLCM",
        "纹理特征"
      ],
      "courses": [
        "微波遥感"
      ],
      "exercise": "提取 8 邻域 GLCM 对比度与熵，评估其对城中村边界的刻画能力。"
    }
  },
  "description": "Compute GLCM (Haralick) texture measures over a sliding window of a SAR intensity raster; one Float32 output band per measure.",
  "display_name": "SAR GLCM Texture",
  "id": "rs:sar_texture",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "sar",
    "texture",
    "glcm"
  ]
}
