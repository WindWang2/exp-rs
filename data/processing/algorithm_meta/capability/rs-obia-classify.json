{
  "capability": {
    "applicability": {
      "land_cover": [
        "城市",
        "农田",
        "林地"
      ],
      "scenes": [
        "面向对象土地覆盖制图",
        "建筑/植被对象提取"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": false,
      "memory_policy": "full_raster",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "TRAINING_INVALID",
        "when": "对象样本缺失或与特征表不匹配",
        "remedy": "补采对象样本或重算特征"
      },
      {
        "code": "DATASET_NOT_FOUND",
        "when": "缺少对象特征图层",
        "remedy": "先运行 rs:obia_features"
      }
    ],
    "family": "obia",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "input",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "labels",
          "required": false
        },
        {
          "data_kind": "vector",
          "name": "training",
          "required": false
        }
      ],
      "outputs": [
        {
          "data_kind": "string",
          "name": "accuracy",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "classes",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "labeledSegments",
          "required": true
        },
        {
          "data_kind": "raster",
          "file_format": "tif",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "segments",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "bands",
          "required": false,
          "type": "integer"
        },
        {
          "default": "16",
          "name": "cellSize",
          "required": false,
          "type": "integer"
        },
        {
          "name": "classColors",
          "required": false,
          "type": "string"
        },
        {
          "default": "class_id",
          "name": "classField",
          "required": false,
          "type": "string"
        },
        {
          "name": "featureSelection",
          "required": false,
          "type": "string"
        },
        {
          "default": "mean",
          "enum": [
            "mean",
            "full"
          ],
          "name": "features",
          "required": false,
          "type": "enum"
        },
        {
          "default": "svm",
          "enum": [
            "svm",
            "normal_bayes",
            "random_forest",
            "kmeans",
            "mlp"
          ],
          "name": "method",
          "required": false,
          "type": "enum"
        },
        {
          "default": "3",
          "name": "minLabelPixels",
          "required": false,
          "type": "integer"
        },
        {
          "default": "20",
          "name": "minRegionSize",
          "required": false,
          "type": "integer"
        },
        {
          "default": "16",
          "name": "mlpHiddenLayerSize",
          "required": false,
          "type": "integer"
        },
        {
          "default": "500",
          "name": "mlpMaxIter",
          "required": false,
          "type": "integer"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "name": "outputUncertainty",
          "required": false,
          "type": "string"
        },
        {
          "default": "64",
          "name": "quantizeBins",
          "required": false,
          "type": "integer"
        },
        {
          "default": "10",
          "name": "rfMaxDepth",
          "required": false,
          "type": "integer"
        },
        {
          "default": "5",
          "name": "rfMinSampleCount",
          "required": false,
          "type": "integer"
        },
        {
          "default": "100",
          "name": "rfNumTrees",
          "required": false,
          "type": "integer"
        },
        {
          "default": "true",
          "name": "scale",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "segmentClasses",
          "required": false,
          "type": "string"
        },
        {
          "default": "grid",
          "enum": [
            "grid",
            "quantize"
          ],
          "name": "segmentMethod",
          "required": false,
          "type": "enum"
        },
        {
          "default": "3",
          "name": "smoothKernel",
          "required": false,
          "type": "integer"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "optical",
      "sar",
      "multimodal"
    ],
    "operator_group": "obia",
    "prerequisites": [
      "需要对象特征表（rs:obia_features）。"
    ],
    "schema_version": 2,
    "summary": "对象级分类：基于对象特征用规则或模型给对象赋类别，输出矢量/栅格类别图。",
    "teaching_use": {
      "concepts": [
        "对象分类",
        "规则集"
      ],
      "courses": [
        "面向对象遥感"
      ],
      "exercise": "用 NDVI 与面积规则把对象分为植被/裸地/建筑三类。"
    }
  },
  "description": "Classify objects from polygon training or pre-labeled segments.",
  "display_name": "OBIA Classification",
  "id": "rs:obia_classify",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "obia",
    "object-based",
    "classification"
  ]
}
