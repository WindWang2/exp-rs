{
  "capability": {
    "applicability": {
      "land_cover": [
        "山地（SAR）"
      ],
      "scenes": [
        "山区 SAR 数据质量评估",
        "时序 SAR 像元可靠性筛选"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "DATASET_NOT_FOUND",
        "when": "缺少 DEM 或入射角信息",
        "remedy": "提供 DEM 与轨道入射角参数"
      }
    ],
    "family": "sar",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "dem",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "product",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "0",
          "name": "heading",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "35",
          "name": "incidence",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "0",
          "name": "lookAzimuth",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "0",
          "name": "lookAzimuthDeg",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "right",
          "enum": [
            "right",
            "left"
          ],
          "name": "lookDirection",
          "required": false,
          "type": "enum"
        },
        {
          "default": "0",
          "name": "look_azimuth",
          "required": false,
          "type": "numeric"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "layover_shadow_mask",
          "enum": [
            "local_incidence",
            "layover_shadow_mask",
            "local_incidence_orbit"
          ],
          "name": "product",
          "required": true,
          "type": "enum"
        }
      ]
    },
    "limitations": [
      "Constant-geometry approximation: per-scene incidence/heading, not per-pixel orbit geometry.",
      "The radiometric terrain factor cos(theta_i)/cos(theta_l) is exposed via the kernel for providers, not written by this operator (use rs:sar_terrain_flatten for normalized backscatter)."
    ],
    "modality": [
      "sar"
    ],
    "operator_group": "sar",
    "prerequisites": [
      "DEM on any grid; the DEM defines the geometry, no co-registered SAR input is required."
    ],
    "schema_version": 2,
    "summary": "SAR 地形掩膜生成：基于 DEM 与雷达几何把像元标记为叠掩/阴影/Normal（不区分透视收缩），供后续分析剔除不可靠像元。",
    "teaching_use": {
      "concepts": [
        "雷达阴影",
        "叠掩",
        "几何畸变"
      ],
      "courses": [
        "微波遥感"
      ],
      "exercise": "生成山区雷达阴影掩膜并统计不可信像元比例。"
    }
  },
  "description": "Local incidence angle and geometric layover/shadow masks from a DEM under declared constant SAR geometry (not full range-Doppler).",
  "display_name": "SAR Terrain Masks",
  "gpu": false,
  "id": "rs:sar_terrain_masks",
  "input": "raster",
  "notes": "Rigorous surface-normal geometry under the declared constant-incidence/heading contract. Full range-Doppler correction requires orbit state vectors + sensor timing, which the product metadata contract does not carry — that extension (SICNU_SAR_ORBIT_STATES et al.) is documented in sar_terrain_geometry.h and deliberately NOT approximated.",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "sar",
    "terrain",
    "layover",
    "shadow"
  ],
  "task": "sar-geometry"
}
