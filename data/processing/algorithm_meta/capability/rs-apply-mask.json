{
  "capability": {
    "applicability": {
      "land_cover": [
        "任意地物"
      ],
      "scenes": [
        "云污染像元剔除",
        "QA 波段解析后的质量过滤"
      ]
    },
    "band_roles": {
      "mask": 1
    },
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "掩膜与影像网格或尺寸不一致",
        "remedy": "先用 rs:align 对齐掩膜（重采样为最近邻）再应用"
      },
      {
        "code": "INVALID_PARAMETER",
        "when": "掩膜值域与期望掩膜值不匹配",
        "remedy": "确认 mask_value 参数与掩膜栅格的实际编码一致"
      }
    ],
    "family": "optical",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "input",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "mask",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "boolean",
          "name": "aligned",
          "required": true
        },
        {
          "data_kind": "numeric",
          "name": "maskedPercent",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "maskedPixels",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "totalPixels",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "true",
          "name": "align_mask",
          "required": false,
          "type": "boolean"
        },
        {
          "default": "0",
          "name": "no_data",
          "required": false,
          "type": "numeric"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        }
      ]
    },
    "limitations": [
      "Grid alignment uses nearest-neighbor sampling (appropriate for integer masks); CRS mismatches are not auto-corrected."
    ],
    "modality": [
      "optical",
      "sar",
      "thermal",
      "dem"
    ],
    "operator_group": "qa",
    "prerequisites": [
      "Input and mask share a CRS (same-CRS grid differences are auto-aligned).",
      "Input bands must define a NoData value, or `no_data` must be provided for bands without one.",
      "掩膜与目标影像须同一网格（可用 rs:align 最近邻重采样对齐）。"
    ],
    "schema_version": 2,
    "summary": "把掩膜栅格应用到目标影像：掩膜像元处写 nodata，是云/水体/质量掩膜的标准执行算子。",
    "teaching_use": {
      "concepts": [
        "掩膜",
        "nodata",
        "像元级过滤"
      ],
      "courses": [
        "遥感数字图像处理"
      ],
      "exercise": "用 QA 波段生成云掩膜并应用到反射率影像，统计被剔除像元比例。"
    }
  },
  "description": "Set masked pixels (cloud / shadow / snow) to NoData in every band of a product raster, yielding analysis-ready imagery.",
  "display_name": "Apply Mask",
  "id": "rs:apply_mask",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "qa",
    "cloud",
    "mask",
    "analysis-ready"
  ]
}
