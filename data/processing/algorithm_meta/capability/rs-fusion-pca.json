{
  "capability": {
    "applicability": {
      "land_cover": [
        "城市",
        "矿区"
      ],
      "scenes": [
        "多波段影像融合",
        "融合前后信息量分析"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "输入网格不一致",
        "remedy": "先用 rs:align 统一网格"
      },
      {
        "code": "NOT_SUPPORTED",
        "when": "输入波段过少导致主成分退化",
        "remedy": "至少保证 3 个以上多光谱波段"
      }
    ],
    "family": "optical",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "ms",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "pan",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "integer",
          "name": "bands",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "method",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "2",
          "name": "blueIdx",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "greenIdx",
          "required": false,
          "type": "integer"
        },
        {
          "name": "msWeights",
          "required": false,
          "type": "numeric"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "0.500000",
          "name": "panWeight",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "0",
          "name": "redIdx",
          "required": false,
          "type": "integer"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "multimodal",
      "optical"
    ],
    "operator_group": "fusion",
    "prerequisites": [
      "Pan and MS rasters must be co-registered."
    ],
    "schema_version": 2,
    "summary": "PCA 全色锐化：对多光谱做主成分变换后以全色替换第一主成分，适合波段较多的多光谱数据。",
    "teaching_use": {
      "concepts": [
        "主成分分析",
        "全色锐化"
      ],
      "courses": [
        "遥感数字图像处理"
      ],
      "exercise": "对 6 波段 Landsat 影像做 PCA 融合，分析 PC1 方差贡献。"
    }
  },
  "description": "Principal Component Analysis pan-sharpening fusion.",
  "display_name": "Fusion PCA",
  "id": "rs:fusion_pca",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "fusion",
    "pan-sharpening",
    "enhancement"
  ]
}
