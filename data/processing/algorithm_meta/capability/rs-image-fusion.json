{
  "capability": {
    "applicability": {
      "land_cover": [
        "城市",
        "农田",
        "海岸带"
      ],
      "scenes": [
        "多光谱影像空间分辨率提升",
        "变化检测前的双时相配准融合"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "GRID_MISMATCH",
        "when": "全色与多光谱影像网格或范围不一致",
        "remedy": "先用 rs:align 对齐两组输入再融合"
      },
      {
        "code": "BAND_ROLE_UNRESOLVED",
        "when": "输入缺少全色波段角色标注",
        "remedy": "通过 SICNU_BAND_ROLE 标注 pan 波段或显式指定波段号"
      }
    ],
    "family": "optical",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "ms",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "pan",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "integer",
          "name": "bands",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "method",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "2",
          "name": "blueIdx",
          "required": false,
          "type": "integer"
        },
        {
          "default": "1",
          "name": "greenIdx",
          "required": false,
          "type": "integer"
        },
        {
          "default": "linear",
          "enum": [
            "linear",
            "brovey",
            "pca",
            "ihs",
            "gram_schmidt"
          ],
          "name": "method",
          "required": false,
          "type": "enum"
        },
        {
          "name": "msWeights",
          "required": false,
          "type": "numeric"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "0.500000",
          "name": "panWeight",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "0",
          "name": "redIdx",
          "required": false,
          "type": "integer"
        }
      ]
    },
    "limitations": [
      "IHS requires exactly 3 MS bands mapped to R/G/B."
    ],
    "modality": [
      "multimodal",
      "optical"
    ],
    "operator_group": "enhancement",
    "prerequisites": [
      "Pan and MS rasters must be co-registered.",
      "全色与多光谱输入必须几何配准且位于同一网格（ADR 0098）。"
    ],
    "schema_version": 2,
    "summary": "通用全色锐化（pansharpening）入口：把高分辨率全色波段与多光谱波段融合，按 method 选择 Brovey/IHS/GS/PCA 等方法。",
    "teaching_use": {
      "concepts": [
        "全色锐化",
        "空间分辨率",
        "光谱保真"
      ],
      "courses": [
        "遥感数字图像处理"
      ],
      "exercise": "用 GS 与 Brovey 两种方法融合 Landsat 全色与多光谱，评估水体光谱保真度。"
    }
  },
  "description": "Fuse panchromatic and multispectral imagery (pan-sharpening).",
  "display_name": "Image Fusion",
  "id": "rs:image_fusion",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "fusion",
    "pan-sharpening",
    "enhancement"
  ]
}
