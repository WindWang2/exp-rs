      "memory_policy": "streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "POLARIZATION_MISMATCH",
        "when": "请求的极化通道在数据中不存在",
        "remedy": "确认数据含 VV/VH 通道或改用存在的极化"
      },
      {
        "code": "INVALID_RADIOMETRY",
        "when": "输入未定标导致 sigma0 量纲错误",
        "remedy": "先用 rs:sar_calibrate 完成辐射定标"
      }
    ],
    "family": "sar",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "incidenceRaster",
          "required": false
        },
        {
          "data_kind": "raster",
          "modality": "sar",
          "name": "input",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "integer",
          "name": "bands",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "calibration",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "domain",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "1",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "sigma0",
          "enum": [
            "sigma0",
            "gamma0",
            "beta0",
            "dn"
          ],
          "name": "fromCalibration",
          "required": false,
          "type": "enum"
        },
        {
          "default": "0",
          "name": "incidenceDeg",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "linear_power",
          "enum": [
            "linear_power",
            "db"
          ],
          "name": "inputDomain",
          "required": false,
          "type": "enum"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "linear_power",
          "enum": [
            "linear_power",
            "db"
          ],
          "name": "outputDomain",
          "required": false,
          "type": "enum"
        },
        {
          "name": "polarizations",
          "required": false,
          "type": "string"
        },
        {
          "name": "sensor",
          "required": false,
          "type": "string"
        },
        {
          "default": "gamma0",
          "enum": [
            "sigma0",
            "gamma0",
            "beta0"
          ],
          "name": "toCalibration",
          "required": false,
          "type": "enum"
        }
      ]
    },
    "limitations": [
      "beta0 needs the incidence angle from geometry: set incidenceDeg > 0 or provide incidenceRaster.",
      "DN input is unsupported; calibrate first with rs:sar_calibrate.",
      "inputDomain=db cannot be combined with a calibration-state conversion; convert the numeric domain in a separate step."
    ],
    "modality": [
      "sar"
    ],
    "operator_group": "sar",
    "prerequisites": [],
    "schema_version": 2,
    "summary": "SAR 后向散射状态转换：在已定标强度数据上于 sigma0/gamma0/beta0 辐射状态及线性功率/dB 之间转换；不支持 DN 或 SLC 复数据。",
    "teaching_use": {
      "concepts": [
        "后向散射",
        "sigma0",
        "gamma0"
      ],
      "courses": [
        "微波遥感"
      ],
      "exercise": "对 Sentinel-1 GRD 计算 gamma0 并比较农田与水体的散射差异。"
    }
  },
  "description": "Convert SAR backscatter between sigma0/gamma0/beta0 states and linear power or dB using a constant or per-pixel incidence angle.",
  "display_name": "SAR Backscatter Conversion",
  "id": "rs:sar_backscatter",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "sar",
    "backscatter",
    "radiometry"
  ]
}
