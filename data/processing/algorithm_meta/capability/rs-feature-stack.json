      }
    ],
    "family": "classification",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "name": "reference",
          "required": false
        }
      ],
      "outputs": [
        {
          "data_kind": "integer",
          "name": "bands",
          "required": true
        },
        {
          "array": true,
          "data_kind": "string",
          "item_type": "string",
          "name": "features",
          "required": true
        },
        {
          "array": true,
          "data_kind": "string",
          "item_type": "string",
          "name": "modalities",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "feature_cube",
