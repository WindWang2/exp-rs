          "required": true
        },
        {
          "data_kind": "integer",
          "name": "incidenceBand",
          "required": true
        },
        {
          "data_kind": "string",
          "name": "layout",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "maskBand",
          "required": true
        },
        {
          "data_kind": "raster",
          "name": "output",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "1",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "default": "meters",
          "enum": [
            "meters",
            "feet",
            "decimeters"
          ],
          "name": "demUnit",
          "required": false,
          "type": "enum"
        },
        {
          "default": "true",
          "name": "flagIncidence",
          "required": false,
          "type": "boolean"
        },
        {
          "default": "true",
          "name": "flagMask",
          "required": false,
          "type": "boolean"
        },
        {
          "default": "0",
          "name": "headingDeg",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "30",
          "name": "incidenceDeg",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "0",
          "name": "lookAzimuthDeg",
          "required": false,
          "type": "numeric"
        },
        {
          "default": "right",
          "enum": [
            "right",
            "left"
          ],
          "name": "lookDirection",
          "required": false,
          "type": "enum"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "name": "polarizations",
          "required": false,
          "type": "string"
        },
        {
          "name": "sensor",
          "required": false,
          "type": "string"
        }
      ]
    },
    "limitations": [
      "Plane-fit RTC model, NOT range-Doppler terrain correction.",
      "The DEM must be co-registered with the input in radar geometry; no resampling is performed.",
      "Facets with a local incidence angle >= 85° are masked as layover/shadow.",
      "The output includes the layover/shadow validity mask and the local incidence angle band (both optional via flagMask/flagIncidence)."
    ],
    "modality": [
      "sar"
    ],
    "operator_group": "sar",
    "prerequisites": [
      "sigma0 raster (linear power) and a DEM on the exact same grid (radar geometry for GRD products), plus the scene incidence angle and platform heading.",
      "需要 DEM；建议在 rs:sar_geocode 之后执行。"
    ],
    "schema_version": 2,
    "summary": "SAR 地形校正：消除坡度坡向对后向散射的几何畸变（叠掩/阴影/透视收缩的辐射影响）。",
    "teaching_use": {
      "concepts": [
        "地形辐射校正",
        "局部入射角"
      ],
      "courses": [
        "微波遥感"
      ],
      "exercise": "在山区比较地形校正前后 gamma0 的坡向依赖性。"
    }
  },
  "description": "DEM terrain correction product: terrain-flattened gamma0 with a layover/shadow validity mask and the local incidence angle band.",
  "display_name": "SAR Terrain Correction",
  "id": "rs:sar_terrain_correction",
  "input": "raster",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "sar",
