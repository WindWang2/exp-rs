      }
    ],
    "family": "sar",
    "io": {
      "inputs": [
        {
          "data_kind": "raster",
          "grid_relation": "same-grid",
          "modality": "dem",
          "name": "dem",
          "required": true
        },
        {
          "data_kind": "raster",
          "modality": "sar",
          "name": "input",
          "required": true
        }
      ],
      "outputs": [
        {
          "data_kind": "integer",
          "name": "bands",
          "required": true
        },
        {
          "data_kind": "string",
