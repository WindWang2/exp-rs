{
  "capability": {
    "applicability": {
      "land_cover": [
        "植被",
        "水体",
        "任意地物"
      ],
      "scenes": [
        "月度/季度无云底图生产",
        "NDVI 时序预处理"
      ]
    },
    "band_roles": {},
    "crs": {
      "requires_projected": false,
      "requires_shared_grid": false
    },
    "determinism": {
      "cost_class": "O(tile × scenes)",
      "grade": "bit_exact",
      "large_raster_safe": true,
      "memory_policy": "multipass_streaming",
      "side_effects": false,
      "stochastic": false
    },
    "failure_modes": [
      {
        "code": "TIME_ORDER_INVALID",
        "when": "各期影像未按时间排序或日期缺失",
        "remedy": "提供含日期的时序输入集合并检查排序"
      },
      {
        "code": "GRID_MISMATCH",
        "when": "各期影像网格不一致",
        "remedy": "逐期 rs:align 对齐后再合成"
      }
    ],
    "family": "temporal",
    "io": {
      "inputs": [],
      "outputs": [
        {
          "data_kind": "raster",
          "file_format": "tif",
          "name": "output",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "periodCount",
          "required": true
        },
        {
          "data_kind": "integer",
          "name": "sceneCount",
          "required": true
        }
      ],
      "parameters": [
        {
          "default": "true",
          "name": "apply_qa_masking",
          "required": false,
          "type": "boolean"
        },
        {
          "default": "0",
          "name": "band",
          "required": false,
          "type": "integer"
        },
        {
          "enum": [
            "blue",
            "green",
            "red",
            "red_edge",
            "nir",
            "swir1",
            "swir2"
          ],
          "name": "band_role",
          "required": false,
          "type": "enum"
        },
        {
          "name": "collection",
          "required": false,
          "type": "string"
        },
        {
          "default": "keep_all",
          "enum": [
            "keep_all",
            "reject"
          ],
          "name": "duplicate_policy",
          "required": false,
          "type": "enum"
        },
        {
          "default": "best_pixel",
          "enum": [
            "best_pixel",
            "mean",
            "median"
          ],
          "name": "method",
          "required": false,
          "type": "enum"
        },
        {
          "name": "output",
          "required": true,
          "type": "string"
        },
        {
          "default": "all",
          "enum": [
            "all",
            "month",
            "quarter",
            "season",
            "year",
            "custom"
          ],
          "name": "period",
          "required": false,
          "type": "enum"
        },
        {
          "default": "0",
          "name": "period_days",
          "required": false,
          "type": "integer"
        },
        {
          "default": "0",
          "name": "quality_band",
          "required": false,
          "type": "integer"
        },
        {
          "name": "scenes",
          "required": false,
          "type": "string"
        },
        {
          "name": "target_date",
          "required": false,
          "type": "string"
        },
        {
          "default": "256",
          "name": "tile_size",
          "required": false,
          "type": "integer"
        }
      ]
    },
    "limitations": [],
    "modality": [
      "optical"
    ],
    "operator_group": "temporal",
    "prerequisites": [
      "所有期次影像须配准到同一网格并统一辐射量纲。"
    ],
    "schema_version": 2,
    "summary": "时序合成：把多期影像按最优像元（质量分）/均值/中值合成一景，压制云与噪声。默认 quality_band=0 时各期得分相同，按目标日期就近选取；需要经典 MVC 时把指数波段显式设为 quality_band。",
    "teaching_use": {
      "concepts": [
        "影像合成",
        "最优像元合成",
        "中值合成"
      ],
      "courses": [
        "遥感数字图像处理"
      ],
      "exercise": "把 12 期月度 NDVI 合成为年度最大值图并对比云污染情况。"
    }
  },
  "description": "Temporal composites (best-pixel, mean or median) over a multi-date collection, optionally grouped by month / quarter / season / year / custom period. Every output carries a valid-observation-count band and the chosen observation's quality score.",
  "display_name": "Best Pixel Composite",
  "id": "rs:temporal_composite",
  "input": "",
  "output": "raster",
  "schema_version": 2,
  "tags": [
    "temporal",
    "composite",
    "best-pixel"
  ]
}
