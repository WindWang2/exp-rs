  "postprocess": {
    "mask_threshold": -1.0
  },
  "runtime": {
    "gpu": false,
    "cpu_fallback": true,
    "estimated_vram_mb": 0,
    "estimated_ram_mb": 1024,
    "supports_tiling": true
  },
  "reference": "https://github.com/template/water-segmentation",
