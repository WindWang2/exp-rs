{
  "name": "unet-water-s2",
  "task": "segmentation",
  "framework": "onnx",
  "path": "",
  "gpu": false,
  "accuracy": 0.93,
  "domain": {
    "sensors": [
      "Sentinel-2"
    ],
    "resolution_range": [
      10.0,
      20.0
    ],
    "modalities": [
      "optical"
    ]
  },
  "artifact": {
    "path": "",
    "checksum": "",
