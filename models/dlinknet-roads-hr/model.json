{
  "name": "dlinknet-roads-hr",
  "task": "segmentation",
  "framework": "onnx",
  "path": "",
  "gpu": false,
  "accuracy": 0.89,
  "domain": {
    "sensors": [
      "WorldView-3",
      "aerial"
    ],
    "resolution_range": [
      0.3,
      1.0
    ],
    "modalities": [
      "optical"
    ]
  },
  "artifact": {
    "path": "",
    "checksum": "",
    "size_bytes": 0,
    "note": "weights are not distributed with the repository; download from the reference, place beside the manifest, fill path + sha256 checksum"
  },
  "input": {
    "dtype": "float32",
    "layout": "NCHW",
    "band_roles": [
      "red",
      "green",
      "blue"
    ]
  },
  "preprocess": {
    "normalize": "mean_std",
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ],
    "scale": 1.0
  },
  "tiling": {
    "supported": true,
    "tile_size": 512,
    "overlap": 64,
    "batch_size": 1
  },
  "output": {
    "type": "raster",
    "classes": [
      "background",
      "road"
    ]
  },
  "postprocess": {
    "mask_threshold": -1.0
  },
  "runtime": {
    "gpu": false,
    "cpu_fallback": true,
    "estimated_vram_mb": 0,
    "estimated_ram_mb": 1024,
    "supports_tiling": true
  },
  "reference": "https://github.com/template/dlinknet",
  "description": "D-LinkNet road segmentation for high-resolution aerial imagery (DeepGlobe-style).",
  "tags": [
    "roads",
    "dlinknet",
    "high-resolution"
  ]
}
