{
  "name": "siamese-change-buildings",
  "task": "change_detection",
  "framework": "onnx",
  "path": "",
  "gpu": false,
  "accuracy": 0.86,
  "domain": {
    "sensors": [
      "GF-2",
      "WorldView-3"
    ],
    "resolution_range": [
      0.5,
      2.0
    ],
    "modalities": [
      "optical"
    ]
  },
  "artifact": {
    "path": "",
    "checksum": "",
    "size_bytes": 0,
    "note": "weights are not distributed with the repository; download from the reference, place beside the manifest, fill path + sha256 checksum"
  },
  "preprocess": {
    "normalize": "mean_std",
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ],
    "scale": 1.0
  },
  "tiling": {
    "supported": true,
    "tile_size": 256,
    "overlap": 32,
    "batch_size": 1
  },
  "output": {
    "type": "raster",
    "classes": [
      "no-change",
      "change"
    ]
  },
  "postprocess": {
    "mask_threshold": -1.0
  },
  "runtime": {
    "gpu": false,
    "cpu_fallback": true,
    "estimated_vram_mb": 0,
    "estimated_ram_mb": 1024,
    "supports_tiling": true
  },
  "reference": "https://github.com/template/siamese-change",
  "description": "Siamese U-Net building change detection: two named inputs (before/after, same band roles).",
  "tags": [
    "change",
    "siamese",
    "buildings"
  ],
  "inputs": [
    {
      "name": "before",
      "dtype": "float32",
      "layout": "NCHW",
      "band_roles": [
        "red",
        "green",
        "blue"
      ]
    },
    {
      "name": "after",
      "dtype": "float32",
      "layout": "NCHW",
      "band_roles": [
        "red",
        "green",
        "blue"
      ]
    }
  ]
}
