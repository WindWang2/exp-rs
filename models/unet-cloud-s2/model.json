{
  "name": "unet-cloud-s2",
  "task": "segmentation",
  "framework": "onnx",
  "path": "",
  "gpu": false,
  "accuracy": 0.94,
  "domain": {
    "sensors": [
      "Sentinel-2"
    ],
    "resolution_range": [
      10.0,
      60.0
    ],
    "modalities": [
      "optical"
    ]
  },
  "artifact": {
    "path": "",
    "checksum": "",
    "size_bytes": 0,
    "note": "weights are not distributed with the repository; download from the reference, place beside the manifest, fill path + sha256 checksum"
  },
  "input": {
    "dtype": "float32",
    "layout": "NCHW",
    "band_roles": [
      "blue",
      "green",
      "red",
      "nir"
    ]
  },
  "preprocess": {
    "normalize": "mean_std",
    "mean": [
      0.13,
      0.14,
      0.16,
      0.2
    ],
    "std": [
      0.2,
      0.21,
      0.23,
      0.25
    ],
    "scale": 1.0
  },
  "tiling": {
    "supported": true,
    "tile_size": 256,
    "overlap": 32,
    "batch_size": 4
  },
  "output": {
    "type": "raster",
    "classes": [
      "clear",
      "cloud",
      "shadow"
    ],
    "uncertainty": "entropy"
  },
  "postprocess": {
    "mask_threshold": -1.0
  },
  "runtime": {
    "gpu": false,
    "cpu_fallback": true,
    "estimated_vram_mb": 0,
    "estimated_ram_mb": 1024,
    "supports_tiling": true
  },
  "reference": "https://github.com/template/s2cloudless",
  "description": "Cloud / cloud-shadow segmentation on Sentinel-2 TOA (s2cloudless-style) for QA mask generation; emits an uncertainty band (softmax entropy).",
  "tags": [
    "cloud",
    "qa",
    "sentinel-2"
  ]
}
