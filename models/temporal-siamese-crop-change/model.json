{
  "name": "temporal-siamese-crop-change",
  "task": "change_detection",
  "framework": "onnx",
  "path": "",
  "gpu": false,
  "accuracy": 0.78,
  "domain": {
    "sensors": [
      "Sentinel-2"
    ],
    "resolution_range": [
      10.0,
      20.0
    ],
    "modalities": [
      "optical"
    ]
  },
  "artifact": {
    "path": "",
    "checksum": "",
    "size_bytes": 0,
    "note": "weights are not distributed with the repository; download from the reference, place beside the manifest, fill path + sha256 checksum"
  },
  "preprocess": {
    "normalize": "mean_std",
    "mean": [
      0.1684,
      0.2306
    ],
    "std": [
      0.2144,
      0.2183
    ],
    "scale": 1.0
  },
  "tiling": {
    "supported": false,
    "tile_size": 128,
    "overlap": 0,
    "batch_size": 1
  },
  "output": {
    "type": "raster",
    "classes": [
      "no-change",
      "crop-rotation"
    ]
  },
  "postprocess": {
    "mask_threshold": -1.0
  },
  "runtime": {
    "gpu": false,
    "cpu_fallback": true,
    "estimated_vram_mb": 0,
    "estimated_ram_mb": 1024,
    "supports_tiling": false
  },
  "reference": "https://github.com/template/temporal-siamese",
  "description": "Temporal crop-change detection: named before/after inputs, each T=6 frames collapsed to 12 channels (Siamese temporal encoder).",
  "tags": [
    "change",
    "crop",
    "temporal",
    "siamese"
  ],
  "inputs": [
    {
      "name": "before",
      "dtype": "float32",
      "layout": "NCHW",
      "band_roles": [
        "red",
        "nir"
      ],
      "temporal_length": 6,
      "temporal_collapse": "channels"
    },
    {
      "name": "after",
      "dtype": "float32",
      "layout": "NCHW",
      "band_roles": [
        "red",
        "nir"
      ],
      "temporal_length": 6,
      "temporal_collapse": "channels"
    }
  ]
}
