{
  "name": "sam-buildings-hr",
  "task": "segmentation",
  "framework": "onnx",
  "path": "",
  "gpu": true,
  "accuracy": 0.9,
  "domain": {
    "sensors": [
      "WorldView-3",
      "GF-2",
      "PlanetScope"
    ],
    "resolution_range": [
      0.3,
      1.5
    ],
    "modalities": [
      "optical"
    ]
  },
  "artifact": {
    "path": "",
    "checksum": "",
    "size_bytes": 0,
    "note": "weights are not distributed with the repository; download from the reference, place beside the manifest, fill path + sha256 checksum"
  },
  "input": {
    "dtype": "float32",
    "layout": "NCHW",
    "band_roles": [
      "red",
      "green",
      "blue"
    ]
  },
  "preprocess": {
    "normalize": "mean_std",
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ],
    "scale": 1.0
  },
  "tiling": {
    "supported": true,
    "tile_size": 1024,
    "overlap": 128,
    "batch_size": 1
  },
  "output": {
    "type": "polygon"
  },
  "postprocess": {
    "mask_threshold": -1.0
  },
  "runtime": {
    "gpu": true,
    "cpu_fallback": true,
    "estimated_vram_mb": 4096,
    "estimated_ram_mb": 4096,
    "supports_tiling": true
  },
  "reference": "https://github.com/template/sam-buildings",
  "description": "SAM-family prompt-free building extraction for high-resolution imagery (0.3-1 m); outputs polygons after mask thresholding.",
  "tags": [
    "buildings",
    "sam",
    "high-resolution"
  ]
}
