{
  "name": "swin-landcover-hr",
  "task": "segmentation",
  "framework": "onnx",
  "path": "",
  "gpu": true,
  "accuracy": 0.8,
  "domain": {
    "sensors": [
      "WorldView-3",
      "GF-2"
    ],
    "resolution_range": [
      0.3,
      2.0
    ],
    "modalities": [
      "optical"
    ]
  },
  "artifact": {
    "path": "",
    "checksum": "",
    "size_bytes": 0,
    "note": "weights are not distributed with the repository; download from the reference, place beside the manifest, fill path + sha256 checksum"
  },
  "input": {
    "dtype": "float32",
    "layout": "NCHW",
    "band_roles": [
      "red",
      "green",
      "blue",
      "nir"
    ]
  },
  "preprocess": {
    "normalize": "mean_std",
    "mean": [
      0.485,
      0.456,
      0.406,
      0.552
    ],
    "std": [
      0.229,
      0.224,
      0.225,
      0.231
    ],
    "scale": 1.0
  },
  "tiling": {
    "supported": true,
    "tile_size": 512,
    "overlap": 64,
    "batch_size": 1
  },
  "output": {
    "type": "raster",
    "classes": [
      "background",
      "built-up",
      "vegetation",
      "water",
      "bare"
    ]
  },
  "postprocess": {
    "mask_threshold": -1.0
  },
  "runtime": {
    "gpu": true,
    "cpu_fallback": true,
    "estimated_vram_mb": 6144,
    "estimated_ram_mb": 6144,
    "supports_tiling": true
  },
  "reference": "https://github.com/template/swin-lc",
  "description": "Swin-transformer land-cover segmentation for high-resolution imagery (windowed attention encoder).",
  "tags": [
    "landcover",
    "swin",
    "transformer"
  ]
}
